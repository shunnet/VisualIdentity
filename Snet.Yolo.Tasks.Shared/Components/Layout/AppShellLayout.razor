@inherits LayoutComponentBase
@implements IDisposable
@using Snet.Yolo.Tasks.Services
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject LanguageManager Language
@inject UploadCenter Uploads

<Toasts />
@if (!_ready) { <div class="ls-login-wrap"><div class="spinner-border text-secondary"></div></div> }
else
{
<a class="ls-skip-link" href="#main-content">@Language.Translate("SkipToContent")</a>
<div class="ls-shell">
    <aside id="primary-navigation" class="ls-sidebar @SidebarClass" aria-label="@Language.Translate("PrimaryNavigation")">
        <div class="ls-side-head">
            <img class="ls-brand-mark" src="/favicon.png" width="40" height="40" alt="" aria-hidden="true" />
            <span class="ls-side-title ls-side-text"><strong>Snet.Yolo</strong><small>Tasks @if (_version.Length > 0) { <span class="ls-version" title="@VersionTitle">v@_version</span> }</small></span>
            <button type="button" class="ls-icon-btn ls-side-toggle" @onclick="ToggleNav" aria-expanded="@(!_collapsed)" aria-label="@Language.Translate(_collapsed ? "ExpandNavigation" : "CollapseNavigation")"><i class="bi @(_collapsed ? "bi-chevron-right" : "bi-chevron-left")" aria-hidden="true"></i></button>
        </div>
        <nav class="ls-side-nav">
            @foreach (var item in NavItems)
            {
                var path = Nav.ToBaseRelativePath(Nav.Uri); if (!path.StartsWith("/")) { path = "/" + path; } var active = path == item.Href || path.StartsWith(item.Href) || (item.Href == "/projects" && path.StartsWith("/project/")) || (item.Href == "/anomalib-projects" && (path.StartsWith("/anomalib-project/") || path.StartsWith("/anomalib-train/")));
                <a class="ls-side-item @(active ? "active" : null)" href="@item.Href" @onclick="() => NavTo(item.Href)" title="@Language.Translate(item.TextKey)" aria-current="@(active ? "page" : null)">
                    <i class="bi @item.Icon" aria-hidden="true"></i><span class="ls-side-text">@Language.Translate(item.TextKey)</span>
                </a>
            }
        </nav>
        <div class="ls-side-about-wrap">
            <a class="ls-side-item ls-side-about" href="https://snet.cn" target="_blank" rel="noopener" title="@Language.Translate("About")">
                <i class="bi bi-globe2" aria-hidden="true"></i><span class="ls-side-text">@Language.Translate("About")</span>
            </a>
        </div>
        <div class="ls-side-foot">
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="ls-side-item" title="@Language.Translate("Logout")"><i class="bi bi-box-arrow-left" aria-hidden="true"></i><span class="ls-side-text">@Language.Translate("Logout")</span></button>
            </form>
        </div>
    </aside>
    <div class="ls-shell-main">
        <header class="ls-topbar ls-shell-topbar">
            <button type="button" class="ls-icon-btn ls-mobile-nav-toggle" @onclick="ToggleMobileNav" aria-expanded="@_mobileOpen" aria-controls="primary-navigation" aria-label="@Language.Translate("PrimaryNavigation")"><i class="bi bi-list" aria-hidden="true"></i></button>
            <span class="ls-brand">
                @if (_collapsed)
                {
                    <img class="ls-brand-mark ls-topbar-mark" src="/favicon.png" width="34" height="34" alt="" aria-hidden="true" />
                    <span class="ls-topbar-product"><strong>Snet.Yolo</strong><small>Tasks @if (_version.Length > 0) { <span class="ls-version" title="@VersionTitle">v@_version</span> }</small></span>
                }
            </span>
            <span class="ls-spacer"></span>
            <AppHeaderControls />
            @if (Uploads.ActiveJob is { } activeUpload)
            {
                <span class="ls-upload-chip" role="status" aria-live="polite" title="@activeUpload.Status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span class="ls-upload-chip-text">@(activeUpload.Percent is int uploadPercent ? uploadPercent + "%" : activeUpload.Status)</span>
                </span>
            }
            <span class="ls-user-chip"><span class="ls-user-avatar" aria-hidden="true">@UserInitial</span><span>@_username</span></span>
        </header>
        <main id="main-content" class="ls-content" tabindex="-1">
            @Body
        </main>
    </div>
    @if (_mobileOpen) { <div class="ls-side-backdrop" @onclick="CloseMobileNav"></div> }
</div>
}

@code {
    private bool _collapsed;
    private bool _mobileOpen;
    /// <summary>程序版本号（宿主程序集，如 1.0.1.1）；取不到时为空串，界面上隐藏。</summary>
    private static readonly string _version = Snet.Yolo.Tasks.Core.AppVersion.Current;
    private string VersionTitle => (string.IsNullOrEmpty(_version) ? "Snet.Yolo Tasks" : "Snet.Yolo Tasks v" + _version);
    private string SidebarClass => $"ls-sidebar{(_collapsed ? " collapsed" : null)}{(_mobileOpen ? " mobile-open" : null)}";
    private bool _ready;
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private string _username = string.Empty;
    private string _role = string.Empty;
    private string UserInitial => string.IsNullOrWhiteSpace(_username) ? "U" : _username[0].ToString().ToUpperInvariant();
    private record NavItem(string Href, string Icon, string TextKey);
    private IEnumerable<NavItem> NavItems => new[] {
        new NavItem("/projects", "bi-collection", "Projects"),
        new NavItem("/validation", "bi-cpu", "Validation"),
        new NavItem("/anomalib-projects", "bi-stars", "AnomalibProjects"),
        new NavItem("/anomalib-validation", "bi-bounding-box-circles", "AnomalibValidation"),
    }.Concat(string.Equals(_role, "Admin", StringComparison.OrdinalIgnoreCase) ? new[] { new NavItem("/users", "bi-people", "Users") } : Array.Empty<NavItem>());
    protected override void OnInitialized() => Uploads.Changed += OnUploadsChanged;
    private void OnUploadsChanged() => _ = InvokeAsync(StateHasChanged);

    // SSR 预渲染时 localStorage 不可用，故守卫放在电路连接后的首次渲染执行。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_ready)
        {
            var authenticationState = await AuthenticationStateTask;
            _username = authenticationState.User.Identity?.Name ?? string.Empty;
            _role = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
            _collapsed = (await LocalStorageGet("ls-nav-collapsed")) == "1";
            _ready = true;
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender) { Language.LanguageChanged += OnLangChanged; }
    }

    private async Task ToggleNav() { _collapsed = !_collapsed; await LocalStorageSet("ls-nav-collapsed", _collapsed ? "1" : "0"); }
    private void ToggleMobileNav() { _mobileOpen = !_mobileOpen; }
    private void CloseMobileNav() { _mobileOpen = false; }
    private void NavTo(string href) { CloseMobileNav(); Nav.NavigateTo(href); }
    private void OnLangChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Language.LanguageChanged -= OnLangChanged; Uploads.Changed -= OnUploadsChanged; }

    private async Task<string?> LocalStorageGet(string key) { try { var js = await Js.InvokeAsync<string>("localStorage.getItem", key); return js; } catch { return null; } }
    private async Task LocalStorageSet(string key, string value) { try { await Js.InvokeVoidAsync("localStorage.setItem", key, value); } catch { } }

}
