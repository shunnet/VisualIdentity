<script type="module" src="@Assets["js/reconnect-modal.js"]"></script>

@inject LanguageManager Language
@implements IDisposable

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            @Language.Translate("RejoiningServer")
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            @Language.Translate("ReconnectRetryPrefix") <span id="components-seconds-to-next-attempt"></span> @Language.Translate("SecondsSuffix")
        </p>
        <p class="components-reconnect-failed-visible">
            @Language.Translate("ReconnectFailed")<br />@Language.Translate("RetryOrReload")
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> @Language.Translate("Retry")
        </button>
        <p class="components-pause-visible">
            @Language.Translate("SessionPaused")
        </p>
        <p class="components-resume-failed-visible">
            @Language.Translate("ResumeFailed")<br />@Language.Translate("RetryOrReload")
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            <i class="bi bi-play-fill" aria-hidden="true"></i> @Language.Translate("Resume")
        </button>
    </div>
</dialog>

@code {
    protected override void OnInitialized() => Language.LanguageChanged += OnLanguageChanged;
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;
}
