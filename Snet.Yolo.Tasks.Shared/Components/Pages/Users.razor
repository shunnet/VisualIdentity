@page "/users"
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@using Snet.Yolo.Tasks.Services
@using Snet.Yolo.Server.models.data
@inject UserService UserSvc
@inject LanguageManager Language
@inject ToastService Toast

<AppPageTitle ResourceKey="Users" />

<div class="ls-refined-page ls-users-page">
<div class="ls-page-head">
    <h1 class="ls-page-title ls-page-title-with-icon"><i class="bi bi-people" aria-hidden="true"></i><LangText Key="Users" /></h1>
    <div class="ls-page-actions"><button class="btn btn-sm btn-primary" @onclick="() => _showAdd = true"><i class="bi bi-person-plus"></i> <LangText Key="AddUser" /></button></div>
</div>

@if (_users.Count == 0)
{
    <div class="ls-card p-0">
        <EmptyState Icon="bi-people" Class="py-5">
            <Body><LangText Key="NoUsers" /></Body>
            <Actions><button class="btn btn-primary btn-sm" @onclick="() => _showAdd = true"><i class="bi bi-person-plus"></i> <LangText Key="AddUser" /></button></Actions>
        </EmptyState>
    </div>
}
else
{
    <div class="table-responsive ls-card p-0">
        <div class="ls-toolbar">
            <span class="ls-toolbar-count">@VisibleUsers.Count / @_users.Count</span>
            <div class="ls-search">
                <i class="bi bi-search"></i>
                <input class="form-control form-control-sm" placeholder="@Language.Translate("SearchUsers")" value="@_search" @oninput="e => _search = e.Value?.ToString() ?? String.Empty" @onchange="SyncSearchAsync" />
                @if (!string.IsNullOrWhiteSpace(_search)) { <button type="button" class="ls-search-clear" @onclick="() => { _search = String.Empty; _ = SyncSearchAsync(); }"><i class="bi bi-x-lg"></i></button> }
            </div>
        </div>
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="text-center"><span class="ls-th-label justify-content-center"><i class="bi bi-hash" aria-hidden="true"></i><span>#</span></span></th>
                    <th><span class="ls-th-label"><i class="bi bi-person" aria-hidden="true"></i><LangText Key="Username" /></span></th>
                    <th><span class="ls-th-label"><i class="bi bi-shield-check" aria-hidden="true"></i><LangText Key="Role" /></span></th>
                    <th><span class="ls-th-label"><i class="bi bi-check2-circle" aria-hidden="true"></i><LangText Key="Status" /></span></th>
                    <th><span class="ls-th-label"><i class="bi bi-clock-history" aria-hidden="true"></i><LangText Key="CreatedAt" /></span></th>
                    <th class="text-end"><span class="ls-th-label justify-content-end"><i class="bi bi-sliders" aria-hidden="true"></i><LangText Key="Actions" /></span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in VisibleUsers)
                {
                    var isAdmin = u.role == "Admin";
                    var enabled = u.active == 1;
                    <tr>
                        <td class="text-secondary num">@u.index</td>
                        <td>
                            <div class="ls-user-cell">
                                <span class="ls-avatar">@Initial(u.username)</span>
                                <span class="fw-semibold">@u.username</span>
                            </div>
                        </td>
                        <td><span class="ls-role @(isAdmin ? "ls-role-admin" : "ls-role-user")"><i class="bi @(isAdmin ? "bi-shield-lock" : "bi-person")"></i>@Language.Translate(isAdmin ? "Administrator" : "StandardUser")</span></td>
                        <td><span class="ls-state @(enabled ? "ls-state-ok" : "ls-state-todo")"><i class="bi @(enabled ? "bi-check2" : "bi-dash")"></i>@Language.Translate(enabled ? "Enabled" : "Disabled")</span></td>
                        <td class="small">@u.createTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <div class="ls-btn-row justify-content-end">
                                <button class="btn btn-icon-sm btn-outline-secondary" title="@Language.Translate("EditUser")" aria-label="@($"{Language.Translate("EditUser")}: {u.username}")" @onclick="() => OpenEdit(u)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                <button class="btn btn-icon-sm btn-outline-secondary" title="@Language.Translate("Status")" aria-label="@($"{Language.Translate("Status")}: {u.username}")" @onclick="() => Toggle(u.index, u.active)"><i class="bi @(enabled ? "bi-toggle-on" : "bi-toggle-off")" aria-hidden="true"></i></button>
                                <button class="btn btn-icon-sm btn-outline-danger" title="@Language.Translate("Delete")" aria-label="@($"{Language.Translate("Delete")}: {u.username}")" @onclick="() => Del(u.index)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_editing is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="edit-user-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="edit-user-title" class="modal-title"><i class="bi bi-person-gear" aria-hidden="true"></i>@Language.Translate("EditUser")</h5>
                    <button class="btn-close" @onclick="CloseEdit" aria-label="@Language.Translate("Close")"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="ls-field-label">@Language.Translate("Username")</label>
                        <div class="ls-user-edit-identity"><span class="ls-avatar">@Initial(_editing.username)</span><strong>@_editing.username</strong></div>
                    </div>
                    <div class="mb-3">
                        <label class="ls-field-label">@Language.Translate("NewPassword")</label>
                        <div class="ls-input-icon ls-password-input">
                            <i class="bi bi-key" aria-hidden="true"></i>
                            <input class="form-control" type="password" autocomplete="new-password" @bind="_editPassword" placeholder="@Language.Translate("PasswordLeaveBlank")" />
                        </div>
                        <div class="form-text">@Language.Translate("PasswordLeaveBlank")</div>
                    </div>
                    <div class="mb-3">
                        <label class="ls-field-label">@Language.Translate("Role")</label>
                        <div class="ls-type-grid ls-type-grid-2" role="radiogroup" aria-label="@Language.Translate("Role")">
                            @foreach (var r in RoleOptions)
                            {
                                var isSel = _editRole == r.Value;
                                <button type="button" class="ls-type-card @(isSel ? "active" : null)" @onclick="() => _editRole = r.Value" role="radio" aria-checked="@isSel">
                                    @if (isSel) { <i class="bi bi-check-lg ls-type-check"></i> }
                                    <i class="bi @r.Icon"></i><span>@Language.Translate(r.Value == "Admin" ? "Administrator" : "StandardUser")</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="ls-field-label">@Language.Translate("Status")</label>
                        <button type="button" class="ls-user-status-choice @(_editActive ? "active" : null)" role="switch" aria-checked="@_editActive" @onclick="() => _editActive = !_editActive">
                            <span><i class="bi @(_editActive ? "bi-check-circle" : "bi-pause-circle")" aria-hidden="true"></i>@Language.Translate(_editActive ? "Enabled" : "Disabled")</span>
                            <i class="bi @(_editActive ? "bi-toggle-on" : "bi-toggle-off")" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseEdit" disabled="@_savingUser"><i class="bi bi-x-lg"></i>@Language.Translate("Cancel")</button>
                    <button class="btn btn-primary" @onclick="SaveEditAsync" disabled="@_savingUser">
                        @if (_savingUser) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> } else { <i class="bi bi-check-lg"></i> }
                        @Language.Translate("SaveChanges")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@if (_showAdd)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-person-plus" aria-hidden="true"></i><LangText Key="AddUser" /></h5><button class="btn-close" @onclick="() => _showAdd = false" aria-label="@Language.Translate("Close")"></button></div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="ls-field-label"><LangText Key="Username" /></label>
                        <input class="form-control" autofocus @bind="_name" />
                    </div>
                    <div class="mb-3">
                        <label class="ls-field-label"><LangText Key="Password" /></label>
                        <input class="form-control" type="password" @bind="_pass" />
                    </div>
                    <div class="mb-3">
                        <label class="ls-field-label"><LangText Key="Role" /></label>
                        <div class="ls-type-grid ls-type-grid-2" role="radiogroup" aria-label="@Language.Translate("Role")">
                            @foreach (var r in RoleOptions)
                            {
                                var isSel = _role == r.Value;
                                <button type="button" class="ls-type-card @(isSel ? "active" : null)" @onclick="() => _role = r.Value" role="radio" aria-checked="@isSel">
                                    @if (isSel) { <i class="bi bi-check-lg ls-type-check"></i> }
                                    <i class="bi @r.Icon"></i><span>@Language.Translate(r.Value == "Admin" ? "Administrator" : "StandardUser")</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="() => _showAdd = false"><i class="bi bi-x-lg"></i> @Language.Translate("Cancel")</button><button class="btn btn-primary" @onclick="AddUser"><i class="bi bi-check-lg"></i> @Language.Translate("Create")</button></div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

</div>

<ConfirmDialog IsOpen="@(_confirmUserIndex is not null)"
               Title="@Language.Translate("Delete")"
               Message="@_confirmUserMessage"
               Confirmed="ConfirmDeleteUserAsync"
               Cancelled="CancelDeleteUser" />

@code {
    private List<UserData> _users = new();
    private bool _showAdd;
    private string _name="", _pass="", _role="User";
    private string _search = String.Empty;

  /// <summary>搜索词（来自 URL 查询参数 ?q=）：刷新后仍然保持筛选结果。</summary>
  [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "q")]
  public string? SearchQuery { get; set; }

  /// <summary>把搜索词写回地址栏（replace，不产生历史记录）。</summary>
  private Task SyncSearchAsync()
  {
    var url = Snet.Yolo.Tasks.Services.ListStateUrl.Build(Navigation.BaseUri, "users", ("q", _search));
    if (!string.Equals(Navigation.Uri, url, StringComparison.Ordinal)) { Navigation.NavigateTo(url, replace: true); }
    return Task.CompletedTask;
  }
    private UserData? _editing;
    private string _editPassword = String.Empty;
    private string _editRole = "User";
    private bool _editActive;
    private bool _savingUser;
    private int? _confirmUserIndex;
    private string _confirmUserMessage = string.Empty;

    private List<UserData> VisibleUsers => string.IsNullOrWhiteSpace(_search)
        ? _users
        : _users.Where(u => (u.username ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();
    private static readonly (string Value, string Icon)[] RoleOptions = new[]
    {
        ("Admin", "bi-shield-lock"),
        ("User", "bi-person"),
    };

    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;
        _search = SearchQuery ?? string.Empty;   // 刷新后恢复搜索词
        await Load();
    }

    /// <summary>URL 里的搜索词变化（前进/后退/直接带 ?q= 访问）时同步到界面。</summary>
    protected override void OnParametersSet()
    {
        var fromUrl = SearchQuery ?? string.Empty;
        if (!string.Equals(fromUrl, _search, StringComparison.Ordinal)) { _search = fromUrl; }
    }
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;
    private async Task Load() { _users = (await UserSvc.ListAsync()).ToList(); }
    private async Task AddUser() { if(string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_pass)) return; var result = await UserSvc.AddAsync(_name.Trim(), _pass, _role); if (!result.Status) { Toast.ShowError(result.Message ?? Language.Translate("OperationFailed")); return; } _showAdd=false; _name=""; _pass=""; Toast.ShowSuccess(Language.Translate("UserCreated")); await Load(); }
    private void OpenEdit(UserData user) { _editing = user; _editPassword = String.Empty; _editRole = user.role is "Admin" ? "Admin" : "User"; _editActive = user.active == 1; }
    private void CloseEdit() { if (!_savingUser) { _editing = null; _editPassword = String.Empty; } }
    private async Task SaveEditAsync()
    {
        if (_editing is null || _savingUser) { return; }
        _savingUser = true;
        try
        {
            var result = await UserSvc.UpdateAsync(_editing.index, string.IsNullOrWhiteSpace(_editPassword) ? null : _editPassword, _editRole, _editActive);
            if (!result.Status) { Toast.ShowError(result.Message ?? Language.Translate("OperationFailed")); return; }
            _editing = null;
            _editPassword = String.Empty;
            Toast.ShowSuccess(Language.Translate("UserUpdated"));
            await Load();
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { _savingUser = false; }
    }
    private async Task Toggle(int index, int active) { await UserSvc.UpdateAsync(index, null, null, active==1 ? false : true); await Load(); }
    private async Task Del(int index)
    {
        var userName = _users.FirstOrDefault(user => user.index == index)?.username ?? Language.Translate("Users");
        _confirmUserIndex = index;
        _confirmUserMessage = Language.Translate("ConfirmDelete") + "\n" + userName;
    }
    private void CancelDeleteUser() { _confirmUserIndex = null; _confirmUserMessage = string.Empty; }
    private async Task ConfirmDeleteUserAsync()
    {
        var index = _confirmUserIndex;
        CancelDeleteUser();
        if (index is null) { return; }
        await UserSvc.DeleteAsync(index.Value); await Load();
    }
}
