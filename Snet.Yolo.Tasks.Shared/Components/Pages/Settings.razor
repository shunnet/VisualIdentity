@page "/settings"
@attribute [Authorize]
@implements IAsyncDisposable
@using Snet.Yolo.Tasks.Services
@using Snet.Yolo.Server.inference
@inject AppearanceSettingsStore Store
@inject ThemeManager Theme
@inject LanguageManager Language
@inject ToastService Toast
@inject IJSRuntime Js
@inject OnnxRuntimeSettingsStore RuntimeStore
@inject OnnxRuntimeSettingsService RuntimeSettings
@inject SystemMetrics Metrics
@inject EnvironmentDiagnosticsService Diagnostics
@inject SamEnvironmentResetService SamReset
@inject TrainingService YoloTraining
@inject AnomalibWorkflowService AnomalibTraining

<AppPageTitle ResourceKey="Settings" />
<div class="ls-page-head">
    <h1 class="ls-page-title ls-page-title-with-icon"><i class="bi bi-gear" aria-hidden="true"></i>@T("Settings")</h1>
    <div class="ls-page-actions">
        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@(_saving || _uploading || _shell is null)"><i class="bi bi-check2" aria-hidden="true"></i>@T("SettingsSave")</button>
    </div>
</div>
<div class="ls-refined-page ls-settings-page">
    <div class="ls-settings-grid">
        <section class="ls-card ls-workspace-card">
            <div class="ls-card-head"><h2 class="ls-h3"><i class="bi bi-image me-2" aria-hidden="true"></i>@T("SettingsBrand")</h2></div>
            <div class="ls-workspace-card-body">
                <div class="ls-settings-brand-preview"><img src="@(_logo ?? "/favicon.png")" alt="" /><div><strong>@_title</strong><small>@_description</small></div></div>
                <label class="ls-field-label" for="brand-title"><i class="bi bi-type me-2" aria-hidden="true"></i>@T("SettingsBrandTitle")</label>
                <input id="brand-title" class="form-control" maxlength="80" @bind="_title" @bind:event="oninput" disabled="@(!_admin || _saving)" />
                <label class="ls-field-label" for="brand-description"><i class="bi bi-card-text me-2" aria-hidden="true"></i>@T("SettingsBrandDescription")</label>
                <textarea id="brand-description" class="form-control" rows="2" maxlength="200" @bind="_description" @bind:event="oninput" disabled="@(!_admin || _saving)"></textarea>
                <label class="ls-field-label" for="brand-image"><i class="bi bi-image me-2" aria-hidden="true"></i>@T("SettingsBrandImage")</label>
                <InputFile id="brand-image" class="form-control" accept="image/png,image/jpeg,image/webp" OnChange="UploadLogoAsync" disabled="@(!_admin || _saving || _uploading)" />
                @if (_uploading)
                {
                    <div class="ls-upload-status" role="status" aria-live="polite">
                        <div class="ls-upload-status-head"><span>@T("UploadImage") @UploadCenter.FormatBytes(_logoUploadedBytes) / @UploadCenter.FormatBytes(_logoTotalBytes)</span><strong>@LogoUploadPercent%</strong></div>
                        <div class="progress ls-progress ls-upload-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@LogoUploadPercent" aria-label="@T("UploadImage")"><div class="progress-bar" style="width:@LogoUploadPercent%"></div></div>
                        <div class="ls-upload-actions"><span>0 / 1</span><button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelLogoUpload"><i class="bi bi-stop-circle" aria-hidden="true"></i>@T("Cancel")</button></div>
                    </div>
                }
                <p class="ls-hint mt-2">@T("SettingsLogoHint")</p>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _logo = null" disabled="@(!_admin || _saving || _uploading)"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>@T("SettingsRestoreLogo")</button>
                <p class="ls-hint mt-3 mb-0">@T(_admin ? "SettingsBrandHint" : "SettingsAdminOnly")</p>
            </div>
        </section>
        <section class="ls-card ls-workspace-card">
            <div class="ls-card-head"><h2 class="ls-h3"><i class="bi bi-sun me-2" aria-hidden="true"></i>@T("SettingsAppearance")</h2></div>
            <div class="ls-workspace-card-body">
                <div class="ls-field-label"><i class="bi bi-palette me-2" aria-hidden="true"></i>@T("ThemeLabel")</div>
                <div class="ls-settings-themes" role="radiogroup" aria-label="@T("ThemeLabel")">
                    @foreach (var theme in new[] { "light", "dark" })
                    {
                        <button type="button" class="ls-settings-theme @(Theme.Current == theme ? "active" : null)" role="radio" aria-checked="@((Theme.Current == theme) ? "true" : "false")" @onclick="() => SelectThemeAsync(theme)" disabled="@(_shell is null || _saving)">
                            <span class="ls-settings-theme-preview @theme" aria-hidden="true"><span class="ls-settings-mini-side"></span><span class="ls-settings-mini-main"><span></span><span></span><span></span><span></span></span></span>
                            <span class="ls-settings-theme-label"><i class="bi @(theme == "dark" ? "bi-moon-stars" : "bi-sun")" aria-hidden="true"></i>@T(theme == "dark" ? "SettingsDark" : "SettingsLight") @if (Theme.Current == theme) { <i class="bi bi-check2 ms-auto" aria-hidden="true"></i> }</span>
                        </button>
                    }
                </div>
                <label class="ls-field-label" for="settings-language"><i class="bi bi-translate me-2" aria-hidden="true"></i>@T("Language")</label>
                <select id="settings-language" class="form-select" value="@Language.CurrentLanguageCode" @onchange="SelectLanguageAsync" disabled="@(_shell is null || _saving)">
                    @foreach (var option in LanguageManager.SupportedLanguages) { <option value="@option.Code">@option.DisplayName</option> }
                </select>
                <p class="ls-hint mt-3 mb-0">@T(_admin ? "SettingsDefaultsHint" : "SettingsPreferencesHint")</p>
            </div>
        </section>
        <section class="ls-card ls-workspace-card ls-settings-runtime">
            <div class="ls-card-head">
                <h2 class="ls-h3"><i class="bi bi-cpu me-2" aria-hidden="true"></i>@T("SettingsRuntimeHardware")</h2>
                <span class="ls-chip">@(RuntimeStore.Current.Hardware == OnnxRuntimeHardware.Cpu ? "CPU" : $"GPU {RuntimeStore.Current.GpuId}")</span>
            </div>
            <div class="ls-workspace-card-body ls-runtime-body">
                <div class="ls-runtime-toolbar">
                    <div class="ls-runtime-choices" role="radiogroup" aria-label="@T("SettingsRuntimeHardware")">
                        <button type="button" class="btn btn-sm btn-outline-secondary ls-runtime-option" role="radio" aria-checked="@(_runtimeHardware == OnnxRuntimeHardware.Cpu ? "true" : "false")" title="@T("SettingsRuntimeCpu")" @onclick="() => SelectRuntimeHardware(OnnxRuntimeHardware.Cpu)" disabled="@(!_admin || _saving)"><i class="bi bi-cpu" aria-hidden="true"></i>CPU</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary ls-runtime-option" role="radio" aria-checked="@(_runtimeHardware == OnnxRuntimeHardware.Cuda ? "true" : "false")" @onclick="() => SelectRuntimeHardware(OnnxRuntimeHardware.Cuda)" disabled="@(!_admin || _saving || !_supportsCuda || _runtimeGpus.Count == 0)"><i class="bi bi-gpu-card" aria-hidden="true"></i>NVIDIA GPU</button>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary ls-runtime-apply" @onclick="SaveRuntimeAsync" disabled="@(!_admin || _saving || _detectingRuntimeGpus || _runtimeHardware == OnnxRuntimeHardware.Cuda && (!_supportsCuda || !_runtimeGpus.Any(gpu => gpu.Index == _runtimeGpuId)))"><i class="bi @(_saving ? "bi-hourglass-split" : "bi-check2")" aria-hidden="true"></i>@T("SettingsRuntimeApply")</button>
                </div>
                @if (_runtimeHardware == OnnxRuntimeHardware.Cuda)
                {
                    <div class="ls-gpu-selection ls-runtime-gpus" role="radiogroup" aria-label="@T("SettingsRuntimeGpu")">
                        <div class="ls-gpu-selection-head"><strong>@T("SettingsRuntimeGpu")</strong><button type="button" title="@T("SettingsRuntimeRefreshGpu")" @onclick="RefreshRuntimeGpusAsync" disabled="@(_saving || _detectingRuntimeGpus)"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> @T("SettingsRuntimeRefreshGpu")</button></div>
                        @foreach (var gpu in _runtimeGpus)
                        {
                            <button type="button" class="ls-gpu-device @(_runtimeGpuId == gpu.Index ? "active" : null)" role="radio" aria-checked="@(_runtimeGpuId == gpu.Index ? "true" : "false")" @onclick="() => _runtimeGpuId = gpu.Index" disabled="@(!_admin || _saving)"><i class="bi @(_runtimeGpuId == gpu.Index ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i><span title="@gpu.Name">GPU @gpu.Index · @gpu.Name<small>@((gpu.VramTotalMb / 1024).ToString("0.#")) GB · CUDA</small></span></button>
                        }
                    </div>
                }
                @if (_detectingRuntimeGpus) { <p class="ls-hint" role="status" data-runtime-gpu-detecting><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>@T("SettingsRuntimeDetecting")</p> }
                else if (!_supportsCuda) { <p class="ls-hint">@T("SettingsRuntimeCpuOnly")</p> }
                else if (_runtimeGpus.Count == 0) { <p class="ls-hint">@T("SettingsRuntimeNoGpu") <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshRuntimeGpusAsync" disabled="@(_saving || _detectingRuntimeGpus)">@T("SettingsRuntimeRefreshGpu")</button></p> }
                <div class="ls-runtime-notes">
                    <p class="ls-hint">@T("SettingsRuntimeScope")</p>
                    <p class="ls-hint">@T("SettingsRuntimeApplyHint")</p>
                </div>
                @if (!string.IsNullOrEmpty(_runtimeProgress)) { <div class="ls-upload-log ls-runtime-status" role="status">@_runtimeProgress</div> }
                @if (!_admin) { <p class="ls-hint">@T("SettingsAdminOnly")</p> }
            </div>
        </section>
        <section class="ls-card ls-workspace-card ls-settings-environments" style="grid-column: 1 / -1">
            <div class="ls-card-head">
                <h2 class="ls-h3"><i class="bi bi-heart-pulse me-2" aria-hidden="true"></i>@T("SettingsEnvironments")</h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CheckAllEnvironmentsAsync" disabled="@(_checking.Count > 0)"><i class="bi bi-activity" aria-hidden="true"></i> @T("EnvCheckAll")</button>
            </div>
            <div class="ls-workspace-card-body">
                <p class="ls-hint">@T("SettingsEnvironmentsHint")</p>
                @foreach (var component in Components)
                {
                    var report = _reports.GetValueOrDefault(component);
                    var reset = ResetStatus(component);
                    <div class="ls-env-row">
                        <div class="ls-env-title">
                            <i class="bi @EnvironmentIcon(component)" aria-hidden="true"></i><strong>@T("Env" + component)</strong>
                            <span class="ls-chip @EnvironmentChipClass(component)">@EnvironmentStateText(component)</span>
                        </div>
                        <div class="ls-hint">@T("Env" + component + "Desc")</div>
                        @if (report is not null)
                        {
                            <ul class="ls-env-items">
                                @foreach (var item in report.Items)
                                {
                                    <li class="@(item.Ok ? "text-success" : item.Required ? "text-danger" : "text-secondary")"><i class="bi @(item.Ok ? "bi-check-circle" : item.Required ? "bi-x-circle" : "bi-dash-circle")" aria-hidden="true"></i> <span>@T("EnvCheck" + item.Key)</span> <small>@item.Detail</small></li>
                                }
                            </ul>
                        }
                        <div class="ls-env-actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CheckEnvironmentAsync(component)" disabled="@(_checking.Contains(component) || reset?.IsActive == true)"><i class="bi bi-activity" aria-hidden="true"></i> @T("EnvCheck")</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RequestReset(component)" disabled="@(!_admin || _checking.Contains(component) || reset?.IsActive == true)"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> @T("EnvReset")</button>
                            @if (reset is not null)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _logComponent = component"><i class="bi bi-terminal" aria-hidden="true"></i> @T("EnvResetLog")</button>
                            }
                        </div>
                    </div>
                }
                @if (!_admin) { <p class="ls-hint mb-0">@T("EnvResetAdminOnly")</p> }
            </div>
        </section>
    </div>
</div>

<ConfirmDialog IsOpen="@(_confirmComponent is not null)" Title="@T("EnvReset")"
               Message="@(_confirmComponent is null ? string.Empty : string.Format(T("EnvResetConfirm"), T("Env" + _confirmComponent)))"
               ConfirmTextKey="EnvReset" ConfirmIcon="bi-arrow-clockwise"
               Confirmed="ConfirmResetAsync" Cancelled="() => _confirmComponent = null" />

@if (_logComponent is { } logComponent && ResetStatus(logComponent) is { } logStatus)
{
    <div class="modal show d-block ls-confirm-modal" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg"><div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-terminal" aria-hidden="true"></i> @T("Env" + logComponent) · @T("EnvResetLog")</h5>
                <button type="button" class="btn-close" aria-label="@T("Close")" @onclick="() => _logComponent = null"></button>
            </div>
            <div class="modal-body">
                <div role="status" class="alert @(logStatus.IsActive ? "alert-info" : logStatus.Succeeded ? "alert-success" : "alert-danger")">
                    @T(logStatus.IsActive ? "ResettingTrainingEnvironment" : logStatus.Succeeded ? "TrainingEnvironmentResetSucceeded" : "TrainingEnvironmentResetFailed")
                </div>
                <div class="ls-terminal" style="height:45vh; overflow:auto" aria-live="off">
                    @foreach (var line in logStatus.Logs) { <div class="ls-term-line">@line</div> }
                </div>
                @if (logStatus.IsActive) { <p class="ls-hint mb-0">@T("TrainingEnvironmentResetBackgroundHint")</p> }
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-primary" @onclick="() => _logComponent = null">@T("Close")</button></div>
        </div></div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private string _title = "";
    private string _description = "";
    private string? _logo;
    private bool _admin, _saving, _uploading;
    /// <summary>仅控制当前品牌图片上传，取消后不改变已有预览。</summary>
    private CancellationTokenSource? _logoUploadCancellation;
    /// <summary>品牌图片已传输与总字节数。</summary>
    private long _logoUploadedBytes, _logoTotalBytes;
    /// <summary>内容校验完成前最多显示 99%。</summary>
    private int LogoUploadPercent => _logoTotalBytes <= 0 ? 0 : (int)Math.Min(99, _logoUploadedBytes * 100d / _logoTotalBytes);
    private IJSObjectReference? _shell;
    private readonly CancellationTokenSource _runtimeCancellation = new();
    private OnnxRuntimeHardware _runtimeHardware;
    private int _runtimeGpuId;
    private bool _supportsCuda, _detectingRuntimeGpus;
    private string _runtimeProgress = "";
    private IReadOnlyList<GpuMetrics> _runtimeGpus = [];
    /// <summary>按当前界面语言读取文本。</summary>
    private string T(string key) => Language.Translate(key);

    /// <summary>环境管理卡片依次展示的组件。</summary>
    private static readonly EnvironmentComponent[] Components = [EnvironmentComponent.Sam, EnvironmentComponent.Yolo, EnvironmentComponent.Anomalib];
    /// <summary>各组件最近一次自检报告。</summary>
    private readonly Dictionary<EnvironmentComponent, EnvironmentReport> _reports = [];
    /// <summary>正在自检的组件。</summary>
    private readonly HashSet<EnvironmentComponent> _checking = [];
    /// <summary>等待管理员确认重置的组件。</summary>
    private EnvironmentComponent? _confirmComponent;
    /// <summary>正在查看重置日志的组件。</summary>
    private EnvironmentComponent? _logComponent;
    /// <summary>当前登录用户名，用于隔离重置状态。</summary>
    private string _owner = string.Empty;
    /// <summary>上一轮轮询时仍在重置的组件，用于重置结束后自动重新自检。</summary>
    private readonly HashSet<EnvironmentComponent> _wasResetting = [];
    /// <summary>重置状态轮询任务。</summary>
    private Task? _environmentPoll;

    /// <summary>读取组件对应的重置状态；没有重置过时为空。</summary>
    private TrainingEnvironmentResetStatus? ResetStatus(EnvironmentComponent component) => component switch
    {
        EnvironmentComponent.Sam => _admin ? SamReset.GetStatus() : null,
        EnvironmentComponent.Yolo => YoloTraining.GetEnvironmentResetStatus(_owner, TrainingEnvironmentResetOperation.SettingsScope),
        _ => AnomalibTraining.GetEnvironmentResetStatus(_owner, TrainingEnvironmentResetOperation.SettingsScope),
    };

    /// <summary>组件图标。</summary>
    private static string EnvironmentIcon(EnvironmentComponent component) => component switch
    {
        EnvironmentComponent.Sam => "bi-magic",
        EnvironmentComponent.Yolo => "bi-cpu",
        _ => "bi-bullseye",
    };

    /// <summary>组件当前状态的徽标样式。</summary>
    private string EnvironmentChipClass(EnvironmentComponent component)
        => _checking.Contains(component) || ResetStatus(component)?.IsActive == true ? "ls-chip-accent"
            : _reports.TryGetValue(component, out var report) ? (report.NeedsRepair ? "text-danger" : "text-success") : string.Empty;

    /// <summary>组件当前状态的文字。</summary>
    private string EnvironmentStateText(EnvironmentComponent component)
        => ResetStatus(component)?.IsActive == true ? T("EnvResetting")
            : _checking.Contains(component) ? T("EnvChecking")
            : _reports.TryGetValue(component, out var report) ? T(report.NeedsRepair ? "EnvNeedsRepair" : "EnvReady") : T("EnvUnchecked");

    /// <summary>检查一个组件；同一组件不会并发检查。</summary>
    private async Task CheckEnvironmentAsync(EnvironmentComponent component)
    {
        if (!_checking.Add(component)) { return; }
        try { _reports[component] = await Diagnostics.CheckAsync(component, _runtimeCancellation.Token); }
        catch (OperationCanceledException) when (_runtimeCancellation.IsCancellationRequested) { }
        catch (Exception error) { Toast.ShowError(error.Message); }
        finally { _checking.Remove(component); await InvokeAsync(StateHasChanged); }
    }

    /// <summary>依次检查全部组件，避免同时导入多个 PyTorch 造成内存峰值。</summary>
    private async Task CheckAllEnvironmentsAsync()
    {
        foreach (var component in Components) { await CheckEnvironmentAsync(component); }
    }

    /// <summary>请求重置：先确认没有训练或其他重置占用共享环境。</summary>
    private void RequestReset(EnvironmentComponent component)
    {
        if (!_admin) { Toast.ShowWarning(T("EnvResetAdminOnly")); return; }
        if (EnvironmentBusy(component)) { Toast.ShowWarning(T("TrainingEnvironmentBusy")); return; }
        _confirmComponent = component;
    }

    /// <summary>训练或重置是否正占用该组件的共享环境。</summary>
    private bool EnvironmentBusy(EnvironmentComponent component) => component switch
    {
        EnvironmentComponent.Sam => SamReset.IsActive,
        EnvironmentComponent.Yolo => YoloTraining.IsEnvironmentBusy,
        _ => AnomalibTraining.IsEnvironmentBusy,
    };

    /// <summary>确认后启动后台重置并打开日志；服务端会再次检查占用情况。</summary>
    private async Task ConfirmResetAsync()
    {
        var component = _confirmComponent;
        _confirmComponent = null;
        if (component is null || !_admin) { return; }
        try
        {
            var gpus = _runtimeGpus.Select(gpu => gpu.Index).ToArray();
            var started = component switch
            {
                EnvironmentComponent.Sam => SamReset.Start(),
                EnvironmentComponent.Yolo => await YoloTraining.StartEnvironmentResetAsync(_owner, TrainingEnvironmentResetOperation.SettingsScope, Snet.Yolo.Tasks.Core.Training.DeviceDefaults.Yolo(RuntimeStore.Current, gpus)),
                _ => await AnomalibTraining.StartEnvironmentResetAsync(_owner, TrainingEnvironmentResetOperation.SettingsScope, Snet.Yolo.Tasks.Core.Training.DeviceDefaults.Anomalib(RuntimeStore.Current, gpus)),
            };
            if (!started) { Toast.ShowWarning(T("TrainingEnvironmentBusy")); return; }
            _logComponent = component;
            _environmentPoll ??= PollEnvironmentAsync(_runtimeCancellation.Token);
        }
        catch (Exception error) when (error is InvalidOperationException or OperationCanceledException) { Toast.ShowError(error.Message); }
    }

    /// <summary>重置期间每秒刷新日志；重置结束后自动重新自检该组件，让状态立刻反映新环境；全部结束后停止轮询，不再空转刷新页面。</summary>
    private async Task PollEnvironmentAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var anyActive = false;
                foreach (var component in Components)
                {
                    var active = ResetStatus(component)?.IsActive == true;
                    anyActive |= active;
                    if (active) { _wasResetting.Add(component); }
                    else if (_wasResetting.Remove(component)) { _ = CheckEnvironmentAsync(component); }
                }
                await InvokeAsync(StateHasChanged);
                if (!anyActive && _wasResetting.Count == 0) { break; }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        finally { _environmentPoll = null; }
    }

    /// <summary>加载外观与全站验证设备；SAM 和训练设备不在此处修改。</summary>
    protected override async Task OnInitializedAsync()
    {
        var settings = Store.Current;
        _title = settings.Title; _description = settings.Description; _logo = settings.LogoDataUrl;
        var authentication = await AuthenticationStateTask;
        _admin = authentication.User.IsInRole("Admin");
        _owner = authentication.User.Identity?.Name ?? string.Empty;
        Language.LanguageChanged += Refresh;
        Theme.Changed += Refresh;
        _runtimeHardware = RuntimeStore.Current.Hardware;
        _runtimeGpuId = RuntimeStore.Current.GpuId;
        _supportsCuda = Snet.Yolo.Server.inference.OnnxSessionOptions.SupportsCuda;
        await RefreshRuntimeGpusAsync();
        _environmentPoll = Components.Any(component => ResetStatus(component)?.IsActive == true) ? PollEnvironmentAsync(_runtimeCancellation.Token) : null;
    }

    /// <summary>首屏连接后加载本浏览器的外观偏好。</summary>
    /// <param name="firstRender">是否首次渲染。</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { return; }
        _shell = await Js.InvokeAsync<IJSObjectReference>("import", WebAssetVersion.Versioned("./js/app-shell.js"));
        Theme.SetTheme(await _shell.InvokeAsync<string>("getTheme"));
        StateHasChanged();
    }

    /// <summary>限制上传流后验证实际图片内容；失败时保留原有预览。</summary>
    private async Task UploadLogoAsync(InputFileChangeEventArgs args)
    {
        if (!_admin || _saving || _uploading) { return; }
        _uploading = true;
        _logoUploadedBytes = 0;
        _logoTotalBytes = args.File.Size;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_runtimeCancellation.Token);
        _logoUploadCancellation = cancellation;
        try
        {
            await using var stream = args.File.OpenReadStream(AppearanceSettingsStore.MaximumLogoBytes, cancellation.Token);
            using var buffer = new MemoryStream();
            var chunk = new byte[64 * 1024];
            int read;
            while ((read = await stream.ReadAsync(chunk, cancellation.Token)) != 0)
            {
                await buffer.WriteAsync(chunk.AsMemory(0, read), cancellation.Token);
                _logoUploadedBytes += read;
                await InvokeAsync(StateHasChanged);
            }
            cancellation.Token.ThrowIfCancellationRequested();
            _logo = AppearanceSettingsStore.CreateLogoDataUrl(buffer.ToArray());
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception error) when (error is IOException or InvalidDataException or ArgumentException)
        { Toast.ShowError(T("SettingsInvalidLogo")); }
        finally { _logoUploadCancellation = null; _uploading = false; }
    }

    /// <summary>取消品牌图片传输，当前已保存的品牌设置及预览继续保留。</summary>
    private void CancelLogoUpload() => _logoUploadCancellation?.Cancel();

    /// <summary>更新当前浏览器主题。</summary>
    /// <param name="theme">明亮或暗黑主题。</param>
    private async Task SelectThemeAsync(string theme)
    {
        if (_shell is null) { return; }
        await _shell.InvokeVoidAsync("setTheme", theme);
        Theme.SetTheme(theme);
    }

    /// <summary>更新当前浏览器语言。</summary>
    /// <param name="args">下拉框选择值。</param>
    private async Task SelectLanguageAsync(ChangeEventArgs args)
    {
        if (_shell is null) { return; }
        var language = args.Value?.ToString() ?? LanguageManager.DefaultLanguageCode;
        await _shell.InvokeVoidAsync("setLanguage", language);
        Language.SetLanguage(language);
    }

    /// <summary>管理员保存站点品牌和默认外观；普通用户只保存当前浏览器偏好。</summary>
    private async Task SaveAsync()
    {
        if (_saving || _uploading || _shell is null) { return; }
        _saving = true;
        try
        {
            if (_admin)
            {
                Store.Save(new AppearanceSettings { Title = _title, Description = _description, LogoDataUrl = _logo, Language = Language.CurrentLanguageCode, Theme = Theme.Current });
            }
            await _shell.InvokeVoidAsync("setTheme", Theme.Current);
            await _shell.InvokeVoidAsync("setLanguage", Language.CurrentLanguageCode);
            Toast.ShowSuccess(T("SettingsSaved"));
        }
        catch (ArgumentException) { Toast.ShowError(T("SettingsInvalidTitle")); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        { Toast.ShowError(T("SettingsSaveFailed")); }
        finally { _saving = false; }
    }

    /// <summary>重新检测可选择的 GPU；不下载 CUDA 运行库。</summary>
    private async Task RefreshRuntimeGpusAsync()
    {
        if (_detectingRuntimeGpus) { return; }
        _detectingRuntimeGpus = true;
        try { _runtimeGpus = (await Metrics.RefreshGpuAsync(_runtimeCancellation.Token)).Gpus; }
        catch (OperationCanceledException) when (_runtimeCancellation.IsCancellationRequested) { }
        finally { _detectingRuntimeGpus = false; }
    }

    /// <summary>切换待应用的硬件，并清除属于上一次操作的进度或错误提示。</summary>
    /// <param name="hardware">本次选择的 CPU 或 CUDA 硬件。</param>
    private void SelectRuntimeHardware(OnnxRuntimeHardware hardware)
    {
        _runtimeHardware = hardware;
        _runtimeProgress = "";
    }

    /// <summary>独立应用硬件配置，避免外观设置和硬件准备失败时产生混淆。</summary>
    private async Task SaveRuntimeAsync()
    {
        if (!_admin || _saving) { return; }
        _saving = true; _runtimeProgress = "";
        try
        {
            await RuntimeSettings.SaveAsync(new OnnxRuntimeSettings { Hardware = _runtimeHardware, GpuId = _runtimeGpuId },
                message => _ = InvokeAsync(() => { _runtimeProgress = message; StateHasChanged(); }), _runtimeCancellation.Token);
            _runtimeProgress = T("SettingsRuntimeSaved");
            Toast.ShowSuccess(_runtimeProgress);
        }
        catch (OperationCanceledException) when (_runtimeCancellation.IsCancellationRequested) { }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException or NotSupportedException)
        { _runtimeProgress = error.Message; Toast.ShowError(error.Message); }
        finally { _saving = false; }
    }

    /// <summary>在界面调度线程刷新语言和主题变化。</summary>
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    /// <summary>取消当前页环境准备并解除界面事件订阅。</summary>
    public async ValueTask DisposeAsync()
    {
        Language.LanguageChanged -= Refresh; Theme.Changed -= Refresh;
        await _runtimeCancellation.CancelAsync();
        if (_environmentPoll is not null) { try { await _environmentPoll; } catch (OperationCanceledException) { } }
        _runtimeCancellation.Dispose();
        if (_shell is null) { return; }
        try { await _shell.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
