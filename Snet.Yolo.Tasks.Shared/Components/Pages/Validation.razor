  public async ValueTask DisposeAsync()
  {
    _disposed = true;
    Uploads.Changed -= OnUploadChanged;
    _lifetimeCts.Cancel();
    if (_statusRefreshTask is not null)
    {
      try { await _statusRefreshTask; } catch (OperationCanceledException) { }
    }
    _lifetimeCts.Dispose();
    Language.LanguageChanged -= OnLanguageChanged;
    Ffmpeg.Changed -= OnFfmpegChanged;
    if (_drawModule is not null)
    {
      if (_viewerOpen)
      {
        try { await _drawModule.InvokeVoidAsync("detachImageViewer"); } catch (JSDisconnectedException) { }
      }
      try { await _drawModule.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
  }
