  /// <summary>上传进度变化：任务结束后刷新模型与文件列表。</summary>
  private void OnUploadChanged()
  {
    if (_disposed) { return; }
    _ = InvokeAsync(async () =>
    {
      var running = Uploads.Busy;
      if (_uploadWasRunning && !running)
      {
        _uploadWasRunning = false;
        // 模型上传完成后关闭弹窗；失败时保留弹窗以便查看原因。
        if (Uploads.GetJob(ModelUploadScopeKey) is { Phase: UploadPhase.Completed }) { _showAdd = false; }
        else if (Uploads.GetJob(FileUploadScopeKey) is { Phase: UploadPhase.Completed }) { AddLog("ImageUploaded"); }
        await Reload();
        if (_sel is not null && _models.Any(model => model.index == _sel.index))
        {
          await LoadModelAsync(_sel.index, ++_selectionVersion);
        }
      }
      else { _uploadWasRunning = running; }
      StateHasChanged();
    });
  }

