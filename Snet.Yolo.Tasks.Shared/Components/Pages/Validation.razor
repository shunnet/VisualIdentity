  /// <summary>关闭删除确认弹窗并清理待删除目标。</summary>
  private void CancelDeleteModel() { _confirmModelIndex = null; _confirmImageId = null; _confirmModelMessage = string.Empty; }
  /// <summary>执行弹窗确认后的模型或验证文件删除。</summary>
  private async Task ConfirmDeleteModelAsync()
  {
    if (_confirmImageId is not null)
    {
      var imageId = _confirmImageId.Value;
      CancelDeleteModel();
      var image = _images.FirstOrDefault(item => item.Id == imageId);
      if (image is not null && _sel is not null)
      {
        if (GetVideoStatus(image) is { IsTerminal: false })
        {
          _videoBusyPrompt = true;
          return;
        }
        State.RemoveImage(_userName, _sel.index, imageId);
        VideoQueue.Forget(_userName, _sel.index, imageId);
        await Valid.DeleteValidationImageAsync(image.Url);
        await Valid.DeleteValidationImageAsync(image.ResultUrl);
        await LoadModelAsync(_sel.index, ++_selectionVersion);
      }
      return;
    }
    var index = _confirmModelIndex;
    CancelDeleteModel();
    if (index is null) { return; }
    var modelImages = State.GetModel(_userName, index.Value).Images;
    if (modelImages.Any(image => GetVideoStatusForModel(index.Value, image) is { IsTerminal: false }))
    {
      _videoBusyPrompt = true;
      return;
    }
    if (_sel?.index == index) { ++_selectionVersion; _sel = null; _params = new(); ClearCurrentImage(); }
    foreach (var image in modelImages) { VideoQueue.Forget(_userName, index.Value, image.Id); }
    var result = await Valid.DeleteModelAsync(index.Value);
    if (result.Status)
    {
      foreach (var url in State.RemoveModel(_userName, index.Value)) { await Valid.DeleteValidationImageAsync(url); }
    }
    await Reload();
  }

  private async Task Identify()
  {
    if (_sel is null || _selectedImageId is null || _selectedImage is null) { return; }
    if (_identifying) { return; }   // 点图自动识别与按钮可能同时触发，避免重复推理
    var model = _sel;
    var imageId = _selectedImageId.Value;
    var image = _selectedImage;
    var json = _params.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(_params) : "{}";
    AddLiteralLog("识别参数：" + string.Join("，", _params.Select(parameter => $"{ParameterLabel(parameter.Key)}={parameter.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}")));
    if (image.IsVideo)
    {
      if (GetVideoStatus(image) is { IsTerminal: false })
      {
        _videoBusyPrompt = true;
        return;
      }
      // 视频要先有 FFmpeg 才能解码：缺失时先解决工具问题，避免直接丢进队列后失败
      if (!Ffmpeg.IsAvailable)
      {
        AddLiteralLog("未检测到 FFmpeg，视频识别需要先完成自检/安装。");
        Toast.ShowWarning(Language.Translate("FfmpegUnavailable"));
        if (!FfmpegState.IsBusy) { OpenFfmpegDialog(); }
        else { await Ffmpeg.EnsureAsync(); }
        await InvokeAsync(StateHasChanged);
        return;
      }
      _reportedVideoJobs.Remove(image.Id);
      if (!VideoQueue.TryEnqueue(_userName, model, image, json))
      {
        Toast.ShowError("视频识别队列已满或该视频正在识别，请稍后重试。");
        return;
      }
      AddLog("Identifying");
      await InvokeAsync(StateHasChanged);
      return;
    }
    var stopwatch = System.Diagnostics.Stopwatch.StartNew();
    _identifying = true; AddLog("Identifying");
    try
    {
      var detections = new List<(string Name, string Conf, string Pos, int Count)>();
      Snet.Model.data.OperateResult? lastResult = null;
      if (_img is not null)
      {
        lastResult = await Valid.RunLocalAsync(model, _img, json);
        detections.AddRange(ParseDetections(lastResult));
      }
      if (lastResult is null) { return; }
      if (!lastResult.Status)
      {
        // 识别本身失败：先把真实原因写进日志再收尾。
        // 曾经这里直接序列化结果，ResultData 里的异常对象会让序列化抛错，
        // 结果只显示一句序列化失败，看不到模型/运行时到底报了什么。
        State.SetResult(_userName, model.index, imageId, null, Array.Empty<ValidationDetection>());
        AddLog("IdentificationRunTime", new object[] { lastResult.RunTime });
        AddLog("IdentifyReturned", detail: lastResult.Message ?? "");
        _result = null;
        _detections = new List<(string Name, string Conf, string Pos, int Count)>();
        _images = State.GetModel(_userName, model.index).Images.ToList();
        return;
      }
      var resultJson = ValidationService.SerializeResult(lastResult, indented: true);
      State.SetResult(_userName, model.index, imageId, resultJson, detections.Select(detection => new ValidationDetection(detection.Name, detection.Conf, detection.Pos, detection.Count)));
      AddLog("IdentificationRunTime", new object[] { lastResult.RunTime });
      if (_sel?.index != model.index || _selectedImageId != imageId) { return; }
      _result = resultJson;
      _detections = detections;
      _images = State.GetModel(_userName, model.index).Images.ToList();
      if (lastResult.Status) { AddLog("LocalIdentifyComplete", new object[] { detections.Count }); }
      else { AddLog("IdentifyReturned", detail: lastResult.Message ?? ""); }
      _needsRedraw = !_selectedImage.IsVideo;
    }
    catch (TaskCanceledException) { _log.Add(new LocalizedLog(null, Array.Empty<object>(), Literal: "ERR 视频抽帧超时，请确认视频可正常播放后重试")); }
    catch (Exception ex) { _log.Add(new LocalizedLog(null, Array.Empty<object>(), Literal: "ERR " + ex.Message)); }
    finally { stopwatch.Stop(); AddLog("IdentificationTotalTime", new object[] { stopwatch.ElapsedMilliseconds }); _identifying = false; StateHasChanged(); }
  }

