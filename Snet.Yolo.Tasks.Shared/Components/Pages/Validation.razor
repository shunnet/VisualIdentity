  /// <summary>生成视频识别状态栏文本，供视频顶部实时显示。</summary>
  private static string VideoStatusText(VideoRecognitionStatus job)
  {
    var elapsed = job.Elapsed.TotalSeconds;
    var stage = job.Stage switch
    {
      VideoRecognitionStage.Queued => "正在排队",
      VideoRecognitionStage.Decoding => "正在解码视频",
      VideoRecognitionStage.LoadingModel => "正在初始化模型",
      VideoRecognitionStage.Recognizing => "正在逐帧识别",
      VideoRecognitionStage.Encoding => "正在生成结果视频",
      VideoRecognitionStage.Completed => "识别完成",
      VideoRecognitionStage.Cancelled => "已取消识别",
      _ => "识别失败",
    };
    if (job.TotalFrames == 0)
    {
      return $"{stage}… · 累计用时 {elapsed:0} 秒";
    }
    var rate = elapsed > 0 ? job.CompletedFrames / elapsed : 0;
    var remaining = Math.Max(0, job.TotalFrames - job.CompletedFrames);
    if (job.CompletedFrames == 0)
    {
      return $"{stage}  ·  总帧数 {job.TotalFrames}  ·  帧率 {job.FramesPerSecond:0.##} FPS  ·  已识别 0 帧  ·  剩余 {remaining} 帧  ·  预计用时将在首帧完成后计算  ·  累计用时 {elapsed:0} 秒";
    }
    var estimate = rate > 0 ? remaining / rate : 0;
    return $"{stage}  ·  总帧数 {job.TotalFrames}  ·  帧率 {job.FramesPerSecond:0.##} FPS  ·  已识别 {job.CompletedFrames} 帧  ·  剩余 {remaining} 帧  ·  预计还需 {estimate:0} 秒  ·  累计用时 {elapsed:0} 秒";
  }

  /// <summary>获取当前用户和模型下指定视频的宿主级后台任务状态。</summary>
  private VideoRecognitionStatus? GetVideoStatus(ValidationImageState image)
    => _sel is null || !image.IsVideo ? null : VideoQueue.GetStatus(_userName, _sel.index, image.Id);

  /// <summary>读取指定模型下视频任务状态，供模型删除前检查活动任务。</summary>
  private VideoRecognitionStatus? GetVideoStatusForModel(int modelIndex, ValidationImageState image)
    => !image.IsVideo ? null : VideoQueue.GetStatus(_userName, modelIndex, image.Id);

  /// <summary>每秒同步后台视频任务状态，并在完成后切换到带标注的视频文件。</summary>
  private async Task RefreshVideoStatusesAsync(CancellationToken cancellationToken)
  {
    using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
    while (await timer.WaitForNextTickAsync(cancellationToken))
    {
      await InvokeAsync(async () =>
      {
        if (_sel is null) { return; }
        var modelState = State.GetModel(_userName, _sel.index);
        _images = modelState.Images.ToList();
        if (_selectedImageId is { } selectedId)
        {
          var refreshed = _images.FirstOrDefault(item => item.Id == selectedId);
          if (refreshed is not null)
          {
            _selectedImage = refreshed;
            var status = GetVideoStatus(refreshed);
            if (status is { Stage: VideoRecognitionStage.Completed } && refreshed.ResultUrl is not null)
            {
              _imgUrl = refreshed.ResultUrl;
              _result = refreshed.ResultJson;
              _detections = refreshed.Detections.Select(item => (item.Name, item.Confidence, item.Position, item.Count)).ToList();
              if (_reportedVideoJobs.Add(refreshed.Id))
              {
                if (status.LastFrameRunTimeMilliseconds is { } runTime) { AddLog("IdentificationRunTime", new object[] { runTime }); }
                AddLiteralLog($"视频识别完成，累计用时 {status.Elapsed.TotalSeconds:0.##} 秒");
              }
            }
            else if (status is { Stage: VideoRecognitionStage.Failed } && _reportedVideoJobs.Add(refreshed.Id))
            {
              AddLiteralLog("ERR 视频识别失败: " + status.Error);
            }
            else if (status is { Stage: VideoRecognitionStage.Cancelled } && _reportedVideoJobs.Add(refreshed.Id))
            {
              AddLiteralLog("视频识别已取消。");
            }
          }
        }
        StateHasChanged();
        await Task.CompletedTask;
      });
    }
  }
  private async Task DrawMarkAsync()
  {
    try {
      var module = await LoadDrawModuleAsync();
      if (module is null) { return; }
      _drawModule = module;
      await module.InvokeVoidAsync("draw", "val-mark", PreviewUrl(_selectedImage) ?? "", _result ?? "", _sel?.onnxType?.ToString() ?? _selType, true, _selectedImage?.Width ?? 0, _selectedImage?.Height ?? 0, _imgUrl);
    } catch (Exception ex) { AddLog("AnnotationDrawFailed", detail: ex.Message); }
  }

  /// <summary>
  /// 双击图片区域：打开大图查看器看标注细节。只有图片会打开（视频走播放器，不接查看器），
  /// 且需要当前图片已有识别结果（弹窗展示的是标注后的图）。
  /// </summary>
  private void OpenViewer()
  {
    if (_selectedImage is null || _selectedImage.IsVideo) { return; }
    if (_result is null || string.IsNullOrEmpty(_imgUrl)) { return; }
    _viewerName = _selectedImage.Name;
    _viewerImageUrl = _imgUrl;   // 查看器就是要看清细节：直接用原图（预览只作兜底）
    _viewerResultJson = _result;
    _viewerType = _sel?.onnxType?.ToString() ?? _selType;
    _viewerOriginal = false;   // 默认显示标注后的图
    _viewerOpen = true;
    _viewerNeedsAttach = true;
    _viewerLoading = true;     // 打开即显示加载态：原图较大时不会出现"一片黑"
    _viewerLoadFailed = false;
  }

  /// <summary>查看器里切换"原图"：切到原图后只画原图，再点恢复标注图（缩放/平移位置保持不变）。</summary>
  private async Task ToggleViewerOriginalAsync()
  {
    _viewerOriginal = !_viewerOriginal;
    await DrawViewerAsync();
  }

  /// <summary>把标注图或原图画进查看器画布（画布保持原图分辨率，放大后依然清晰）。</summary>
  private async Task DrawViewerAsync()
  {
    try
    {
      var module = await LoadDrawModuleAsync();
      if (module is null) { return; }
      _drawModule = module;
      // 原图可能很大（现场 75 MB），加载期间显示进度，加载不出来时给明确提示，避免"打开就是黑的"
      _viewerLoading = true;
      _viewerLoadFailed = false;
      StateHasChanged();
      var painted = await module.InvokeAsync<bool>("draw", "val-viewer-canvas", _viewerImageUrl, _viewerResultJson, _viewerType, !_viewerOriginal, _selectedImage?.Width ?? 0, _selectedImage?.Height ?? 0, PreviewUrl(_selectedImage));
      _viewerLoading = false;
      _viewerLoadFailed = !painted;
      if (!painted) { AddLiteralLog("ERR 查看器加载图片失败（原图与预览都取不到）"); }
    }
    catch (Exception ex)
    {
      _viewerLoading = false;
      _viewerLoadFailed = true;
      AddLog("AnnotationDrawFailed", detail: ex.Message);
    }
    finally { StateHasChanged(); }
  }

  /// <summary>还原：缩放比例与平移回到初始（整图适应窗口）。</summary>
  private async Task ResetViewerAsync()
  {
    try
    {
      if (_drawModule is null) { return; }
      if (_drawModule is not null) { await _drawModule.InvokeVoidAsync("resetImageViewer", "val-viewer"); }
    }
    catch (Exception ex) { AddLog("AnnotationDrawFailed", detail: ex.Message); }
  }

  /// <summary>
  /// 关闭查看器：必须是同步方法。Blazor 要等事件处理器的 Task 完成才重渲染，
  /// 若在这里 await 卸载监听的 JS 互操作，弹窗会等一个往返才消失（表现为"点了卡一下"）。
  /// 所以先把界面状态改掉让弹窗立刻收起，再后台异步卸载 JS 交互。
  /// </summary>
  private void CloseViewer()
  {
    _viewerOpen = false;
    _viewerOriginal = false;
    if (_drawModule is not null) { _ = DetachViewerAsync(); }
  }

  /// <summary>卸载查看器的滚轮/拖动/Esc 监听（弹窗已收起，失败只记日志）。</summary>
  private async Task DetachViewerAsync()
  {
    try { await _drawModule!.InvokeVoidAsync("detachImageViewer", "val-viewer", _viewerGeneration); }
    catch (JSDisconnectedException) { }
    catch (Exception ex) { AddLog("AnnotationDrawFailed", detail: ex.Message); }
  }

  /// <summary>启动视频播放标注层，使识别框随视频时间同步切换。</summary>
  private async Task DrawVideoOverlayAsync()
  {
    if (_selectedImage?.VideoFrames is not { Count: > 0 }) { return; }
    try
    {
      var module = await LoadDrawModuleAsync();
      if (module is null) { return; }
      _drawModule = module;
      await module.InvokeVoidAsync("showVideoAnnotations", "val-video", "val-video-overlay", _selectedImage.VideoFrames, _sel?.onnxType?.ToString() ?? _selType);
    }
    catch (Exception ex) { AddLog("AnnotationDrawFailed", detail: ex.Message); }
  }
  /// <summary>追加一条日志，并标记日志面板需要滚动到最新记录。</summary>
  private void AddLog(string key, object[]? args = null, string? detail = null)
  {
    _log.Add(new LocalizedLog(key, args ?? Array.Empty<object>(), detail));
    _logNeedsScroll = true;
  }

  /// <summary>写入后台任务的纯文本日志，并触发日志面板滚动。</summary>
  private void AddLiteralLog(string message)
  {
    _log.Add(new LocalizedLog(null, Array.Empty<object>(), Literal: message));
    _logNeedsScroll = true;
  }
  private string RenderLog(LocalizedLog entry)
  {
    if (entry.Literal is not null) { return entry.Literal; }
    var text = Language.Translate(entry.ResourceKey ?? "");
    if (entry.Args.Length > 0) { text = string.Format(text, entry.Args); }
    return string.IsNullOrWhiteSpace(entry.Detail) ? text : text + ": " + entry.Detail;
  }
  /// <summary>照片识别结果：每个目标一行（标签/置信度/坐标），Count 恒为 1（界面不展示）。</summary>
  private List<(string Name, string Conf, string Pos, int Count)> ParseDetections(Snet.Model.data.OperateResult r)
  {
    var list = new List<(string Name, string Conf, string Pos, int Count)>();
    try {
      var json = ValidationService.SerializeResult(r);
      var doc = System.Text.Json.JsonDocument.Parse(json);
      if (doc.RootElement.TryGetProperty("ResultData", out var rd) && rd.ValueKind == System.Text.Json.JsonValueKind.Array)
      {
        foreach (var b in rd.EnumerateArray())
        {
          var name = "?";
          if (b.TryGetProperty("Label", out var lab))
          {
            if (lab.ValueKind == System.Text.Json.JsonValueKind.String) { name = lab.GetString() ?? "?"; }
            else if (lab.TryGetProperty("Name", out var nn)) { name = nn.GetString() ?? "?"; }
          }
          var conf = b.TryGetProperty("Confidence", out var cf) ? (Math.Round(cf.GetDouble()*100))+"%" : "";
          var pos = b.TryGetProperty("Position", out var pp) ? pp.GetString() ?? "" : "";
          list.Add((name, conf, pos, 1));
        }
      }
    } catch { }
    return list;
  }

  private bool _needsRedraw;
  private bool _needsVideoOverlay;
  private bool _logNeedsScroll;

  /// <summary>查看器弹窗渲染完成后：先画内容，再挂滚轮缩放/拖动/双击还原/Esc 关闭。</summary>
  private async Task AttachViewerAsync()
  {
    if (!_viewerNeedsAttach || !_viewerOpen) { return; }
    _viewerNeedsAttach = false;
    try
    {
      await DrawViewerAsync();
      var module = await LoadDrawModuleAsync();
      if (module is null) { return; }
      _drawModule = module;
      _viewerGeneration = await module.InvokeAsync<int>("attachImageViewer", "val-viewer", "val-viewer-canvas", "val-viewer-close");
    }
    catch (JSDisconnectedException) { }
    catch (Exception ex) { AddLog("AnnotationDrawFailed", detail: ex.Message); }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_needsRedraw)
    {
      _needsRedraw = false;
      if (_result is not null && _imgUrl is not null) { await DrawMarkAsync(); }
    }
    if (_needsVideoOverlay)
    {
      _needsVideoOverlay = false;
      await DrawVideoOverlayAsync();
    }
    await AttachViewerAsync();
    if (_logNeedsScroll)
    {
      _logNeedsScroll = false;
      try
      {
        var module = await LoadDrawModuleAsync();
        if (module is null) { return; }
        _drawModule = module;
        await module.InvokeVoidAsync("scrollToBottom", "val-log");
      }
      catch (JSDisconnectedException) { }
    }
  }

  /// <summary>
  /// 加载前端绘制脚本。**任何失败都不能让 circuit 挂掉**：
  /// 曾经 val-draw.js 拉取失败（发布/网络抖动/页面被判忙）会从 OnAfterRenderAsync 抛出，
  /// 直接把整个 Blazor 会话打断，用户只能刷新。这里改为记录并提示，功能降级但页面可用。
  /// </summary>
  private async Task<IJSObjectReference?> LoadDrawModuleAsync()
  {
    if (_drawModule is not null) { return _drawModule; }
    if (_drawModuleFailed) { return null; }
    foreach (var url in new[] { "./js/val-draw.js?v=20260917", "./js/val-draw.js" })
    {
      try
      {
        _drawModule = await Js.InvokeAsync<IJSObjectReference>("import", url);
        return _drawModule;
      }
      catch (JSDisconnectedException) { _drawModuleFailed = true; return null; }   // 页面已断开，无需提示
      catch (Exception error)
      {
        Logger.LogWarning(error, "前端脚本加载失败：{Url}", url);
      }
    }
    _drawModuleFailed = true;
    AddLiteralLog("ERR 前端绘制脚本加载失败（不影响识别，可刷新页面重试）");
    return null;
  }
  /// <summary>
  /// 页面显示用的图片地址：走预览端点（原图不压缩，预览按需生成并缓存），
  /// 让浏览器不必解码 5120×5120 的大位图。视频与查看器仍使用原始地址
  /// （<c>/uploads/...</c>），保证细节与下载不受影响。
  /// </summary>
  private static string PreviewUrl(ValidationImageState? image)
  {
    if (image is null) { return string.Empty; }
    if (image.IsVideo) { return image.Url; }
    var name = image.Url[(image.Url.LastIndexOf('/') + 1)..];
    return string.IsNullOrWhiteSpace(name) ? image.Url : "/validation/preview?name=" + Uri.EscapeDataString(name);
  }
  /// <summary>加载当前用户与模型关联的图片队列，并恢复该模型最后选中的图片。</summary>
  private async Task LoadModelAsync(int modelIndex, int version)
  {
    var modelState = State.GetModel(_userName, modelIndex);
    if (version != _selectionVersion || _sel?.index != modelIndex) { return; }
    _images = modelState.Images.ToList();
    _selectedImageId = modelState.SelectedImageId;
    var selectedImage = _images.FirstOrDefault(image => image.Id == _selectedImageId);
    _selectedImage = selectedImage;
    if (selectedImage is null)
    {
      ClearSelectedContent();
      StateHasChanged();
      return;
    }
    await LoadImageAsync(modelIndex, selectedImage, version);
  }

  /// <summary>切换图片，并保存该模型当前选中的图片。</summary>
  /// <summary>
  /// 点击图片列表中的一项：先切换选中并载入内容；<b>照片</b>载入完成后自动执行一次识别，
  /// 省掉"点图 → 再点识别"两步；<b>视频</b>不自动识别（解码耗时且需要 FFmpeg），仍由用户点识别按钮触发。
  /// </summary>
  private async Task SelectImageAsync(ValidationImageState image)
  {
    if (_sel is null || !State.SelectImage(_userName, _sel.index, image.Id)) { return; }
    _selectedImageId = image.Id;
    _selectedImage = image;
    await LoadImageAsync(_sel.index, image, ++_selectionVersion);
    if (!image.IsVideo) { await Identify(); }
  }

  /// <summary>从当前进程的临时目录读取图片，并恢复该图片自己的识别结果。</summary>
  private async Task LoadImageAsync(int modelIndex, ValidationImageState image, int version)
  {
    try
    {
      var path = System.IO.Path.Combine(AppContext.BaseDirectory, "wwwroot", "data", image.Url.TrimStart('/'));
      var bytes = image.IsVideo ? Array.Empty<byte>() : await System.IO.File.ReadAllBytesAsync(path);
      if (version != _selectionVersion || _sel?.index != modelIndex || _selectedImageId != image.Id) { return; }
      _img = bytes;
      _imgUrl = image.ResultUrl ?? image.Url;
      _result = image.ResultJson;
      _selType = _sel?.onnxType?.ToString() ?? "";
      _detections = image.Detections.Select(detection => (detection.Name, detection.Confidence, detection.Position, detection.Count)).ToList();
      _needsRedraw = _result is not null && !image.IsVideo;
      _needsVideoOverlay = image.IsVideo && (image.VideoFrames?.Count ?? 0) > 0;
    }
    catch { ClearSelectedContent(); }
    StateHasChanged();
  }

  /// <summary>清空当前模型和图片的页面状态。</summary>
  private void ClearCurrentImage()
  {
    _images.Clear();
    _selectedImageId = null;
    _selectedImage = null;
    ClearSelectedContent();
  }

  /// <summary>清空图片画布和识别结果，但保留当前模型的图片列表。</summary>
  private void ClearSelectedContent()
  {
    _img = null;
    _imgUrl = null;
    _result = null;
    _selType = "";
    _detections.Clear();
    _needsRedraw = false;
    _needsVideoOverlay = false;
  }

  /// <summary>提取文件名后缀，统一以小写形式显示在列表前方。</summary>
  private static string FileExtension(string name) => System.IO.Path.GetExtension(name).ToLowerInvariant() is { Length: > 0 } extension ? extension : ".file";
  /// <summary>提取不含后缀的文件名，避免文件列表重复显示扩展名。</summary>
  private static string FileName(string name) => System.IO.Path.GetFileNameWithoutExtension(name);
  /// <summary>根据模型类型创建强类型数值参数，确保 JSON 中不会把阈值写成字符串。</summary>
  private static Dictionary<string, double> ParamsFor(Snet.Yolo.Server.models.@enum.OnnxType? t) => t switch {
    Snet.Yolo.Server.models.@enum.OnnxType.Classification => new(){["Classes"]=1},
    Snet.Yolo.Server.models.@enum.OnnxType.Segmentation => new(){["Confidence"]=0.2,["Iou"]=0.7,["PixelConfidence"]=0.65},
    _ => new(){["Confidence"]=0.2,["Iou"]=0.7},
  };
  /// <summary>获取动态验证参数的本地化名称，缺少资源时保留原始参数名。</summary>
  private string ParameterLabel(string parameterName)
  {
    var resourceKey = "ValidationParameter" + parameterName;
    var translated = Language.Translate(resourceKey);
    return translated == resourceKey ? parameterName : translated;
  }
  /// <summary>在输入时立即保存数值参数，并将阈值限制在模型支持的范围内。</summary>
  private void SetParam(string key, ChangeEventArgs args)
  {
    var text = args.Value?.ToString();
    if (!double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value)
        && !double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.CurrentCulture, out value)) { return; }
    _params[key] = key == "Classes" ? Math.Max(1, Math.Round(value)) : Math.Clamp(value, 0, 1);
    _result = null;
    _detections.Clear();
    _needsRedraw = false;
    _needsVideoOverlay = false;
  }
}
