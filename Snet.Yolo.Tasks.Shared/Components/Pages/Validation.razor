@page "/validation"
@attribute [Authorize]
@implements IAsyncDisposable
@using Snet.Yolo.Tasks.Services
@using Snet.Yolo.Server.models.data
@inject ValidationService Valid
@inject UploadCenter Uploads
@inject IExecutionProviderFactory ExecutionProviders
@inject LanguageManager Language
@inject ToastService Toast
@inject ValidationState State
@inject VideoRecognitionQueue VideoQueue
@inject FfmpegInstaller Ffmpeg
@inject IJSRuntime Js
@inject ILogger<Validation> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

<AppPageTitle ResourceKey="Validation" />

<div class="ls-refined-page ls-validation-page">
<div class="ls-page-head">
    <h1 class="ls-page-title ls-page-title-with-icon"><i class="bi bi-cpu" aria-hidden="true"></i><LangText Key="Validation" /></h1>
    <div class="ls-page-actions"><button class="btn btn-sm btn-primary" @onclick="OpenAddModel"><i class="bi bi-plus"></i> <LangText Key="AddModel" /></button></div>
</div>

<ConfirmDialog IsOpen="@(_confirmModelIndex is not null || _confirmImageId is not null)"
               Title="@Language.Translate("Delete")"
               Message="@_confirmModelMessage"
               Confirmed="ConfirmDeleteModelAsync"
               Cancelled="CancelDeleteModel" />

@if (_videoBusyPrompt)
{
    <div class="modal show d-block ls-confirm-modal" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-info-circle" aria-hidden="true"></i> 视频识别进行中</h5><button type="button" class="btn-close" @onclick="CloseVideoBusyPrompt" aria-label="关闭"></button></div>
            <div class="modal-body"><p class="ls-confirm-message">该视频正在后台识别，请等待当前任务完成后再重新识别。</p></div>
            <div class="modal-footer"><button type="button" class="btn btn-primary" @onclick="CloseVideoBusyPrompt">知道了</button></div>
        </div></div>
    </div>
    <div class="modal-backdrop show"></div>
}

<div class="ls-val">
    <!-- 左：模型列表 -->
    <aside class="ls-val-left">
        <div class="ls-val-head">
            <span class="ls-val-title"><i class="bi bi-cpu"></i><LangText Key="Model" /></span>
            <span class="ls-toolbar-count">@_models.Count</span>
        </div>
        <div class="ls-val-models">
            @foreach (var m in _models)
            {
                <div class="ls-model-item @(_sel?.index == m.index ? "active" : null)" @onclick="() => SelectModel(m)">
                    <div class="ls-model-row">
                        <div class="ls-model-txt"><div class="fw-semibold">@m.name</div><div class="small text-secondary">@m.onnxType</div></div>
                        <div class="ls-model-actions">
                            <a class="btn btn-icon-sm btn-outline-secondary" href="/api/models/@m.index/download" title="@Language.Translate("ExportModel")" aria-label="@($"{Language.Translate("ExportModel")}: {m.name}")" download><i class="bi bi-download" aria-hidden="true"></i></a>
                            <button class="btn btn-icon-sm btn-outline-danger" @onclick="() => Del(m.index)" title="@Language.Translate("Delete")" aria-label="@($"{Language.Translate("Delete")}: {m.name}")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                    </div>
                </div>
            }
            @if (_models.Count == 0)
            {
                <EmptyState Icon="bi-cpu" Class="ls-val-empty" Style="padding:1.5rem .5rem">
                    <Body><LangText Key="NoModels" /></Body>
                    <Actions><button class="btn btn-outline-secondary btn-sm" @onclick="OpenAddModel"><i class="bi bi-plus"></i> <LangText Key="AddModel" /></button></Actions>
                </EmptyState>
            }
        </div>
    </aside>

    <!-- 右：识别。?+ 独立日志卡片 -->
    <div class="ls-val-workspace">
    <main class="ls-val-console">
        <div class="ls-val-toolbar">
            <span class="ls-val-title"><i class="bi bi-speedometer2"></i><LangText Key="Identify" /></span>
            @if (_sel is not null)
            {
                <div class="ls-val-actions">
                    <label for="@UploadCenter.ImagesInputId" class="btn btn-outline-secondary btn-sm @UploadDisabledClass" aria-disabled="@Uploads.Busy"><i class="bi @(Uploads.Busy ? "bi-arrow-repeat ls-upload-icon-spin" : "bi-upload")"></i> <LangText Key="UploadFile" /></label>
                    <button class="btn btn-primary btn-sm" @onclick="Identify" disabled="@_identifying">
                        @if (_identifying) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                        else { <i class="bi bi-crosshair" aria-hidden="true"></i> }
                        @(_identifying ? "识别中…" : Language.Translate("Identify"))
                    </button>
                </div>
            }
        </div>

        @if (_sel is not null)
        {
            <UploadStatus ScopeKey="@FileUploadScopeKey" />
        }

        @* 视频识别前置：FFmpeg 自检/安装进度（与上传横幅同一套样式） *@
        @if (FfmpegState.IsVisible)
        {
            <div class="ls-upload-status @(FfmpegState.Phase == FfmpegInstallPhase.Failed ? "ls-upload-status-error" : null)" role="status" aria-live="polite">
                <div class="ls-upload-status-head">
                    <span>
                        @if (FfmpegState.IsBusy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        else { <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i> }
                        @FfmpegState.Message
                    </span>
                    <strong>@(FfmpegState.BarPercent is int percent ? percent + "%" : "进行中")</strong>
                </div>
                <div class="progress ls-progress ls-upload-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(FfmpegState.BarPercent ?? 0)">
                    <div class="progress-bar progress-bar-striped @(FfmpegState.IsBusy ? "progress-bar-animated" : null)" style="width:@(FfmpegState.BarPercent ?? 100)%"></div>
                </div>
                @if (FfmpegState.LogTail.Count > 0)
                {
                    <div class="ls-upload-log">@foreach (var line in FfmpegState.LogTail) { <div class="ls-term-line">@line</div> }</div>
                }
                <div class="ls-upload-actions">
                    <span>FFmpeg</span>
                    @if (FfmpegState.IsBusy)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelFfmpegInstall"><i class="bi bi-stop-circle"></i> @Language.Translate("Cancel")</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenFfmpegDialog"><i class="bi bi-sliders"></i> @Language.Translate("FfmpegChoose")</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Ffmpeg.Dismiss"><i class="bi bi-x-lg"></i> @Language.Translate("Close")</button>
                    }
                </div>
            </div>
        }

        @if (_sel is not null)
        {
            <div class="ls-val-params">
                <div class="ls-val-fields">
                    @foreach (var kv in _params)
                    {
                        <div class="ls-param"><label for="@($"val-param-{kv.Key}")">@ParameterLabel(kv.Key)<span aria-hidden="true">:</span></label><input id="@($"val-param-{kv.Key}")" type="number" min="@(kv.Key == "Classes" ? "1" : "0")" max="@(kv.Key == "Classes" ? null : "1")" step="@(kv.Key == "Classes" ? "1" : "0.01")" class="form-control form-control-sm" value="@kv.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" @oninput="e => SetParam(kv.Key, e)" /></div>
                    }
                </div>
            </div>

            <div class="ls-val-body">
                <div class="ls-val-result-panel">
                    <div class="ls-val-panel-title"><i class="bi bi-crosshair"></i> <LangText Key="Detections" /></div>
                    <div class="ls-val-result-content">
                        @if (_result is not null)
                        {
                            @if (_detections.Count > 0)
                            {
                                <div class="ls-detect-list">
                                    @foreach (var d in _detections)
                                    {
                                        @* 视频：按标签聚合（平均置信度 + 全片识别次数，不展示坐标）；照片：保持单目标一行（含坐标） *@
                                        <div class="ls-detect-row">
                                            <span class="badge text-bg-danger">@d.Name</span>
                                            <span class="ls-detect-conf">@d.Conf</span>
                                            @if (IsVideoSelected)
                                            {
                                                <span class="ls-detect-count" title="@Language.Translate("Detections")">×@d.Count</span>
                                            }
                                            else
                                            {
                                                <span class="ls-detect-pos">@d.Pos</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else { <div class="ls-hint">@Language.Translate("NoTargets")</div> }
                        }
                        else { <div class="ls-hint"><LangText Key="IdentifyFirst" /></div> }
                    </div>
                </div>
                <div class="ls-val-image-panel">
                    <div class="ls-val-panel-title"><i class="bi bi-files"></i> <LangText Key="FileCount" /><span class="ls-toolbar-count ms-auto">@_images.Count</span></div>
                    <div class="ls-val-image-list">
                        @foreach (var image in _images)
                        {
                            <div class="ls-val-image-item-wrap">
                            <button type="button" class="ls-val-image-item @(_selectedImageId == image.Id ? "active" : null)" @onclick="() => SelectImageAsync(image)" title="@image.Name" aria-pressed="@(_selectedImageId == image.Id)">
                                @if (image.IsVideo) { <span class="ls-val-file-icon"><i class="bi bi-film" aria-hidden="true"></i></span> } else { <img src="@PreviewUrl(image)" data-original="@image.Url" onerror="snetImageFallback(this)" alt="" loading="lazy" decoding="async" /> }
                                <span><b class="ls-val-file-ext">@FileExtension(image.Name)</b> @FileName(image.Name)</span>
                                @if (GetVideoStatus(image) is { IsTerminal: false })
                                { <span class="ls-val-video-job" title="后台识别中" aria-label="后台识别中"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span></span> }
                                else if (image.ResultJson is not null) { <i class="bi bi-check-circle-fill" aria-label="@Language.Translate("Detections")"></i> }
                            </button>
                            <button type="button" class="btn btn-icon-sm btn-outline-danger ls-val-file-delete" @onclick="() => RequestDeleteImage(image)" title="@Language.Translate("Delete")" aria-label="@Language.Translate("Delete")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </div>
                        }
                        @if (_images.Count == 0) { <div class="ls-hint"><LangText Key="UploadFile" /></div> }
                    </div>
                </div>
                <div class="ls-val-imgs @(_result is not null ? "has-mark" : null)" @ondblclick="OpenViewer">
                    @if (_imgUrl is null) { <div class="ls-hint"><LangText Key="UploadFile" /></div> }
                    else
                    {
                        @if (_selectedImage?.IsVideo == true)
                        {
                            @if (GetVideoStatus(_selectedImage) is { IsTerminal: false } currentVideoJob)
                            {
                                <div class="ls-val-video-status" role="status">
                                    <span>@VideoStatusText(currentVideoJob)</span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => CancelVideoJob(_selectedImage)"><i class="bi bi-stop-circle" aria-hidden="true"></i> @Language.Translate("Cancel")</button>
                                </div>
                            }
                            <video id="val-video" class="ls-val-orig ls-val-video" src="@_imgUrl" controls playsinline preload="metadata"></video>
                            @if (_result is not null)
                            {
                                <div class="ls-val-video-result" role="status"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> 全部帧识别完成，视频仍可播放</div>
                            }
                        }
                        else { <img class="ls-val-orig" src="@PreviewUrl(_selectedImage)" data-original="@_imgUrl" onerror="snetImageFallback(this)" alt="@Language.Translate("UploadFile")" decoding="async" /> }
                        @if (_result is not null && _selectedImage?.IsVideo != true) { <canvas id="val-mark" class="ls-val-mark"></canvas> }
                    }
                </div>
            </div>
        }
        else
        {
            <EmptyState Icon="bi-cpu" Class="ls-val-empty"><Body><LangText Key="SelectModel" /></Body></EmptyState>
        }
    </main>

    <section class="ls-val-log-dock" aria-label="@Language.Translate("Log")">
        <div class="ls-val-log-title"><i class="bi bi-terminal" aria-hidden="true"></i> <LangText Key="Log" /></div>
        <div id="val-log" class="ls-val-log"><div class="ls-term-line" style="height:1px"></div>@foreach (var l in _log) { <div class="ls-term-line">@RenderLog(l)</div> }</div>
    </section>
    </div>
</div>

@if (_ffmpegDialogOpen)
{
  <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-label="@Language.Translate("FfmpegTitle")">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-camera-video" aria-hidden="true"></i><LangText Key="FfmpegTitle" /></h5><button type="button" class="btn-close" @onclick="CloseFfmpegDialog" aria-label="@Language.Translate("Close")"></button></div>
        <div class="modal-body">
          <p class="ls-hint">@Language.Translate("FfmpegIntro")</p>
          @if (FfmpegState.Phase == FfmpegInstallPhase.Failed && !string.IsNullOrWhiteSpace(FfmpegState.Error))
          {
            <div class="ls-error mb-2">@FfmpegState.Error</div>
          }
          <div class="ls-type-grid" role="radiogroup" aria-label="@Language.Translate("FfmpegTitle")">
            <button type="button" class="ls-type-card @(!_ffmpegDownloadOption ? "active" : null)" @onclick="() => _ffmpegDownloadOption = false" role="radio" aria-checked="@(!_ffmpegDownloadOption)">
              @if (!_ffmpegDownloadOption) { <i class="bi bi-check-lg ls-type-check"></i> }
              <i class="bi bi-folder2-open" aria-hidden="true"></i><span>@Language.Translate("FfmpegManual")</span>
            </button>
            <button type="button" class="ls-type-card @(_ffmpegDownloadOption ? "active" : null)" @onclick="() => _ffmpegDownloadOption = true" role="radio" aria-checked="@_ffmpegDownloadOption">
              @if (_ffmpegDownloadOption) { <i class="bi bi-check-lg ls-type-check"></i> }
              <i class="bi @(OperatingSystem.IsWindows() ? "bi-cloud-arrow-down" : "bi-box-seam")" aria-hidden="true"></i><span>@Language.Translate(FfmpegInstallOptionKey)</span>
            </button>
          </div>
          @if (_ffmpegDownloadOption)
          {
            <div class="ls-hint">@Language.Translate(FfmpegInstallHintKey)</div>
          }
          else
          {
            <div>
              <label class="ls-field-label" for="ffmpeg-path">@Language.Translate("FfmpegPathLabel")</label>
              <input id="ffmpeg-path" class="form-control" placeholder="@Language.Translate("FfmpegPathPlaceholder")" value="@_ffmpegManualPath" @oninput="e => _ffmpegManualPath = e.Value?.ToString() ?? string.Empty" />
              <div class="ls-hint">@Language.Translate("FfmpegPathHint")</div>
            </div>
          }
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" @onclick="CloseFfmpegDialog" disabled="@_ffmpegApplying">@Language.Translate("Cancel")</button>
          <button type="button" class="btn btn-primary" @onclick="ConfirmFfmpegDialogAsync" disabled="@_ffmpegApplying">
            @if (_ffmpegApplying) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> } else { <i class="bi bi-check-lg" aria-hidden="true"></i> }
            @Language.Translate("Confirm")
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop show"></div>
}

@if (_viewerOpen)
{
  <div class="modal show d-block ls-viewer-modal" tabindex="-1" role="dialog" aria-modal="true" aria-label="@_viewerName" @onclick="CloseViewer">
    <div class="modal-dialog ls-viewer-dialog" @onclick:stopPropagation="true">
      <div class="modal-content ls-viewer-content">
        <div class="ls-viewer-head">
          <span class="ls-viewer-title" title="@_viewerName"><i class="bi bi-image" aria-hidden="true"></i><span class="ls-viewer-name">@_viewerName</span><span class="ls-viewer-hint"><i class="bi bi-info-circle" aria-hidden="true"></i>@Language.Translate("ViewerHint")</span></span>
          <div class="ls-viewer-actions">
            <button type="button" class="ls-viewer-icon @(_viewerOriginal ? "active" : null)" @onclick="ToggleViewerOriginalAsync" aria-pressed="@_viewerOriginal" title="@Language.Translate("OriginalImage")" aria-label="@Language.Translate("OriginalImage")"><i class="bi @(_viewerOriginal ? "bi-image-fill" : "bi-image")" aria-hidden="true"></i></button>
            <span class="ls-viewer-divider" aria-hidden="true"></span>
            <button type="button" class="ls-viewer-icon" @onclick="ResetViewerAsync" title="@Language.Translate("ResetView")" aria-label="@Language.Translate("ResetView")"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
            <span class="ls-viewer-divider" aria-hidden="true"></span>
            <button type="button" id="val-viewer-close" class="ls-viewer-icon" @onclick="CloseViewer" title="@Language.Translate("Close")" aria-label="@Language.Translate("Close")"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
          </div>
        </div>
        <div id="val-viewer" class="ls-viewer-stage">
          @* 原图可能很大（现场 75 MB），加载期间必须给反馈，否则就是一片黑 *@
          @if (_viewerLoading)
          {
            <div class="ls-viewer-loading" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>@Language.Translate("ViewerLoading")</span></div>
          }
          else if (_viewerLoadFailed)
          {
            <div class="ls-viewer-loading is-failed" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>@Language.Translate("ViewerLoadFailed")</span></div>
          }
          <canvas id="val-viewer-canvas" class="ls-viewer-canvas"></canvas>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop show"></div>
}

@if (_showAdd)
{
  <div class="modal show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-plus-circle" aria-hidden="true"></i><LangText Key="AddModel" /></h5><button class="btn-close" @onclick="CloseAddModel" aria-label="@Language.Translate("Close")"></button></div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="ls-field-label"><LangText Key="ModelName" /></label>
            <input class="form-control" autofocus value="@Uploads.Draft.ModelName" @oninput="e => SetDraft(draft => draft.ModelName = e.Value?.ToString() ?? string.Empty)" />
          </div>
          <div class="mb-3">
            <label class="ls-field-label"><LangText Key="Describe" /></label>
            <input class="form-control" value="@Uploads.Draft.ModelDescribe" @oninput="e => SetDraft(draft => draft.ModelDescribe = e.Value?.ToString() ?? string.Empty)" />
          </div>
          <div class="mb-3">
            <label class="ls-field-label"><LangText Key="ModelType" /></label>
            <div class="ls-type-grid" role="radiogroup" aria-label="@Language.Translate("ModelType")">
              @foreach (var t in ModelTypeOptions)
              {
                var isSel = Uploads.Draft.ModelType == t.Value;
                <button type="button" class="ls-type-card @(isSel ? "active" : null)" @onclick="() => SetDraft(draft => draft.ModelType = t.Value)" role="radio" aria-checked="@isSel">
                  @if (isSel) { <i class="bi bi-check-lg ls-type-check"></i> }
                  <i class="bi @t.Icon"></i><span>@Language.Translate(t.Key)</span>
                </button>
              }
            </div>
          </div>
          <label for="@UploadCenter.OnnxInputId" class="ls-upload-zone @(PendingModel is not null ? "has-files" : null) @(Uploads.Busy ? "uploading" : null)">
            <i class="bi @(Uploads.Busy ? "bi-arrow-repeat ls-upload-icon-spin" : "bi-file-earmark-binary") ls-upload-icon"></i>
            <div class="ls-upload-main">@Language.Translate("UploadOnnx")</div>
            <div class="ls-upload-sub">.onnx</div>
            @if (PendingModel is not null)
            {
              <div class="ls-upload-count">@PendingModel.Name · @((PendingModel.Size / 1024.0 / 1024.0).ToString("0.###")) MB</div>
            }
          </label>
          <UploadStatus ScopeKey="@ModelUploadScopeKey" />
        </div>
        <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="CloseAddModel" disabled="@Uploads.Busy"><i class="bi bi-x-lg"></i> @Language.Translate("Cancel")</button><button class="btn btn-primary" @onclick="ConfirmAddModel" disabled="@(Uploads.Busy || PendingModel is null)">@if (Uploads.Busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> } else { <i class="bi bi-check-lg"></i> } @Language.Translate("Create")</button></div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop show"></div>
}

</div>

@code {
  private List<OnnxData> _models = new();
  private OnnxData? _sel;
  private bool _identifying;
  private byte[]? _img;
  private string? _imgUrl;
  private string _selType = "";
  private string? _result;
  private Dictionary<string, double> _params = new();
  /// <summary>当前选中的文件是否是视频（决定识别结果面板展示"坐标"还是"识别次数"）。</summary>
  private bool IsVideoSelected => _selectedImage?.IsVideo == true;

  /// <summary>识别结果列表；Count 仅视频聚合结果有意义（照片恒为 1，不展示）。</summary>
  private List<(string Name, string Conf, string Pos, int Count)> _detections = new();
  private List<ValidationImageState> _images = new();
  private Guid? _selectedImageId;
  private ValidationImageState? _selectedImage;
  private string _userName = "";
  private sealed record LocalizedLog(string? ResourceKey, object[] Args, string? Detail = null, string? Literal = null);
  private readonly List<LocalizedLog> _log = new();
  private bool _showAdd;
  private int? _confirmModelIndex;
  private Guid? _confirmImageId;
  private string _confirmModelMessage = string.Empty;
  private readonly CancellationTokenSource _lifetimeCts = new();
  private Task? _statusRefreshTask;
  private readonly HashSet<Guid> _reportedVideoJobs = new();
  private bool _videoBusyPrompt;
  private IJSObjectReference? _drawModule;
  private bool _drawModuleFailed;
  private int _selectionVersion;
  private bool _disposed;
  private bool _uploadWasRunning;
  private bool _hardwareNoticeShown;

  /* 大图查看器（双击图片打开，只对图片生效；视频不接） */
  private bool _viewerOpen;
  private bool _viewerOriginal;
  private string _viewerName = "";
  private string _viewerImageUrl = "";
  /// <summary>查看器是否正在加载原图（大图需要时间，必须给用户反馈）。</summary>
  private bool _viewerLoading;
  /// <summary>查看器原图与预览都加载失败。</summary>
  private bool _viewerLoadFailed;
  private string _viewerResultJson = "";
  private string _viewerType = "";
  private bool _viewerNeedsAttach;
  /// <summary>JS 侧查看器代次：关闭时异步卸载要带上它，避免迟到的卸载把刚重开的查看器拆掉。</summary>
  private int _viewerGeneration;

  /* 视频识别前置：FFmpeg 自检/安装（Windows 弹窗选择，Linux 直接后台安装） */
  private bool _ffmpegDialogOpen;
  private bool _ffmpegDownloadOption;
  private string _ffmpegManualPath = string.Empty;
  private bool _ffmpegApplying;
  private string? _ffmpegReportedError;

  /// <summary>当前 FFmpeg 安装状态（供横幅渲染）。</summary>
  private FfmpegInstallState FfmpegState => Ffmpeg.State;
  /// <summary>自动安装选项的文案键（Windows 走下载安装，其它平台走包管理器）。</summary>
  private static string FfmpegInstallOptionKey => OperatingSystem.IsWindows() ? "FfmpegDownload" : "FfmpegApt";
  /// <summary>自动安装说明的文案键。</summary>
  private static string FfmpegInstallHintKey => OperatingSystem.IsWindows() ? "FfmpegDownloadHint" : "FfmpegAptHint";

  /// <summary>打开 FFmpeg 选择弹窗（手动指定路径 / 自动安装）。</summary>
  private void OpenFfmpegDialog()
  {
    _ffmpegDialogOpen = true;
    // 已安装过就把当前路径填进去，方便用户确认或替换
    if (string.IsNullOrWhiteSpace(_ffmpegManualPath)) { _ffmpegManualPath = FfmpegState.InstalledPath ?? string.Empty; }
  }

  private void CloseFfmpegDialog() => _ffmpegDialogOpen = false;

  /// <summary>确定：点"手动指定"校验并记录路径；点"自动安装"关闭弹窗后异步安装（页面上显示进度）。</summary>
  private async Task ConfirmFfmpegDialogAsync()
  {
    if (_ffmpegApplying) { return; }
    _ffmpegApplying = true;
    try
    {
      if (_ffmpegDownloadOption)
      {
        _ffmpegDialogOpen = false;
        await Ffmpeg.StartAsync();
        if (!Ffmpeg.IsAvailable) { Toast.ShowError(FfmpegState.Message); }
        return;
      }
      var (ok, error) = await Ffmpeg.ApplyManualPathAsync(_ffmpegManualPath);
      if (ok)
      {
        _ffmpegDialogOpen = false;
        Toast.ShowSuccess(Language.Translate("FfmpegReady") + " " + FfmpegState.InstalledPath);
      }
      else
      {
        Toast.ShowError(Language.Translate("FfmpegUnavailable") + " " + (error ?? string.Empty));
      }
    }
    catch (Exception ex)
    {
      Toast.ShowError(Language.Translate("FfmpegUnavailable") + " " + ex.Message);
    }
    finally
    {
      _ffmpegApplying = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private void CancelFfmpegInstall() => Ffmpeg.Cancel();

  /// <summary>FFmpeg 状态变化：需要选择时自动弹窗；失败时顶部提示 + 打开弹窗（不阻断其它上传）。</summary>
  private void OnFfmpegChanged()
  {
    _ = InvokeAsync(() =>
    {
      var state = Ffmpeg.State;
      if (Ffmpeg.NeedsUserChoice && !_ffmpegDialogOpen && !state.IsBusy) { OpenFfmpegDialog(); }
      if (state.Phase == FfmpegInstallPhase.Failed && !string.IsNullOrWhiteSpace(state.Error) && state.Error != _ffmpegReportedError)
      {
        _ffmpegReportedError = state.Error;
        Toast.ShowError(Language.Translate("FfmpegUnavailable") + " " + state.Error);
        OpenFfmpegDialog();
      }
      StateHasChanged();
    });
  }

