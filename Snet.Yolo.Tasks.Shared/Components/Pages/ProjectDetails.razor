  private static string? TaskImage(AnnotationTask task) => task.Data?["image"]?.ToString();
  private string TaskHeadline(AnnotationTask task)
  {
    var img = TaskImage(task);
    if (!string.IsNullOrEmpty(img) && !img.StartsWith("data:", StringComparison.Ordinal))
    {
      var name = img.Split('/').Last();
      if (name.Length > 0) { return name; }
