  private const int PageSize = 20;
  private int _page = 1;
  private int FilteredCount => _project is null ? 0 : _project.Tasks.Count(t => string.IsNullOrWhiteSpace(_search) || MatchSearch(t, _search));
  private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)PageSize));
  private List<AnnotationTask> VisibleTasks
  {
    get
    {
      if (_page > TotalPages) { _page = TotalPages; }
      var filtered = _project is null
          ? new List<AnnotationTask>()
          : _project.Tasks.Where(t => string.IsNullOrWhiteSpace(_search) || MatchSearch(t, _search)).ToList();
      return filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }
  }
  private bool MatchSearch(AnnotationTask t, string q)
    => (TaskHeadline(t) + " " + (TaskImage(t) ?? "")).Contains(q, StringComparison.OrdinalIgnoreCase);
  private int LabeledCount => _project?.Tasks.Count(t => RegionCount(t) > 0) ?? 0;
  private int TotalRegions => _project?.Tasks.Sum(t => RegionCount(t)) ?? 0;
