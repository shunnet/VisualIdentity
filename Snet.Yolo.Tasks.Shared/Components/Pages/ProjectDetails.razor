  private void CancelDelete()
  {
    _deleteTarget = DeleteTarget.None; _deleteFolderName = _deleteImageFolder = null;
    _deleteImage = null; _deleteLabelControl = null; _deleteLabel = null; _deleteMessage = string.Empty;
  }

  private async Task ConfirmDeleteAsync()
  {
    var target = _deleteTarget;
    var taskIndex = _deleteTaskIndex;
    var folderName = _deleteFolderName;
    var imageFolder = _deleteImageFolder;
    var image = _deleteImage;
    var labelControl = _deleteLabelControl;
    var label = _deleteLabel;
    CancelDelete();
    switch (target)
    {
      case DeleteTarget.Task: await DeleteTaskCoreAsync(taskIndex); break;
      case DeleteTarget.Folder: if (folderName is not null) { await DeleteFolderCoreAsync(folderName); } break;
      case DeleteTarget.Image: if (imageFolder is not null && image is not null) { await RemoveImageCoreAsync(imageFolder, image); } break;
      case DeleteTarget.Label: if (labelControl is not null && label is not null) { labelControl.Labels.Remove(label); } break;
    }
  }
  private void OnLabelValueChange(LabelEdit label, Microsoft.AspNetCore.Components.ChangeEventArgs args)
  {
    var control = _labelEdits.FirstOrDefault(c => c.Labels.Contains(label));
    if (control is null) { return; }
    var newValue = args.Value?.ToString() ?? string.Empty;
    var isDup = !string.IsNullOrWhiteSpace(newValue) && control.Labels.Any(l => l != label && string.Equals(l.Value.Trim(), newValue.Trim(), StringComparison.OrdinalIgnoreCase));
    if (isDup) { label.ValueRenderKey = new object(); Toast.ShowWarning(Language.Translate("LabelNameDuplicate")); return; }
    label.Value = newValue;
  }
  /// <summary>应用用户选择的标签颜色，并阻止不同标签使用同一种颜色。</summary>
  private void OnColorChange(LabelEdit label, Microsoft.AspNetCore.Components.ChangeEventArgs args)
  {
    var color = ResolveHex(args.Value?.ToString());
    if (_labelEdits.SelectMany(edit => edit.Labels).Any(candidate => candidate != label && string.Equals(candidate.Color, color, StringComparison.OrdinalIgnoreCase)))
    {
      label.ColorRenderKey = new object();
      Toast.ShowWarning(Language.Translate("LabelColorDuplicate"));
      _ = InvokeAsync(StateHasChanged);
      return;
    }
    label.Color = color;
  }

  private async Task SaveLabelEditsAsync()
  {
    if (_project is null) { return; }
    EnsureUniqueLabelColors();
    foreach (var edit in _labelEdits)
    {
      var dup = edit.Labels.Where(l => !string.IsNullOrWhiteSpace(l.Value)).GroupBy(l => l.Value.Trim(), StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1);
      if (dup) { Toast.ShowError(Language.Translate("LabelNameDuplicate")); return; }
    }
    var config = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(_project.LabelConfigXml);
    var imageObject = config.Objects.FirstOrDefault(obj => obj.Kind == Snet.Yolo.Tasks.Core.Config.ObjectTagKind.Image);
    var root = new System.Xml.Linq.XElement("View");
    if (!string.IsNullOrWhiteSpace(config.YoloTask)) { root.SetAttributeValue("yoloTask", config.YoloTask); }
    root.Add(new System.Xml.Linq.XElement("Image",
      new System.Xml.Linq.XAttribute("name", imageObject?.Name ?? "image"),
      new System.Xml.Linq.XAttribute("value", imageObject?.ValueField ?? "$image")));
    foreach (var edit in _labelEdits)
    {
      var tag = TagNameFor(edit.Kind);
      var controlElement = new System.Xml.Linq.XElement(tag,
        new System.Xml.Linq.XAttribute("name", edit.Name),
        new System.Xml.Linq.XAttribute("toName", edit.ToName ?? "image"));
      foreach (var label in edit.Labels.Where(l => !string.IsNullOrWhiteSpace(l.Value)))
      {
        var optTag = edit.Kind is Snet.Yolo.Tasks.Core.Config.ControlTagKind.Choices or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Taxonomy or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Rating or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Relation ? "Choice" : "Label";
        controlElement.Add(new System.Xml.Linq.XElement(optTag,
          new System.Xml.Linq.XAttribute("value", label.Value.Trim()),
          new System.Xml.Linq.XAttribute("background", label.Color)));
      }
      root.Add(controlElement);
    }
    var xml = new System.Xml.Linq.XDocument(root).ToString();
    var parsed = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(xml);
    var validation = Snet.Yolo.Tasks.Core.Config.ConfigValidator.Validate(parsed);
    if (!validation.IsValid) { Toast.ShowError(Language.Translate("ConfigErrors")); return; }
    _project.LabelConfigXml = xml;
    await Workspaces.SaveProjectAsync(_project);
    _labelsEditorOpen = false;
    Toast.ShowSuccess(Language.Translate("ImportDone"));
  }

  private string ControlDisplayName(Snet.Yolo.Tasks.Core.Config.ControlTagKind kind) => Language.Translate(kind switch
  {
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.RectangleLabels => "ToolRectangle",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.PolygonLabels => "ToolPolygon",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.KeyPointLabels => "ToolKeyPoint",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.EllipseLabels => "ToolEllipse",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.BrushLabels => "ToolBrush",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Choices => "ToolRectangle",
    _ => "Labels",
  });
  private static string TagNameFor(Snet.Yolo.Tasks.Core.Config.ControlTagKind kind) => kind switch
  {
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.RectangleLabels => "RectangleLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.PolygonLabels => "PolygonLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.KeyPointLabels => "KeyPointLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.EllipseLabels => "EllipseLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.BrushLabels => "BrushLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Choices => "Choices",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Labels => "Labels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Taxonomy => "Taxonomy",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Rating => "Rating",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Relation => "Relation",
    _ => "RectangleLabels",
  };
  /// <summary>修复缺失或重复的标签颜色，确保整个项目中一个标签对应一种颜色。</summary>
  private void EnsureUniqueLabelColors()
  {
    var used = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var label in _labelEdits.SelectMany(edit => edit.Labels))
    {
      var color = ResolveHex(label.Color);
      if (!used.Add(color))
      {
        color = Snet.Yolo.Tasks.Core.Editing.LabelPalette.NextDistinctColor(used);
        used.Add(color);
      }
      label.Color = color;
    }
  }

  /// <summary>把颜色规范为 HTML 颜色输入支持的六位十六进制格式。</summary>
  private static string ResolveHex(string? color)
  {
    if (string.IsNullOrWhiteSpace(color)) { return Snet.Yolo.Tasks.Core.Editing.LabelPalette.ColorForIndex(0); }
    var value = color.Trim();
    if (value.Length == 4 && value[0] == '#' && value[1..].All(Uri.IsHexDigit))
    {
      return $"#{value[1]}{value[1]}{value[2]}{value[2]}{value[3]}{value[3]}".ToUpperInvariant();
    }
    if (value.Length == 7 && value[0] == '#' && value[1..].All(Uri.IsHexDigit)) { return value.ToUpperInvariant(); }
    return Snet.Yolo.Tasks.Core.Editing.LabelPalette.ColorForIndex(0);
  }

