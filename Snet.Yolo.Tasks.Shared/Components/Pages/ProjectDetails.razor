  private async Task LoadFolders()
  {
    _classFolders = new();
    if (_project is null) { return; }
    foreach (var task in _project.Tasks)
    {
      var cls = task.Data?["class"]?.ToString() ?? "未分类";
      var img = task.Data?["image"]?.ToString() ?? "";
      var f = _classFolders.FirstOrDefault(x => x.Name == cls);
      if (f is null) { f = new ClassFolder { Name = cls }; _classFolders.Add(f); }
      f.Items.Add(new ClassImage { DataUrl = img });
      f.Count = f.Items.Count;
      f.Thumbs.Add(img);
    }
    _classFolders = _classFolders.OrderByDescending(f => f.Count).ToList();
  }
