@page "/projects"
@attribute [Authorize]
@implements IAsyncDisposable
@using Snet.Yolo.Tasks.Services
@using Snet.Yolo.Tasks.Core.Config.Templates
@using Snet.Yolo.Tasks.Core.Models
@using Snet.Yolo.Tasks.Core.Training
@using Snet.Yolo.Tasks.Core.Workspace
@inject WorkspaceService Workspaces
@inject TrainingService Training
@inject CurrentUserContext CurrentUser
@inject NavigationManager Navigation
@inject LanguageManager Language

<AppPageTitle ResourceKey="Projects" />

<div class="ls-page-head">
    <h1 class="ls-page-title ls-page-title-with-icon"><i class="bi bi-collection" aria-hidden="true"></i><LangText Key="Projects" /></h1>
    <div class="ls-page-actions">
        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg"></i> <LangText Key="NewImageProject" />
        </button>
    </div>
</div>

@{ var types = ProjectTypeOptions; }
@if (_showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-folder-plus"></i><LangText Key="CreateProjectTitle" /></h5><button type="button" class="btn-close" @onclick="CloseCreateModal"></button></div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="ls-field-label"><LangText Key="AnnoType" /></label>
                        <div class="ls-type-grid" role="radiogroup" aria-label="@Language.Translate("AnnoType")">
                            @foreach (var t in types)
                            {
                                var isSel = _newProjectType == t.Value;
                                <button type="button" class="ls-type-card @(isSel ? "active" : null)" @onclick="() => _newProjectType = t.Value" role="radio" aria-checked="@isSel">
                                    @if (isSel) { <i class="bi bi-check-lg ls-type-check"></i> }
                                    <i class="bi @t.Icon"></i>
                                    <span>@Language.Translate(t.Key)</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="ls-field-label"><LangText Key="ProjectName" /></label>
                        <input class="form-control" autofocus value="@_newProjectName" @oninput="e => _newProjectName = e.Value?.ToString() ?? String.Empty" />
                    </div>
                    @if (!string.IsNullOrEmpty(_createErrorKey))
                    {
                        <div class="ls-error"><i class="bi bi-exclamation-triangle me-1"></i>@Language.Translate(_createErrorKey)</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateModal"><i class="bi bi-x-lg"></i> <LangText Key="Cancel" /></button>
                    <button type="button" class="btn btn-primary" @onclick="CreateImageProjectAsync"><i class="bi bi-plus-lg"></i> <LangText Key="Create" /></button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_busy)
{
    <div class="spinner-border spinner-border-sm text-secondary"></div>
}
else if (_projects.Count == 0)
{
    <div class="ls-card text-center py-5">
        <i class="bi bi-archive fs-1 d-block mb-3" style="color: var(--ls-muted)"></i>
        <h2 class="h5"><LangText Key="NoProjectsTitle" /></h2>
        <p class="ls-hint mx-auto" style="max-width: 460px"><LangText Key="NoProjectsHint" /></p>
        <button type="button" class="btn btn-primary btn-sm mt-3" @onclick="OpenCreateModal"><i class="bi bi-plus-lg"></i> <LangText Key="NewImageProject" /></button>
    </div>
}
else
{
    <div class="ls-proj-grid">
        @foreach (var project in _projects)
        {
            var cover = CoverUrl(project);
            var t = ProjTypeInfo(project);
            <div class="ls-proj-card" role="button" tabindex="0" @onclick="() => OpenProjectAsync(project.Id)" @onkeydown="e => OnCardEnter(e, project.Id)">
                <div class="ls-proj-cover" style="@(cover is null ? null : "background-image:url('" + cover + "')")">
                    @if (cover is null)
                    {
                        <i class="bi @t.Icon ls-proj-cover-icon"></i>
                    }
                    <span class="ls-proj-type"><i class="bi @t.Icon"></i>@Language.Translate(t.Key)</span>
                    <span class="ls-proj-actions" @onclick:stopPropagation="true">
                        <button type="button" class="btn btn-icon-sm" title="@Language.Translate("TrainProject")" @onclick="() => OpenTrainAsync(project.Id)"><i class="bi bi-cpu"></i></button>
                        <button type="button" class="btn btn-icon-sm btn-outline-danger" title="@Language.Translate("Delete")" @onclick="() => DeleteProjectAsync(project.Id)"><i class="bi bi-trash"></i></button>
                    </span>
                </div>
                <div class="ls-proj-body">
                    <div class="ls-proj-name">@project.Name</div>
                    <div class="ls-proj-meta">
                        <span><i class="bi bi-images"></i> @project.Tasks.Count <LangText Key="TaskCount" /></span>
                        <span class="ls-proj-dot"></span>
                        <span><i class="bi bi-clock-history"></i> @project.UpdatedAt.ToLocalTime().ToString("g")</span>
                    </div>
                </div>
                @if (IsTraining(project.Id, out var st))
                {
                    <div class="ls-proj-foot">
                        <div class="d-flex justify-content-between small text-secondary mb-1">
                            <span><i class="bi bi-cpu"></i> <LangText Key="Training" /></span><span>@st!.Percent%</span>
                        </div>
                        <div class="progress ls-progress ls-progress-sm"><div class="progress-bar" style="width:@st.Percent%"></div></div>
                    </div>
                }
            </div>
        }
    </div>
}

<ConfirmDialog IsOpen="@(_confirmProjectId is not null)"
               Title="@Language.Translate("Delete")"
               Message="@($"{Language.Translate("ConfirmDeleteProject")}\n{_confirmProjectName}")"
               Confirmed="ConfirmDeleteProjectAsync"
               Cancelled="CancelDeleteProject" />

@code {
    private readonly List<WorkspaceProject> _projects = new();
    private string _owner = string.Empty;
    private bool _busy = true;
    private string? _confirmProjectId;
    private string _confirmProjectName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;
        _owner = await CurrentUser.GetRequiredUserNameAsync();
        await RefreshAsync();
        // 训练卡片进度实时刷新（IsTraining 渲染时读取全局训练状态，仅需周期触发重渲染）
        _trainingPollTask = PollTrainingCardsAsync(_disposeCancellation.Token);
    }

    private readonly CancellationTokenSource _disposeCancellation = new();
    private Task? _trainingPollTask;

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Language.LanguageChanged -= OnLanguageChanged;
        await _disposeCancellation.CancelAsync();
        if (_trainingPollTask is not null)
        {
            try { await _trainingPollTask; }
            catch (OperationCanceledException) { }
        }
        _disposeCancellation.Dispose();
    }

    private async Task PollTrainingCardsAsync(CancellationToken cancellationToken)
    {
        var previous = TrainingFingerprint();
        while (true)
        {
            await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
            var current = TrainingFingerprint();
            if (current != previous) { await InvokeAsync(StateHasChanged); }
            previous = current;
        }
    }

    private string TrainingFingerprint()
    {
        var states = _projects.Select(project => Training.GetStatus(_owner, project.Id, includeLogs: false)).ToList();
        return string.Join('|', states.Select(status => status is null ? "-" : $"{status.Phase}:{status.Percent}"));
    }

    private void OpenProjectAsync(string projectId) => Navigation.NavigateTo($"/project/{projectId}");
    private void OpenTrainAsync(string projectId) => Navigation.NavigateTo($"/train/{projectId}");
    private Task OnCardEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, string projectId)
    {
        if (e.Key == "Enter" || e.Code == "Enter" || e.Key == "NumpadEnter")
        {
            Navigation.NavigateTo($"/project/{projectId}");
        }
        return Task.CompletedTask;
    }
    private bool IsTraining(string id, out TrainingStatus? st) { st = Training.GetStatus(_owner, id, includeLogs: false); return st is { IsActive: true }; }

    private static string? CoverUrl(WorkspaceProject p)
    {
        var img = p.Tasks.FirstOrDefault()?.Data?["image"]?.ToString();
        return string.IsNullOrWhiteSpace(img) ? null : img;
    }
    private static (string Icon, string Key) ProjTypeInfo(WorkspaceProject p)
    {
        var xml = p.LabelConfigXml ?? "";
        try
        {
            if (xml.Contains("KeyPointLabels", StringComparison.Ordinal)) { return ("bi-dot", "YoloPose"); }
            if (xml.Contains("EllipseLabels", StringComparison.Ordinal)) { return ("bi-record-circle", "YoloObb"); }
            if (xml.Contains("PolygonLabels", StringComparison.Ordinal)) { return ("bi-vector-pen", "YoloSegment"); }
            if (xml.Contains("Choices", StringComparison.Ordinal)) { return ("bi-tags", "YoloClassify"); }
            if (xml.Contains("RectangleLabels", StringComparison.Ordinal)) { return ("bi-bounding-box", "YoloDetect"); }
        }
        catch { /* 配置不可解析时回退为检测 */ }
        return ("bi-image", "YoloDetect");
    }

    private async Task RefreshAsync()
    {
        _projects.Clear();
        _projects.AddRange(await Workspaces.ListProjectsAsync());
        _busy = false;
    }

    private bool _showCreateModal;
    private string _newProjectName = string.Empty;
    private string _newProjectType = "detect";
    private string _createErrorKey = string.Empty;

    /* 工程类型模板（图标卡片选择器） */
    private static readonly (string Value, string Icon, string Key)[] ProjectTypeOptions = new[]
    {
        ("detect", "bi-bounding-box", "YoloDetect"),
        ("segment", "bi-vector-pen", "YoloSegment"),
        ("classify", "bi-tags", "YoloClassify"),
        ("pose", "bi-dot", "YoloPose"),
        ("obb", "bi-record-circle", "YoloObb"),
    };

    private void OpenCreateModal()
    {
        _newProjectName = "Image";
        _createErrorKey = string.Empty;
        _showCreateModal = true;
    }

    private void CloseCreateModal() => _showCreateModal = false;

    private static string ConfigFor(string type)
        => YoloTaskRegistry.ConfigFor(type switch
        {
            "segment" => YoloTaskType.Segment,
            "classify" => YoloTaskType.Classify,
            "pose" => YoloTaskType.Pose,
            "obb" => YoloTaskType.Obb,
            _ => YoloTaskType.Detect,
        });

    private const string EmptyLabelsConfig = "<View>\n  <Image name=\"image\" value=\"$image\" zoom=\"true\"/>\n  <RectangleLabels name=\"rect\" toName=\"image\"></RectangleLabels>\n  <PolygonLabels name=\"poly\" toName=\"image\"></PolygonLabels>\n  <KeyPointLabels name=\"kp\" toName=\"image\"></KeyPointLabels>\n  <EllipseLabels name=\"ell\" toName=\"image\"></EllipseLabels>\n  <BrushLabels name=\"brush\" toName=\"image\"></BrushLabels>\n</View>\n";

    private async Task CreateImageProjectAsync()
    {
        var name = _newProjectName.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _createErrorKey = "NameRequired";
            return;
        }
        var existing = await Workspaces.ListProjectsAsync();
        if (existing.Any(p => string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _createErrorKey = "NameDuplicate";
            return;
        }

        _busy = true;
        var project = new WorkspaceProject
        {
            Name = name,
            LabelConfigXml = ConfigFor(_newProjectType),
        };
        await Workspaces.SaveProjectAsync(project);
        await RefreshAsync();
        _showCreateModal = false;
        Navigation.NavigateTo($"/project/{project.Id}");
    }
    private async Task DeleteProjectAsync(string projectId)
    {
        var project = _projects.FirstOrDefault(item => item.Id == projectId);
        _confirmProjectId = projectId;
        _confirmProjectName = project?.Name ?? string.Empty;
    }
    private void CancelDeleteProject() { _confirmProjectId = null; _confirmProjectName = string.Empty; }
    private async Task ConfirmDeleteProjectAsync()
    {
        var projectId = _confirmProjectId;
        CancelDeleteProject();
        if (string.IsNullOrEmpty(projectId)) { return; }
        await Workspaces.DeleteProjectAsync(projectId);
        await RefreshAsync();
    }
}
