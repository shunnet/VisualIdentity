@page "/joint-validation"
@attribute [Authorize]
@implements IAsyncDisposable
@using Snet.Yolo.Server.anomalib
@using Snet.Yolo.Server.models.data
@using Snet.Yolo.Tasks.Services
@inject CurrentUserContext CurrentUser
@inject JointValidationService JointService
@inject LanguageManager Language
@inject IJSRuntime JS
@inject JointValidationState ValidationState

<PageTitle>@Language.Translate("JointValidation")</PageTitle>

<div class="ls-refined-page ls-joint-page">
    <div class="ls-page-head">
        <div class="ls-page-lead"><h1 class="ls-page-title ls-page-title-with-icon"><i class="bi bi-intersect" aria-hidden="true"></i>@Language.Translate("JointValidation")</h1><span class="ls-joint-title-separator" aria-hidden="true">·</span><span class="ls-joint-subtitle">@Language.Translate("JointValidationSubtitle")</span></div>
    </div>

    <div class="ls-joint-grid">
        <aside class="ls-card ls-joint-models">
            <div class="ls-card-head"><h2 class="ls-h3"><i class="bi bi-sliders" aria-hidden="true"></i>@Language.Translate("JointModelSettings")</h2><button type="button" class="btn btn-icon-sm btn-outline-secondary" @onclick="RefreshModelsAsync" disabled="@_busy" title="@Language.Translate("JointRefreshModels")" aria-label="@Language.Translate("JointRefreshModels")"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button></div>
            <div class="ls-joint-model-scroll">
            <div class="ls-joint-model-field">
                <label for="joint-anomalib-model"><i class="bi bi-bounding-box-circles" aria-hidden="true"></i>@Language.Translate("JointAnomalibModel")</label>
                <select id="joint-anomalib-model" class="form-select" @bind="_selectedAnomalibKey" @bind:after="ClearResult" disabled="@_busy">
                    @if (_anomalibModels.Count == 0) { <option value="">@Language.Translate("JointNoAnomalibModels")</option> }
                    @foreach (var model in _anomalibModels) { <option value="@ModelKey(model)">@model.Name · @AnomalibModelCatalog.Get(model.Model).DisplayName</option> }
                </select>
                <div class="ls-hint">@Language.Translate("JointAnomalibHint")</div>
                @if (!string.IsNullOrEmpty(_selectedAnomalibKey))
                {
                    <div class="ls-joint-parameters">
                        <label for="joint-pixel-threshold">@Language.Translate("AnomalibPixelThreshold")</label>
                        <input id="joint-pixel-threshold" type="number" class="form-control form-control-sm" min="0" max="1" step="0.01" @bind="_pixelThreshold" @bind:after="OnAnomalibParametersChanged" disabled="@_busy" />
                        <div class="ls-anomalib-area-label"><label for="joint-minimum-area">@Language.Translate("AnomalibMinimumArea")</label><small id="joint-area-hint">@Language.Translate("AnomalibRegionFilterHint")</small></div>
                        <input id="joint-minimum-area" type="number" class="form-control form-control-sm" min="1" max="16777216" step="1" aria-describedby="joint-area-hint" @bind="_minimumArea" @bind:after="OnAnomalibParametersChanged" disabled="@_busy" />
                    </div>
                }
            </div>
            <div class="ls-joint-model-field">
                <label for="joint-yolo-model"><i class="bi bi-box" aria-hidden="true"></i>@Language.Translate("JointYoloModel")</label>
                <select id="joint-yolo-model" class="form-select" @bind="_selectedYoloIndex" @bind:after="OnYoloModelChanged" disabled="@_busy">
                    @if (_yoloModels.Count == 0) { <option value="">@Language.Translate("JointNoYoloModels")</option> }
                    @foreach (var model in _yoloModels) { <option value="@model.index">@(string.IsNullOrWhiteSpace(model.describe) ? model.name : model.describe) · @YoloType(model)</option> }
                </select>
                <div class="ls-hint">@Language.Translate("JointYoloHint")</div>
                @if (!string.IsNullOrEmpty(_selectedYoloIndex))
                {
                    <div class="ls-joint-parameters">
                        @foreach (var parameter in _yoloParameters)
                        {
                            <label for="@($"joint-yolo-{parameter.Key}")">@ParameterLabel(parameter.Key)</label>
                            <input id="@($"joint-yolo-{parameter.Key}")" type="number" class="form-control form-control-sm" min="0" max="1" step="0.01" value="@parameter.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="e => SetYoloParameter(parameter.Key, e)" disabled="@_busy" />
                        }
                    </div>
                }
            </div>
            @if (_anomalibModels.Count == 0 || _yoloModels.Count == 0) { <div class="ls-joint-model-note">@Language.Translate("JointModelMissingHint")</div> }
            </div>
        </aside>

        <main class="ls-card ls-joint-preview-card">
            <div class="ls-card-head"><h2 class="ls-h3"><i class="bi bi-image" aria-hidden="true"></i>@Language.Translate("JointPreview")</h2></div>
            <div class="ls-joint-actions">
                <InputFile id="joint-validation-image" class="visually-hidden" OnChange="UploadAsync" accept="image/jpeg,image/png,image/webp,image/bmp,image/gif" disabled="@_busy" aria-label="@Language.Translate("UploadFile")" />
                <label for="joint-validation-image" class="btn btn-outline-secondary btn-sm @(_busy ? "disabled" : null)" aria-disabled="@_busy"><i class="bi bi-upload" aria-hidden="true"></i>@Language.Translate("JointUploadImage")</label>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => IdentifyAsync(JointValidationMode.Joint)" disabled="@(_busy || _imagePath is null || string.IsNullOrEmpty(_selectedAnomalibKey) || string.IsNullOrEmpty(_selectedYoloIndex))"><i class="bi bi-play-fill" aria-hidden="true"></i>@Language.Translate("JointIdentify")</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => IdentifyAsync(JointValidationMode.AnomalibOnly)" disabled="@(_busy || _imagePath is null || string.IsNullOrEmpty(_selectedAnomalibKey))"><i class="bi bi-bounding-box-circles" aria-hidden="true"></i>@Language.Translate("JointAnomalibOnly")</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => IdentifyAsync(JointValidationMode.YoloOnly)" disabled="@(_busy || _imagePath is null || string.IsNullOrEmpty(_selectedYoloIndex))"><i class="bi bi-box" aria-hidden="true"></i>@Language.Translate("JointYoloOnly")</button>
            </div>
            <div class="ls-joint-image-stage">
                @if (_imageUrl is null) { <div class="ls-joint-empty"><i class="bi bi-images" aria-hidden="true"></i><span>@Language.Translate("JointUploadPrompt")</span></div> }
                else
                {
                    <div class="ls-joint-image-wrap">
                        <img src="@_imageUrl" alt="@_imageName" />
                        @if (_output is not null)
                        {
                            <svg viewBox="@($"0 0 {_imageWidth} {_imageHeight}")" preserveAspectRatio="none" aria-label="@Language.Translate("JointAnnotations")">
                                @foreach (var match in _output.Matches.Regions)
                                {
                                    <rect x="@match.Region.Bounds.X" y="@match.Region.Bounds.Y" width="@match.Region.Bounds.Width" height="@match.Region.Bounds.Height" class="ls-joint-anomaly-box" />
                                    @foreach (var detection in match.Detections) { <rect x="@detection.Bounds.X" y="@detection.Bounds.Y" width="@detection.Bounds.Width" height="@detection.Bounds.Height" class="ls-joint-yolo-box" /> }
                                }
                                @foreach (var detection in _output.Matches.UnmatchedDetections) { <rect x="@detection.Bounds.X" y="@detection.Bounds.Y" width="@detection.Bounds.Width" height="@detection.Bounds.Height" class="@(_output.Mode == JointValidationMode.Joint ? "ls-joint-yolo-box ls-joint-yolo-outside" : "ls-joint-yolo-box")" /> }
                            </svg>
                        }
                    </div>
                }
            </div>
            @if (_imageName is not null) { <div class="ls-joint-image-name"><i class="bi bi-file-image" aria-hidden="true"></i>@_imageName</div> }
        </main>

        <aside class="ls-card ls-joint-results">
            <div class="ls-card-head"><h2 class="ls-h3"><i class="bi bi-bullseye" aria-hidden="true"></i>@Language.Translate("JointResults")</h2></div>
            @if (_output is null) { <div class="ls-joint-result-empty">@Language.Translate("JointResultsPrompt")</div> }
            else
            {
                <div class="ls-joint-stats">
                    <div><span>@Language.Translate("JointAnomalyCount")</span><strong>@(_output.Mode == JointValidationMode.YoloOnly ? "—" : _output.Matches.Regions.Count.ToString())</strong></div>
                    <div><span>@Language.Translate("JointKnownCount")</span><strong>@(_output.Mode == JointValidationMode.AnomalibOnly ? "—" : _output.Mode == JointValidationMode.YoloOnly ? _output.Matches.UnmatchedDetections.Count.ToString() : _output.Matches.Regions.Count(item => item.Detections.Count > 0).ToString())</strong></div>
                    <div><span>@Language.Translate("JointUnknownCount")</span><strong>@(_output.Mode != JointValidationMode.Joint ? "—" : _output.Matches.Regions.Count(item => item.Detections.Count == 0).ToString())</strong></div>
                </div>
                <div class="ls-joint-section-title">@Language.Translate(_output.Mode == JointValidationMode.YoloOnly ? "JointYoloDetails" : "JointRegionDetails")</div>
                <div class="ls-joint-region-list">
                    @if (_output.Mode == JointValidationMode.YoloOnly)
                    {
                        @if (_output.Matches.UnmatchedDetections.Count == 0) { <div class="ls-joint-normal">@Language.Translate("JointYoloNoDetections")</div> }
                        @foreach (var detection in _output.Matches.UnmatchedDetections) { <div class="ls-joint-region"><span class="ls-joint-known">@detection.Name · @detection.Confidence.ToString("P0")</span></div> }
                    }
                    else if (_output.Anomalib is { Result.IsAnomalous: false }) { <div class="ls-joint-normal"><i class="bi bi-check-circle" aria-hidden="true"></i>@Language.Translate("JointNormal")</div> }
                    else if (_output.Matches.Regions.Count == 0) { <div class="ls-joint-unknown">@Language.Translate("JointAnomalyNoRegion")</div> }
                    @foreach (var match in _output.Matches.Regions)
                    {
                        <div class="ls-joint-region">
                            <span class="badge text-bg-danger">@Language.Translate("JointRegion") @match.Region.RegionId</span>
                            @if (match.Detections.Count == 0) { <span class="ls-joint-unknown">@Language.Translate(_output.Mode == JointValidationMode.AnomalibOnly ? "JointUnclassified" : "JointUnknown")</span> }
                            else { @foreach (var detection in match.Detections) { <span class="ls-joint-known">@detection.Name · @detection.Confidence.ToString("P0")</span> } }
                        </div>
                    }
                    @if (_output.Mode == JointValidationMode.Joint && _output.Matches.UnmatchedDetections.Count > 0) { <div class="ls-joint-outside">@Language.Translate("JointOutsideAnomalies"): @string.Join(", ", _output.Matches.UnmatchedDetections.Select(item => item.Name))</div> }
                </div>
                @if (_output.Anomalib is not null) { <div class="ls-joint-section-title">@Language.Translate("AnomalibHeatmap")</div><div class="ls-joint-heatmap"><img src="@_output.Anomalib.HeatmapDataUrl" alt="@Language.Translate("AnomalibHeatmapAlt")" /></div> }
            }
        </aside>
    </div>

    <section class="ls-card ls-joint-flow">
        <div class="ls-card-head">
            <h2 class="ls-h3"><i class="bi bi-diagram-3" aria-hidden="true"></i>@Language.Translate("JointFlow")</h2>
            @if (_output is not null) { <span class="ls-joint-flow-mode">@Language.Translate(ModeResourceKey(_output.Mode))</span> }
        </div>
        <div class="ls-joint-flow-body">
            <div class="ls-joint-stage @AnomalibStageClass()">
                <span class="ls-joint-stage-step" aria-hidden="true">1</span>
                <span class="ls-joint-stage-main"><strong>@Language.Translate("JointStageAnomalib")</strong><small>@Language.Translate("JointStageAnomalibNote")</small></span>
                <span class="ls-joint-stage-value">@AnomalibStageValue()</span>
            </div>
            <span class="ls-joint-stage-link @(AnomalibStageFinished ? "is-active" : null)" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
            <div class="ls-joint-stage @YoloStageClass()">
                <span class="ls-joint-stage-step" aria-hidden="true">2</span>
                <span class="ls-joint-stage-main"><strong>@Language.Translate("JointStageYolo")</strong><small>@Language.Translate("JointStageYoloNote")</small></span>
                <span class="ls-joint-stage-value">@YoloStageValue()</span>
            </div>
            <span class="ls-joint-stage-link @(YoloStageFinished ? "is-active" : null)" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
            <div class="ls-joint-stage @ResultStageClass()">
                <span class="ls-joint-stage-step" aria-hidden="true">3</span>
                <span class="ls-joint-stage-main"><strong>@Language.Translate("JointStageResult")</strong><small>@Language.Translate("JointStageResultNote")</small></span>
                <span class="ls-joint-stage-value">@ResultStageValue()</span>
            </div>
            <div class="ls-joint-flow-total">
                <span>@Language.Translate("JointTotalTime")</span>
                @if (_output is null) { <strong class="ls-joint-flow-idle">@Language.Translate("JointNotRunYet")</strong> }
                else { <strong>@TotalTimeNumber()<small>@(TotalInSeconds ? "s" : "ms")</small></strong> }
            </div>
        </div>
    </section>
    <section class="ls-card ls-workspace-card ls-joint-log-card" aria-label="@Language.Translate("JointLogTitle")">
        <div class="ls-card-head"><h2 class="ls-h3"><i class="bi bi-terminal" aria-hidden="true"></i>@Language.Translate("JointLogTitle")</h2><button type="button" class="ls-icon-btn" title="@Language.Translate("JointCopyLogs")" aria-label="@Language.Translate("JointCopyLogs")" @onclick="CopyLogsAsync" disabled="@(_logs.Count == 0)"><i class="bi bi-clipboard" aria-hidden="true"></i></button></div>
        <div class="ls-joint-log" role="log" aria-live="polite">@if (_logs.Count == 0) { <div class="ls-joint-log-empty">@Language.Translate("JointLogEmpty")</div> }@foreach (var entry in _logs.AsEnumerable().Reverse()) { <div>@entry</div> }</div>
    </section>
    @if (_busy) { <div class="ls-joint-message" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>@Language.Translate("JointProcessing")</div> }
    @if (_error is not null) { <div class="alert alert-danger mt-2" role="alert">@_error</div> }
</div>

@code {
    private string _owner = string.Empty;
    private IReadOnlyList<RegisteredAnomalibModel> _anomalibModels = [];
    private IReadOnlyList<OnnxData> _yoloModels = [];
    private string _selectedAnomalibKey = string.Empty;
    private string _selectedYoloIndex = string.Empty;
    private Dictionary<string, double> _yoloParameters = new();
    private float _pixelThreshold = 0.8f;
    private int _minimumArea = 4;
    private string? _imagePath;
    private string? _imageUrl;
    private string? _imageName;
    private int _imageWidth;
    private int _imageHeight;
    private JointValidationOutput? _output;
    /// <summary>当前正在执行的推理阶段；「处理流程与耗时」卡片用它点亮对应步骤。</summary>
    private JointValidationStage? _currentStage;
    private string? _error;
    private bool _busy;
    private bool _disposed;
    private Task? _identifyTask;
    private readonly CancellationTokenSource _cancellation = new();
    private readonly List<string> _logs = [];
    private IJSObjectReference? _logJs;

    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;
        _owner = await CurrentUser.GetRequiredUserNameAsync();
        var saved = ValidationState.Get(_owner);
        _selectedAnomalibKey = saved.AnomalibModelKey;
        _selectedYoloIndex = saved.YoloModelIndex;
        _yoloParameters = saved.YoloParameters.ToDictionary(pair => pair.Key, pair => pair.Value);
        _pixelThreshold = saved.PixelThreshold;
        _minimumArea = saved.MinimumArea;
        _logs.AddRange(saved.Logs);
        if (saved.ImagePath is not null && File.Exists(saved.ImagePath))
        {
            _imagePath = saved.ImagePath;
            _imageUrl = saved.ImageUrl;
            _imageName = saved.ImageName;
            _imageWidth = saved.Width;
            _imageHeight = saved.Height;
            _output = saved.Output;
            _error = saved.Error;
        }
        await RefreshModelsAsync();
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    private static string ModelKey(RegisteredAnomalibModel model) => model.ProjectId + "/" + model.RunId;
    private string YoloType(OnnxData model) => Language.Translate(model.onnxType == global::Snet.Yolo.Server.models.@enum.OnnxType.Segmentation ? "JointSegmentationType" : "JointDetectionType");
    private void ClearResult() { _output = null; _error = null; PersistState(); }

    private async Task RefreshModelsAsync()
    {
        if (_busy) { return; }
        var previousAnomalib = _selectedAnomalibKey;
        var previousYolo = _selectedYoloIndex;
        var models = await JointService.ListModelsAsync(_owner);
        _anomalibModels = models.Anomalib.OrderByDescending(model => model.RegisteredAtUtc).ToArray();
        _yoloModels = models.Yolo.OrderByDescending(model => model.updateTime).ToArray();
        if (!_anomalibModels.Any(model => ModelKey(model) == _selectedAnomalibKey)) { _selectedAnomalibKey = _anomalibModels.Count == 0 ? string.Empty : ModelKey(_anomalibModels[0]); }
        if (!_yoloModels.Any(model => model.index.ToString() == _selectedYoloIndex)) { _selectedYoloIndex = _yoloModels.Count == 0 ? string.Empty : _yoloModels[0].index.ToString(); }
        if (previousYolo != _selectedYoloIndex || _yoloParameters.Count == 0) { LoadYoloParameters(); }
        if (previousAnomalib != _selectedAnomalibKey || previousYolo != _selectedYoloIndex) { ClearResult(); }
        AddLog(string.Format(Language.Translate("JointModelsLoaded"), _anomalibModels.Count, _yoloModels.Count));
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        if (_busy) { return; }
        _busy = true;
        _error = null;
        string? destination = null;
        try
        {
            var file = args.File;
            var extension = UploadedFileValidator.GetExtension(file.Name, allowVideo: false);
            if (file.Size is <= 0 or > UploadedFileValidator.MaximumImageFileBytes) { throw new InvalidDataException(Language.Translate("JointInvalidImageSize")); }
            var ownerSegment = UserStoragePath.Segment(_owner);
            var root = Path.Combine(AppContext.BaseDirectory, "wwwroot", "data", "uploads", ownerSegment, "joint-validation");
            Directory.CreateDirectory(root);
            var name = Guid.NewGuid().ToString("N") + extension;
            destination = Path.Combine(root, name);
            await using (var source = file.OpenReadStream(UploadedFileValidator.MaximumImageFileBytes))
            await using (var target = new FileStream(destination, FileMode.CreateNew, FileAccess.Write, FileShare.None, 1024 * 1024, FileOptions.Asynchronous))
            {
                await source.CopyToAsync(target, _cancellation.Token);
            }
            (_imageWidth, _imageHeight) = UploadedFileValidator.ValidateImageAndGetDimensions(destination);
            _cancellation.Token.ThrowIfCancellationRequested();
            DeleteImage();
            _imagePath = destination;
            _imageUrl = $"/uploads/{ownerSegment}/joint-validation/{name}";
            _imageName = Path.GetFileName(file.Name);
            destination = null;
            ClearResult();
            AddLog(string.Format(Language.Translate("JointImageUploaded"), _imageName, _imageWidth, _imageHeight));
        }
        catch (Exception error) { _error = error.Message; AddLog(error.ToString()); }
        finally { if (destination is not null && File.Exists(destination)) { File.Delete(destination); } _busy = false; }
    }

    private async Task IdentifyAsync(JointValidationMode mode)
    {
        if (_busy || _imagePath is null) { return; }
        var model = _anomalibModels.FirstOrDefault(item => ModelKey(item) == _selectedAnomalibKey);
        if (mode != JointValidationMode.YoloOnly && model is null) { return; }
        _busy = true;
        ClearResult();
        AddLog(string.Format(Language.Translate("JointRunStarted"), Language.Translate(mode switch { JointValidationMode.AnomalibOnly => "JointAnomalibOnly", JointValidationMode.YoloOnly => "JointYoloOnly", _ => "JointIdentify" }), _imageName));
        if (mode != JointValidationMode.YoloOnly) { AddLog($"Anomalib: {model!.Name} ({model.Model})"); }
        if (mode != JointValidationMode.AnomalibOnly) { AddLog($"YOLO: {_yoloModels.FirstOrDefault(item => item.index.ToString() == _selectedYoloIndex)?.name ?? _selectedYoloIndex}"); }
        if (mode != JointValidationMode.YoloOnly) { AddLog($"Anomalib: PixelThreshold={_pixelThreshold}, MinimumArea={_minimumArea}"); }
        if (mode != JointValidationMode.AnomalibOnly) { AddLog("YOLO: " + System.Text.Json.JsonSerializer.Serialize(_yoloParameters)); }
        _identifyTask = RunAsync(model, mode);
        try { await _identifyTask; }
        finally { _identifyTask = null; _busy = false; _currentStage = null; }
    }

    private async Task RunAsync(RegisteredAnomalibModel? model, JointValidationMode mode)
    {
        try
        {
            _output = await JointService.IdentifyAsync(_owner, model?.ProjectId, model?.RunId,
                mode == JointValidationMode.AnomalibOnly ? null : int.Parse(_selectedYoloIndex), _imagePath!, mode, OnStage, _cancellation.Token,
                new AnomalibInferenceOptions { PixelThreshold = _pixelThreshold, MinimumArea = _minimumArea },
                System.Text.Json.JsonSerializer.Serialize(_yoloParameters));
            if (_output.Anomalib is { } anomalib)
            {
                AddLog(string.Format(Language.Translate("JointLogAnomalibSummary"), anomalib.Result.IsAnomalous, anomalib.Result.ImageScore, anomalib.Result.Regions.Count, anomalib.Result.InferenceMilliseconds));
            }
            foreach (var match in _output.Matches.Regions)
            {
                AddLog(string.Format(Language.Translate("JointLogRegionSummary"), match.Region.RegionId,
                    match.Region.Bounds.X, match.Region.Bounds.Y, match.Region.Bounds.Width, match.Region.Bounds.Height,
                    match.Detections.Count == 0 ? Language.Translate(mode == JointValidationMode.AnomalibOnly ? "JointUnclassified" : "JointUnknown") : string.Join(", ", match.Detections.Select(item => $"{item.Name} {item.Confidence:P0}"))));
            }
            foreach (var detection in _output.Matches.UnmatchedDetections)
            {
                AddLog(string.Format(Language.Translate(mode == JointValidationMode.YoloOnly ? "JointLogYoloDetection" : "JointLogOutsideDetection"),
                    detection.Name, detection.Confidence, detection.Bounds.X, detection.Bounds.Y, detection.Bounds.Width, detection.Bounds.Height));
            }
            if (mode == JointValidationMode.YoloOnly)
            {
                AddLog(string.Format(Language.Translate("JointYoloOnlyCompleted"), _output.Matches.UnmatchedDetections.Count, _output.YoloMilliseconds));
            }
            else
            {
                AddLog(string.Format(Language.Translate("JointRunCompleted"), _output.Matches.Regions.Count,
                    _output.Matches.Regions.Count(item => item.Detections.Count > 0),
                    _output.Matches.UnmatchedDetections.Count,
                    (_output.Anomalib?.Result.InferenceMilliseconds ?? 0) + _output.YoloMilliseconds));
            }
        }
        catch (OperationCanceledException) { AddLog(Language.Translate("JointRunCancelled")); }
        catch (Exception error) { _error = error.Message; AddLog(error.ToString()); }
    }

    private void OnStage(JointValidationStage stage)
    {
        _currentStage = stage;
        AddLog(Language.Translate(stage switch
        {
            JointValidationStage.AnomalibStarted => "JointLogAnomalibStarted",
            JointValidationStage.AnomalibCompleted => "JointLogAnomalibCompleted",
            JointValidationStage.YoloStarted => "JointLogYoloStarted",
            JointValidationStage.YoloCompleted => "JointLogYoloCompleted",
            _ => "JointLogYoloSkipped",
        }));
        _ = InvokeAsync(StateHasChanged);
    }

    // ── 处理流程与耗时卡片：每一步的状态、耗时与结果规模 ──────────────
    // 三个步骤共用一套判断：跳过（本次模式用不到）> 已完成 > 正在执行 > 待运行。
    private static string ModeResourceKey(JointValidationMode mode) => mode switch
    {
        JointValidationMode.AnomalibOnly => "JointAnomalibOnly",
        JointValidationMode.YoloOnly => "JointYoloOnly",
        _ => "JointIdentify",
    };

    private bool AnomalibStageFinished => _output is not null && _output.Mode != JointValidationMode.YoloOnly;
    private bool YoloStageFinished => _output is not null;

    private string AnomalibStageClass()
    {
        if (_output?.Mode == JointValidationMode.YoloOnly) { return "is-skipped"; }
        if (_output is not null) { return "is-done"; }
        return _currentStage == JointValidationStage.AnomalibStarted ? "is-running" : string.Empty;
    }

    private string YoloStageClass()
    {
        if (_output is { YoloExecuted: false }) { return "is-skipped"; }
        if (_output is not null) { return "is-done"; }
        return _currentStage is JointValidationStage.AnomalibCompleted or JointValidationStage.YoloStarted ? "is-running" : string.Empty;
    }

    private string ResultStageClass()
    {
        if (_output is not null) { return "is-done"; }
        return _currentStage is JointValidationStage.YoloCompleted or JointValidationStage.YoloSkippedNormal ? "is-running" : string.Empty;
    }

    private string AnomalibStageValue()
    {
        if (_output?.Mode == JointValidationMode.YoloOnly) { return Language.Translate("JointStageSkipped"); }
        if (_output is not null) { return FormatMilliseconds(_output.Anomalib?.Result.InferenceMilliseconds ?? 0); }
        return Language.Translate(_currentStage == JointValidationStage.AnomalibStarted ? "JointStageRunning" : "JointStagePending");
    }

    private string YoloStageValue()
    {
        if (_output is { YoloExecuted: false }) { return Language.Translate("JointStageSkipped"); }
        if (_output is not null) { return FormatMilliseconds(_output.YoloMilliseconds); }
        return Language.Translate(_currentStage is JointValidationStage.AnomalibCompleted or JointValidationStage.YoloStarted ? "JointStageRunning" : "JointStagePending");
    }

    private string ResultStageValue()
    {
        if (_output is null)
        {
            return Language.Translate(_currentStage is JointValidationStage.YoloCompleted or JointValidationStage.YoloSkippedNormal ? "JointStageRunning" : "JointStagePending");
        }
        // 仅 YOLO 模式下没有异常区域，结果规模就是识别到的目标数。
        return _output.Mode == JointValidationMode.YoloOnly
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Language.Translate("JointStageDetectionCount"), _output.Matches.UnmatchedDetections.Count)
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, Language.Translate("JointStageRegionCount"), _output.Matches.Regions.Count);
    }

    private long TotalElapsedMilliseconds => (_output?.Anomalib?.Result.InferenceMilliseconds ?? 0) + (_output?.YoloMilliseconds ?? 0);
    private bool TotalInSeconds => TotalElapsedMilliseconds >= 1000;

    private string TotalTimeNumber() => TotalInSeconds
        ? (TotalElapsedMilliseconds / 1000d).ToString("0.##", System.Globalization.CultureInfo.CurrentCulture)
        : TotalElapsedMilliseconds.ToString(System.Globalization.CultureInfo.CurrentCulture);

    private static string FormatMilliseconds(long milliseconds) => milliseconds >= 1000
        ? (milliseconds / 1000d).ToString("0.##", System.Globalization.CultureInfo.CurrentCulture) + " s"
        : milliseconds.ToString(System.Globalization.CultureInfo.CurrentCulture) + " ms";

    private void AddLog(string message)
    {
        _logs.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
        if (_logs.Count > 1000) { _logs.RemoveAt(0); }
        PersistState();
    }

    private void PersistState()
    {
        if (_disposed || string.IsNullOrWhiteSpace(_owner)) { return; }
        ValidationState.Save(_owner, new(_selectedAnomalibKey, _selectedYoloIndex,
            _imagePath, _imageUrl, _imageName, _imageWidth, _imageHeight, _output, _error, _logs, _pixelThreshold, _minimumArea, _yoloParameters));
    }

    private void OnAnomalibParametersChanged()
    {
        _pixelThreshold = Math.Clamp(_pixelThreshold, 0, 1);
        _minimumArea = Math.Clamp(_minimumArea, 1, 16_777_216);
        ClearResult();
    }

    private void LoadYoloParameters()
        => _yoloParameters = string.IsNullOrEmpty(_selectedYoloIndex) ? new()
            : YoloValidationParameters.Create(_yoloModels.First(model => model.index.ToString() == _selectedYoloIndex).onnxType);

    private void OnYoloModelChanged() { LoadYoloParameters(); ClearResult(); }

    private string ParameterLabel(string key)
    {
        var resourceKey = "ValidationParameter" + key;
        return Language.Translate(resourceKey);
    }

    private void SetYoloParameter(string key, ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var value) || !double.IsFinite(value)) { return; }
        _yoloParameters[key] = Math.Clamp(value, 0, 1);
        ClearResult();
    }

    private async Task CopyLogsAsync()
    {
        try
        {
            _logJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/joint-validation.js");
            if (!await _logJs.InvokeAsync<bool>("copyText", string.Join(Environment.NewLine, _logs)))
            {
                throw new InvalidOperationException(Language.Translate("JointCopyFailed"));
            }
            AddLog(Language.Translate("JointLogsCopied"));
        }
        catch (Exception error) { _error = error.Message; AddLog(error.ToString()); }
    }

    private void DeleteImage()
    {
        if (_imagePath is not null && File.Exists(_imagePath)) { File.Delete(_imagePath); }
        _imagePath = null;
        _imageUrl = null;
        _imageName = null;
    }

    public async ValueTask DisposeAsync()
    {
        Language.LanguageChanged -= OnLanguageChanged;
        _disposed = true;
        await _cancellation.CancelAsync();
        if (_identifyTask is not null) { try { await _identifyTask; } catch { } }
        if (_logJs is not null) { try { await _logJs.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _cancellation.Dispose();
    }
}
