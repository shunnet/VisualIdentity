<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>e6f52d85-22d6-4bc8-a5f6-b83fd45e6dd2</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Snet.Yolo.Tasks</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Program.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Services\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Components\**\*.razor.cs" />
    <Content Include="$(MSBuildThisFileDirectory)Components\**\*.razor" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(MSBuildThisFileDirectory)wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(MSBuildThisFileDirectory)appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 导入的 Web 资源实际位于共享项目中，因此开发清单必须将共享目录作为内容根目录。 -->
  <Target Name="UseTasksSharedWebRoot" AfterTargets="ResolveProjectStaticWebAssets">
    <ItemGroup>
      <StaticWebAsset Update="$(MSBuildThisFileDirectory)wwwroot\**\*">
        <ContentRoot>$(MSBuildThisFileDirectory)wwwroot\</ContentRoot>
      </StaticWebAsset>
    </ItemGroup>
  </Target>
</Project>
