<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OnnxRuntimeTestUsesGpu Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64' Or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">true</OnnxRuntimeTestUsesGpu>
	</PropertyGroup>

	<ItemGroup>
		<!-- 测试与统一宿主使用相同平台的单一原生运行库。 -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" Condition="'$(OnnxRuntimeTestUsesGpu)' != 'true'" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.1" Condition="'$(OnnxRuntimeTestUsesGpu)' == 'true'" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
		<PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Snet.Yolo.Server\Snet.Yolo.Server.csproj" />
		<ProjectReference Include="..\Snet.Yolo.Api\Snet.Yolo.Api.csproj" />
		<ProjectReference Include="..\Snet.Yolo.Tasks\Snet.Yolo.Tasks.csproj" />
		<ProjectReference Include="..\Snet.Yolo.Tasks.Core\Snet.Yolo.Tasks.Core.csproj" />
		<ProjectReference Include="..\Snet.VisualIdentity.JointVerificationDemo\Snet.VisualIdentity.JointVerificationDemo.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 在跨平台测试宿主中编译不依赖 WPF 的桌面运行服务，验证同一份会话及设备切换逻辑。 -->
		<Compile Include="..\Snet.Yolo.Tool\Services\ToolRuntimeService.cs" Link="ToolRuntime\ToolRuntimeService.cs" />
		<Compile Include="..\Snet.Yolo.Tool\Services\ToolSessionEntry.cs" Link="ToolRuntime\ToolSessionEntry.cs" />
		<Compile Include="..\Snet.Yolo.Tool\Services\ToolSessionLease.cs" Link="ToolRuntime\ToolSessionLease.cs" />
	</ItemGroup>

</Project>
