@inherits LayoutComponentBase
@implements IDisposable
@using Snet.Yolo.Tasks.Services
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage ProtectedStorage
@inject LanguageManager Language

<Toasts />
@if (!_ready) { <div class="ls-login-wrap"><div class="spinner-border text-secondary"></div></div> }
else
{
<a class="ls-skip-link" href="#main-content">@Language.Translate("SkipToContent")</a>
<div class="ls-shell">
    <aside id="primary-navigation" class="ls-sidebar @SidebarClass" aria-label="@Language.Translate("PrimaryNavigation")">
        <div class="ls-side-head">
            <img class="ls-brand-mark" src="https://api.snet.cn/pic/nuget.png" width="40" height="40" alt="" aria-hidden="true" />
            <span class="ls-side-title ls-side-text"><strong>Snet.Yolo</strong><small>Tasks</small></span>
            <button type="button" class="ls-icon-btn ls-side-toggle" @onclick="ToggleNav" aria-expanded="@(!_collapsed)" aria-label="@Language.Translate(_collapsed ? "ExpandNavigation" : "CollapseNavigation")"><i class="bi @(_collapsed ? "bi-chevron-right" : "bi-chevron-left")" aria-hidden="true"></i></button>
        </div>
        <nav class="ls-side-nav">
            @foreach (var item in NavItems)
            {
                var path = Nav.ToBaseRelativePath(Nav.Uri); if (!path.StartsWith("/")) { path = "/" + path; } var active = path == item.Href || path.StartsWith(item.Href) || (item.Href == "/projects" && path.StartsWith("/project/"));
                <a class="ls-side-item @(active ? "active" : null)" href="@item.Href" @onclick="() => NavTo(item.Href)" title="@Language.Translate(item.TextKey)" aria-current="@(active ? "page" : null)">
                    <i class="bi @item.Icon" aria-hidden="true"></i><span class="ls-side-text">@Language.Translate(item.TextKey)</span>
                </a>
            }
        </nav>
        <div class="ls-side-foot">
            <a class="ls-side-item" href="/login" @onclick="LogoutAsync" title="@Language.Translate("Logout")"><i class="bi bi-box-arrow-left" aria-hidden="true"></i><span class="ls-side-text">@Language.Translate("Logout")</span></a>
        </div>
    </aside>
    <div class="ls-shell-main">
        <header class="ls-topbar ls-shell-topbar">
            <button type="button" class="ls-icon-btn ls-mobile-nav-toggle" @onclick="ToggleMobileNav" aria-expanded="@_mobileOpen" aria-controls="primary-navigation" aria-label="@Language.Translate("PrimaryNavigation")"><i class="bi bi-list" aria-hidden="true"></i></button>
            <span class="ls-brand">
                @if (_collapsed)
                {
                    <span class="ls-topbar-product"><strong>Snet.Yolo</strong><small>Tasks</small></span>
                }
            </span>
            <span class="ls-spacer"></span>
            <AppHeaderControls />
            <span class="ls-user-chip"><span class="ls-user-avatar" aria-hidden="true">@UserInitial</span><span>@Auth.CurrentUser?.username</span></span>
        </header>
        <main id="main-content" class="ls-content" tabindex="-1">
            @Body
        </main>
    </div>
    @if (_mobileOpen) { <div class="ls-side-backdrop" @onclick="CloseMobileNav"></div> }
</div>
}

@code {
    private bool _collapsed;
    private bool _mobileOpen;
    private string SidebarClass => $"ls-sidebar{(_collapsed ? " collapsed" : null)}{(_mobileOpen ? " mobile-open" : null)}";
    private bool _ready;
    private string UserInitial => string.IsNullOrWhiteSpace(Auth.CurrentUser?.username) ? "U" : Auth.CurrentUser!.username![0].ToString().ToUpperInvariant();
    private record NavItem(string Href, string Icon, string TextKey);
    private List<NavItem> NavItems = new() {
        new("/projects", "bi-collection", "Projects"),
        new("/validation", "bi-cpu", "Validation"),
        new("/users", "bi-people", "Users"),
    };
    // SSR 预渲染时 localStorage 不可用，故守卫放在电路连接后的首次渲染执行。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_ready)
        {
            if (!Auth.IsAuthenticated)
            {
                try
                {
                    var stored = await ProtectedStorage.GetAsync<string>("snet.user");
                    if (stored.Success && !string.IsNullOrWhiteSpace(stored.Value)) { await Auth.RestoreAsync(stored.Value); }
                }
                catch { }
                if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
            }
            _collapsed = (await LocalStorageGet("ls-nav-collapsed")) == "1";
            _ready = true;
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender) { Language.LanguageChanged += OnLangChanged; }
    }

    private async Task ToggleNav() { _collapsed = !_collapsed; await LocalStorageSet("ls-nav-collapsed", _collapsed ? "1" : "0"); }
    private void ToggleMobileNav() { _mobileOpen = !_mobileOpen; }
    private void CloseMobileNav() { _mobileOpen = false; }
    private void NavTo(string href) { CloseMobileNav(); Nav.NavigateTo(href); }
    private async Task LogoutAsync() { Auth.Logout(); try { await ProtectedStorage.DeleteAsync("snet.user"); } catch { } Nav.NavigateTo("/login"); }
    private void OnLangChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Language.LanguageChanged -= OnLangChanged; }

    private async Task<string?> LocalStorageGet(string key) { try { var js = await Js.InvokeAsync<string>("localStorage.getItem", key); return js; } catch { return null; } }
    private async Task LocalStorageSet(string key, string value) { try { await Js.InvokeVoidAsync("localStorage.setItem", key, value); } catch { } }

}
