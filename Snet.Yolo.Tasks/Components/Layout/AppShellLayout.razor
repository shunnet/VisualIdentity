@inherits LayoutComponentBase
@implements IDisposable
@using Snet.Yolo.Tasks.Services
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject LanguageManager Language

<Toasts />
@if (!_ready) { <div class="ls-login-wrap"><div class="spinner-border text-secondary"></div></div> }
else
{
<div class="ls-shell">
    <aside class="ls-sidebar @(_collapsed ? "collapsed" : null)">
        <div class="ls-side-head">
            <span class="ls-side-logo"><img src="https://api.snet.cn/pic/nuget.png" alt="" /></span>
            <span class="ls-side-title ls-side-text">Snet.Yolo</span>
            <button class="ls-icon-btn ls-side-toggle" @onclick="ToggleNav"><i class="bi @(_collapsed ? "bi-chevron-right" : "bi-chevron-left")"></i></button>
        </div>
        <nav class="ls-side-nav">
            @foreach (var item in NavItems)
            {
                var path = Nav.ToBaseRelativePath(Nav.Uri); if (!path.StartsWith("/")) { path = "/" + path; } var active = path == item.Href || path.StartsWith(item.Href) || (item.Href == "/projects" && path.StartsWith("/project/"));
                <a class="ls-side-item @(active ? "active" : null)" href="@item.Href" title="@Language.Translate(item.TextKey)">
                    <i class="bi @item.Icon"></i><span class="ls-side-text">@Language.Translate(item.TextKey)</span>
                </a>
            }
        </nav>
        <div class="ls-side-foot">
            <a class="ls-side-item" href="/login" @onclick="LogoutAsync" title="@Language.Translate("Logout")"><i class="bi bi-box-arrow-left"></i><span class="ls-side-text">@Language.Translate("Logout")</span></a>
        </div>
    </aside>
    <div class="ls-shell-main">
        <header class="ls-topbar ls-shell-topbar">
            <span class="ls-brand"><i class="bi bi-grid"></i><span>@CurrentPageTitle</span></span>
            <span class="ls-spacer"></span>
            <AppHeaderControls />
            <span class="ls-chip">@Auth.CurrentUser?.username</span>
        </header>
        <main class="ls-content">
            @Body
        </main>
    </div>
</div>
}

@code {
    private bool _collapsed;
    private bool _ready;
    private bool _collapsedInit;
    private record NavItem(string Href, string Icon, string TextKey);
    private List<NavItem> NavItems = new() {
        new("/projects", "bi-collection", "Projects"),
        new("/validation", "bi-cpu", "Validation"),
        new("/users", "bi-people", "Users"),
    };
    private string CurrentPageTitle
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri); if (!path.StartsWith("/")) { path = "/" + path; }
            var item = NavItems.FirstOrDefault(n => path == n.Href || path.StartsWith(n.Href) || (n.Href == "/projects" && path.StartsWith("/project/")));
            return item is null ? "Snet.Yolo" : Language.Translate(item.TextKey);
        }
    }

    // SSR 预渲染时 localStorage 不可用，故守卫放在电路连接后的首次渲染执行。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_ready)
        {
            if (!Auth.IsAuthenticated)
            {
                var stored = await LocalStorageGet("snet.user");
                if (!string.IsNullOrWhiteSpace(stored)) { await Auth.RestoreAsync(stored); }
                if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
            }
            _collapsed = (await LocalStorageGet("ls-nav-collapsed")) == "1";
            _ready = true;
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void ToggleNav() { _collapsed = !_collapsed; _ = LocalStorageSet("ls-nav-collapsed", _collapsed ? "1" : "0"); }
    private async Task LogoutAsync() { Auth.Logout(); _ = LocalStorageSet("snet.user", ""); Nav.NavigateTo("/login"); }
    protected override void OnAfterRender(bool firstRender) { if (!_collapsedInit) { _collapsedInit = true; } }
    public void Dispose() { }

    private async Task<string?> LocalStorageGet(string key) { try { var js = await Js.InvokeAsync<string>("localStorage.getItem", key); return js; } catch { return null; } }
    private async Task LocalStorageSet(string key, string value) { try { await Js.InvokeVoidAsync("localStorage.setItem", key, value); } catch { } }

}
