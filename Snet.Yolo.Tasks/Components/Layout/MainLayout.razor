@inherits LayoutComponentBase

<Toasts />
<header class="ls-topbar">
    <a class="ls-brand" href="/"><img src="https://api.snet.cn/pic/nuget.png" alt="Snet.Yolo.Tasks" class="ls-logo" /><span>Snet.Yolo.Tasks</span><span class="ls-version">@("v" + Version)</span></a>
        <span class="ls-spacer"></span>
    <AppHeaderControls />
</header>

<main class="ls-content">
    @Body
</main>

@code {
    private string Version => typeof(Program).Assembly.GetName().Version?.ToString(3) ?? "1.0.0";
}

<div id="blazor-error-ui" data-nosnippet>
    <span><LangText Key="ErrorHint" /></span>
    <a href="." class="reload"><LangText Key="Reload" /></a>
    <span class="dismiss">🗙</span>
</div>
