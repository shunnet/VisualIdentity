
@using Snet.Yolo.Tasks.Services
@implements IAsyncDisposable
@inject ToastService Toast
@inject LanguageManager Language

<div class="ls-toast-host">
    @foreach (var entry in Toast.Entries)
    {
        <div class="ls-toast ls-toast-@entry.Type.ToString().ToLowerInvariant()" role="alert">
            <span>@entry.Message</span>
            <button type="button" class="ls-toast-close" aria-label="@Language.Translate("Close")" @onclick="() => Dismiss(entry.Id)">×</button>
        </div>
    }
</div>

@code {
    private readonly HashSet<string> _scheduled = new();
    private readonly CancellationTokenSource _disposeCancellation = new();

    protected override void OnInitialized()
    {
        Toast.Changed += OnChanged;
        Language.LanguageChanged += OnLanguageChanged;
        SchedulePending();
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnChanged()
    {
        _ = InvokeAsync(() => { StateHasChanged(); SchedulePending(); });
    }

    private void SchedulePending()
    {
        foreach (var entry in Toast.Entries)
        {
            if (_scheduled.Add(entry.Id))
            {
                _ = ExpireAsync(entry.Id, _disposeCancellation.Token);
            }
        }
    }

    private async Task ExpireAsync(string id, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken);
            await InvokeAsync(() =>
            {
                _scheduled.Remove(id);
                Toast.Remove(id);
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void Dismiss(string id)
    {
        _scheduled.Remove(id);
        Toast.Remove(id);
    }

    public async ValueTask DisposeAsync()
    {
        Toast.Changed -= OnChanged;
        Language.LanguageChanged -= OnLanguageChanged;
        await _disposeCancellation.CancelAsync();
        _disposeCancellation.Dispose();
    }
}
