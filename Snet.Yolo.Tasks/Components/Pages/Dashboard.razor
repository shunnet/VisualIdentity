@page "/"
@using Snet.Yolo.Tasks.Services
@using Snet.Yolo.Tasks.Core.Workspace
@inject WorkspaceService Workspaces
@inject TrainingService Training
@inject SystemMetrics Metrics
@inject LanguageManager Language
@implements IDisposable

<div class="ls-dash">
    <div class="ls-dash-head"><h1 class="h4"><i class="bi bi-speedometer2 ls-head-icon"></i><LangText Key="Home" /></h1></div>
    <div class="ls-stats ls-dash-stats">
        <div class="ls-stat"><span>@_cpu</span><small>CPU</small></div>
        <div class="ls-stat"><span>@_mem</span><small>@Language.Translate("Memory")</small></div>
        <div class="ls-stat"><span>@_gpu</span><small>GPU</small></div>
        <div class="ls-stat"><span>@_vram</span><small>@Language.Translate("Vram")</small></div>
    </div>

    <div class="ls-card"><div class="ls-card-head"><h3 class="ls-h3"><i class="bi bi-activity"></i>@Language.Translate("Home")@(" · ")</h3></div><canvas id="dash-line" style="height:220px"></canvas></div>
    <div class="ls-card"><div class="ls-card-head"><h3 class="ls-h3"><i class="bi bi-bar-chart"></i><LangText Key="Projects" /></h3></div><canvas id="dash-bar" style="height:200px"></canvas></div>
    <div class="ls-card ls-dash-projects">
        <div class="ls-card-head"><h3 class="ls-h3"><i class="bi bi-collection"></i><LangText Key="Projects" /></h3></div>
        <div class="ls-dash-list">
            @foreach (var prj in _projects)
            {
                <div class="d-flex justify-content-between"><span>@prj.Name</span><span class="small">@prj.Tasks.Count</span></div>
            }
        </div>
    </div>
</div>

@code {
    private double _cpu,_mem,_gpu,_vram;
    private readonly List<WorkspaceProject> _projects = new();
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        await InitCharts();
        _timer = new Timer(_ => { try { var s = Metrics.Sample(); _cpu = s.CpuPercent; _mem = s.MemPercent; _gpu = s.Gpu?.Utilization ?? 0; _vram = s.Gpu is null ? 0 : Math.Round(s.Gpu.VramUsedMb); _ = InvokeAsync(StateHasChanged); _ = AddLinePoint(s); } catch { } }, null, 800, 1000);
    }
    private async Task Load() {
        using var scope = ScopeFactory.CreateScope();
        var ws = scope.ServiceProvider.GetRequiredService<WorkspaceService>();
        var all = await ws.ListProjectsAsync();
        _projects.Clear(); _projects.AddRange(all ?? new());
        await InvokeAsync(StateHasChanged);
    }
    [Inject] private IServiceScopeFactory ScopeFactory { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    private readonly List<double> _cpuHist = new(), _memHist = new(), _gpuHist = new();

    private async Task InitCharts()
    {
        try
        {
            var js = await Js.InvokeAsync<IJSObjectReference>("import", "./js/dash-charts.js");
            jsLine = js;
            await js.InvokeVoidAsync("line", "dash-line", new[] { "0" }, new object[] {
                new { label = "CPU", data = new[] { _cpu }, borderColor = "#e11d48", tension = .3 },
                new { label = "Memory", data = new[] { _mem }, borderColor = "#2563eb", tension = .3 },
                new { label = "GPU", data = new[] { _gpu }, borderColor = "#10b981", tension = .3 }
            });
            await js.InvokeVoidAsync("bar", "dash-bar", _projects.Select(p => p.Name).ToArray(), _projects.Select(p => (double)p.Tasks.Count).ToArray(), "Tasks");
        }
        catch { }
    }

    private async Task AddLinePoint(SystemMetricsSnapshot s)
    {
        _cpuHist.Add(s.CpuPercent); _memHist.Add(s.MemPercent); _gpuHist.Add(s.Gpu?.Utilization ?? 0);
        if (_cpuHist.Count > 60) { _cpuHist.RemoveAt(0); _memHist.RemoveAt(0); _gpuHist.RemoveAt(0); }
        try
        {
            if (jsLine is null) return;
            var labels = _cpuHist.Select((_, i) => i.ToString()).ToArray();
            await jsLine.InvokeVoidAsync("line", "dash-line", labels, new object[] {
                new { label = "CPU", data = _cpuHist.ToArray(), borderColor = "#e11d48", tension = .3 },
                new { label = "Memory", data = _memHist.ToArray(), borderColor = "#2563eb", tension = .3 },
                new { label = "GPU", data = _gpuHist.ToArray(), borderColor = "#10b981", tension = .3 }
            });
        }
        catch { }
    }
    private IJSObjectReference? jsLine;
    public void Dispose() { _timer?.Dispose(); }
}
