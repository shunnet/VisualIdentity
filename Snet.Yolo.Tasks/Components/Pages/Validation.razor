@page "/validation"
@attribute [Authorize]
@implements IAsyncDisposable
@using Snet.Yolo.Tasks.Services
@using Snet.Yolo.Server.models.data
@inject ValidationService Valid
@inject LanguageManager Language
@inject ToastService Toast
@inject ValidationState State
@inject IJSRuntime Js

<div class="ls-refined-page ls-validation-page">
<div class="ls-page-head">
    <h1 class="ls-page-title ls-page-title-with-icon"><i class="bi bi-cpu" aria-hidden="true"></i><LangText Key="Validation" /></h1>
    <div class="ls-page-actions"><button class="btn btn-sm btn-primary" @onclick="() => _showAdd = true"><i class="bi bi-plus"></i> <LangText Key="AddModel" /></button></div>
</div>

<div class="ls-val">
    <!-- 左：模型列表 -->
    <aside class="ls-val-left">
        <div class="ls-val-head">
            <span class="ls-val-title"><i class="bi bi-cpu"></i><LangText Key="Model" /></span>
            <span class="ls-toolbar-count">@_models.Count</span>
        </div>
        <div class="ls-val-models">
            @foreach (var m in _models)
            {
                <div class="ls-model-item @(_sel?.index == m.index ? "active" : null)" @onclick="() => SelectModel(m)">
                    <div class="ls-model-row">
                        <div class="ls-model-txt"><div class="fw-semibold">@m.name</div><div class="small text-secondary">@m.onnxType</div></div>
                        <div class="ls-model-actions">
                            <a class="btn btn-icon-sm btn-outline-secondary" href="/api/models/@m.index/download" title="@Language.Translate("ExportModel")" aria-label="@($"{Language.Translate("ExportModel")}: {m.name}")" download><i class="bi bi-download" aria-hidden="true"></i></a>
                            <button class="btn btn-icon-sm btn-outline-danger" @onclick="() => Del(m.index)" title="@Language.Translate("Delete")" aria-label="@($"{Language.Translate("Delete")}: {m.name}")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                    </div>
                </div>
            }
            @if (_models.Count == 0)
            {
                <EmptyState Icon="bi-cpu" Class="ls-val-empty" Style="padding:1.5rem .5rem">
                    <Body><LangText Key="NoModels" /></Body>
                    <Actions><button class="btn btn-outline-secondary btn-sm" @onclick="() => _showAdd = true"><i class="bi bi-plus"></i> <LangText Key="AddModel" /></button></Actions>
                </EmptyState>
            }
        </div>
    </aside>

    <!-- 右：识别台 + 独立日志卡片 -->
    <div class="ls-val-workspace">
    <main class="ls-val-console">
        <div class="ls-val-toolbar">
            <span class="ls-val-title"><i class="bi bi-speedometer2"></i><LangText Key="Identify" /></span>
        </div>

        @if (_sel is not null)
        {
            <div class="ls-val-params">
                @foreach (var kv in _params)
                {
                    <div class="ls-param"><label class="small mb-1 d-block text-secondary">@kv.Key</label><input type="number" step="0.01" class="form-control form-control-sm" value="@kv.Value" @onchange="e => SetParam(kv.Key, e)" /></div>
                }
                <label class="btn btn-outline-secondary btn-sm ms-auto"><i class="bi bi-upload"></i> <LangText Key="UploadImage" /> <InputFile OnChange="OnImage" accept="image/*" hidden /></label>
                <button class="btn btn-primary btn-sm" @onclick="Identify" disabled="@_identifying">
                    @if (_identifying) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    else { <i class="bi bi-crosshair" aria-hidden="true"></i> }
                    @(_identifying ? "..." : Language.Translate("Identify"))
                </button>
            </div>

            <div class="ls-val-body">
                <div class="ls-val-result-panel">
                    <div class="ls-val-panel-title"><i class="bi bi-crosshair"></i> <LangText Key="Detections" /></div>
                    <div class="ls-val-result-content">
                        @if (_result is not null)
                        {
                            @if (_detections.Count > 0)
                            {
                                <div class="ls-detect-list">
                                    @foreach (var d in _detections)
                                    {
                                        <div class="ls-detect-row"><span class="badge text-bg-danger">@d.Name</span><span class="ls-detect-conf">@d.Conf</span><span class="ls-detect-pos">@d.Pos</span></div>
                                    }
                                </div>
                            }
                            else { <div class="ls-hint">@Language.Translate("NoTargets")</div> }
                        }
                        else { <div class="ls-hint"><LangText Key="IdentifyFirst" /></div> }
                    </div>
                </div>
                <div class="ls-val-imgs @(_result is not null ? "has-mark" : null)">
                    @if (_imgUrl is null) { <div class="ls-hint"><LangText Key="UploadImage" /></div> }
                    else
                    {
                        <img class="ls-val-orig" src="@_imgUrl" alt="@Language.Translate("UploadImage")" />
                        @if (_result is not null) { <canvas id="val-mark" class="ls-val-mark"></canvas> }
                    }
                </div>
            </div>
        }
        else
        {
            <EmptyState Icon="bi-cpu" Class="ls-val-empty"><Body><LangText Key="SelectModel" /></Body></EmptyState>
        }
    </main>

    <section class="ls-val-log-dock" aria-label="@Language.Translate("Log")">
        <div class="ls-val-log-title"><i class="bi bi-terminal" aria-hidden="true"></i> <LangText Key="Log" /></div>
        <div class="ls-val-log"><div class="ls-term-line" style="height:1px"></div>@foreach (var l in _log) { <div class="ls-term-line">@RenderLog(l)</div> }</div>
    </section>
    </div>
</div>

@if (_showAdd)
{
  <div class="modal show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-plus-circle" aria-hidden="true"></i><LangText Key="AddModel" /></h5><button class="btn-close" @onclick="() => _showAdd = false" aria-label="@Language.Translate("Close")"></button></div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="ls-field-label"><LangText Key="ModelName" /></label>
            <input class="form-control" autofocus @bind="_newName" />
          </div>
          <div class="mb-3">
            <label class="ls-field-label"><LangText Key="ModelType" /></label>
            <div class="ls-type-grid" role="radiogroup" aria-label="@Language.Translate("ModelType")">
              @foreach (var t in ModelTypeOptions)
              {
                var isSel = _newType == t.Value;
                <button type="button" class="ls-type-card @(isSel ? "active" : null)" @onclick="() => _newType = t.Value" role="radio" aria-checked="@isSel">
                  @if (isSel) { <i class="bi bi-check-lg ls-type-check"></i> }
                  <i class="bi @t.Icon"></i><span>@Language.Translate(t.Key)</span>
                </button>
              }
            </div>
          </div>
          <div class="mb-3">
            <label class="ls-field-label"><LangText Key="Describe" /></label>
            <input class="form-control" @bind="_newDescribe" />
          </div>
          <label class="ls-upload-zone @(_onnxFile is not null ? "has-files" : null)">
            <InputFile OnChange="OnOnnx" accept=".onnx" hidden />
            <i class="bi bi-file-earmark-binary ls-upload-icon"></i>
            <div class="ls-upload-main">@Language.Translate("UploadOnnx")</div>
            <div class="ls-upload-sub">.onnx</div>
            @if (_onnxFile is not null)
            {
              <div class="ls-upload-count">@_onnxName · @((_onnxFile.Size / 1024.0 / 1024.0).ToString("0.###")) MB</div>
            }
          </label>
        </div>
        <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="() => _showAdd = false"><i class="bi bi-x-lg"></i> @Language.Translate("Cancel")</button><button class="btn btn-primary" @onclick="AddModel" disabled="@_modelAdding">@if (_modelAdding) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> } else { <i class="bi bi-check-lg"></i> } @Language.Translate("Create")</button></div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop show"></div>
}

</div>

@code {
  private List<OnnxData> _models = new();
  private OnnxData? _sel;
  private bool _identifying;
    private byte[]? _img { get => State.Image; set => State.Image = value; }
  private string? _imgUrl { get => State.ImageUrl; set => State.ImageUrl = value; }
  private string _selType = "";
  private string? _result { get => State.ResultJson; set => State.ResultJson = value; }
  private Dictionary<string, string> _params = new();
  private List<(string Name, string Conf, string Pos)> _detections => State.Detections;
  private sealed record LocalizedLog(string? ResourceKey, object[] Args, string? Detail = null, string? Literal = null);
  private readonly List<LocalizedLog> _log = new();
  private const long MaxOnnxSize = 500L * 1024 * 1024;
  private bool _showAdd, _modelAdding;
  private string _newName = "", _newDescribe = "", _newType = "ObjectDetection", _onnxName = "";
  private IBrowserFile? _onnxFile;
  private IJSObjectReference? _drawModule;
  private int _selectionVersion;

  /* 模型类型模板（图标卡片选择器，与新建工程一致） */
  private static readonly (string Value, string Icon, string Key)[] ModelTypeOptions = new[]
  {
    ("ObjectDetection", "bi-bounding-box", "Detect"),
    ("Segmentation", "bi-vector-pen", "Segment"),
    ("Classification", "bi-tags", "Classify"),
    ("PoseEstimation", "bi-dot", "Pose"),
    ("ObbDetection", "bi-record-circle", "Obb"),
  };

  protected override async Task OnInitializedAsync()
  {
    Language.LanguageChanged += OnLanguageChanged;
    await Reload();
  }
  private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
  public async ValueTask DisposeAsync()
  {
    Language.LanguageChanged -= OnLanguageChanged;
    if (_drawModule is not null)
    {
      try { await _drawModule.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
  }
  private async Task Reload() { _models = (await Valid.GetModelsAsync()).ToList(); StateHasChanged(); }
  private async Task SelectModel(OnnxData m)
  {
    if (_sel?.index == m.index) { return; }  // 重复点击当前模型忽略
    _sel = m;
    _params = ParamsFor(m.onnxType);
    // 切换模型：恢复该模型自己的上一次识别结果（无记录则为空态）
    var version = ++_selectionVersion;
    await LoadSlotAsync(m.index, version);
  }
  private async Task Del(int index) { if (_sel?.index == index) { ++_selectionVersion; _sel = null; _result = null; _imgUrl = null; _params = new(); _img = null; State.Detections.Clear(); } try { await Js.InvokeVoidAsync("sessionStorage.removeItem", SessionKey + "." + index); } catch { } await Valid.DeleteModelAsync(index); await Reload(); }
  private void OnOnnx(InputFileChangeEventArgs e)
  {
    var file = e.File;
    _onnxName = file.Name;
    _onnxFile = file.Size is >= 8 and <= MaxOnnxSize ? file : null;
    if (_onnxFile is null) { Toast.ShowError(Language.Translate("NoOnnx")); }
  }
  private async Task AddModel()
  {
    if (_modelAdding) { return; }
    if (_onnxFile is null) { Toast.ShowError(Language.Translate("NoOnnx")); return; }
    if (!Enum.TryParse<Snet.Yolo.Server.models.@enum.OnnxType>(_newType, out var modelType)) { Toast.ShowError(Language.Translate("OperationFailed")); return; }
    _modelAdding = true;
    try
    {
      await using var stream = _onnxFile.OpenReadStream(MaxOnnxSize);
      var result = await Valid.AddModelAsync(stream, string.IsNullOrWhiteSpace(_onnxName) ? _newName + ".onnx" : _onnxName, _newDescribe, modelType);
      if (result.Status)
      {
        Toast.ShowSuccess(Language.Translate("ModelAdded"));
        _showAdd = false;
        _onnxFile = null;
        _onnxName = "";
        await Reload();
      }
      else { Toast.ShowError(result.Message ?? Language.Translate("OperationFailed")); }
    }
    catch (Exception ex) { Toast.ShowError(ex.Message); }
    finally { _modelAdding = false; }
  }
  private async Task OnImage(InputFileChangeEventArgs e)
  {
    var f = e.File;
    const long maxImageSize = 80L * 1024 * 1024;
    if (f.Size is <= 0 or > maxImageSize || f.Size > int.MaxValue) { Toast.ShowError(Language.Translate("OperationFailed")); return; }
    await using var s = f.OpenReadStream(maxImageSize);
    var bytes = new byte[(int)f.Size];
    await s.ReadExactlyAsync(bytes);
    // 持久化到服务器 uploads 目录（sessionStorage 只有 ~5MB，存不了大图 dataURL）
    try
    {
      var uploadDir = System.IO.Path.Combine(AppContext.BaseDirectory, "wwwroot", "data", "uploads", "val");
      System.IO.Directory.CreateDirectory(uploadDir);
      var ext = System.IO.Path.GetExtension(f.Name);
      if (string.IsNullOrWhiteSpace(ext) || ext.Length > 6) { ext = ".jpg"; }
      var name = "val_" + Guid.NewGuid().ToString("N")[..12] + ext;
      await System.IO.File.WriteAllBytesAsync(System.IO.Path.Combine(uploadDir, name), bytes);
      var previousImageUrl = _imgUrl;
      _imgUrl = "/uploads/val/" + name;
      Valid.DeleteValidationImage(previousImageUrl);
    }
    catch
    {
      // 落盘失败时退回 dataURL（小图可用，刷新可能丢失）
      _imgUrl = "data:image/jpeg;base64," + Convert.ToBase64String(bytes);
    }
    _img = bytes;
    _result = null;                 // 新图重置旧识别结果，避免残留上一张的标注图
    State.Detections.Clear();
    AddLog("ImageUploaded");
    await PersistSessionAsync();
    StateHasChanged();
  }
  private async Task Identify()
  {
    if(_sel is null || _img is null){ return; }
    _identifying=true; AddLog("Identifying"); try {
      var json=_params.Count>0? System.Text.Json.JsonSerializer.Serialize(_params):"{}";
      var r= await Valid.RunLocalAsync(_sel,_img,json);
      _result=System.Text.Json.JsonSerializer.Serialize(r,new System.Text.Json.JsonSerializerOptions{WriteIndented=true});
      var _rd=r.GetDetails(out object? det) ? det : null;
      State.Detections.Clear();
      State.Detections.AddRange(ParseDetections(r));
      if (r.Status) { AddLog("LocalIdentifyComplete", new object[] { _detections.Count }); }
      else { AddLog("IdentifyReturned", detail: r.Message ?? ""); }
      _needsRedraw = true;    // 画布随重渲染创建后再绘制（避免 getElementById 拿不到 canvas）
      await PersistSessionAsync();
    } catch(Exception ex){ _log.Add(new LocalizedLog(null, Array.Empty<object>(), Literal: "ERR " + ex.Message)); } finally { _identifying=false; StateHasChanged(); }
  }
  private async Task DrawMarkAsync()
  {
    try {
      _drawModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/val-draw.js?v=20260907");
      await _drawModule.InvokeVoidAsync("draw", "val-mark", _imgUrl ?? "", _result ?? "", _sel?.onnxType?.ToString() ?? _selType);
    } catch (Exception ex) { AddLog("AnnotationDrawFailed", detail: ex.Message); }
  }
  private void AddLog(string key, object[]? args = null, string? detail = null)
    => _log.Add(new LocalizedLog(key, args ?? Array.Empty<object>(), detail));
  private string RenderLog(LocalizedLog entry)
  {
    if (entry.Literal is not null) { return entry.Literal; }
    var text = Language.Translate(entry.ResourceKey ?? "");
    if (entry.Args.Length > 0) { text = string.Format(text, entry.Args); }
    return string.IsNullOrWhiteSpace(entry.Detail) ? text : text + ": " + entry.Detail;
  }
  private List<(string Name, string Conf, string Pos)> ParseDetections(Snet.Model.data.OperateResult r)
  {
    var list = new List<(string Name, string Conf, string Pos)>();
    try {
      var json = System.Text.Json.JsonSerializer.Serialize(r);
      var doc = System.Text.Json.JsonDocument.Parse(json);
      if (doc.RootElement.TryGetProperty("ResultData", out var rd) && rd.ValueKind == System.Text.Json.JsonValueKind.Array)
      {
        foreach (var b in rd.EnumerateArray())
        {
          var name = "?";
          if (b.TryGetProperty("Label", out var lab))
          {
            if (lab.ValueKind == System.Text.Json.JsonValueKind.String) { name = lab.GetString() ?? "?"; }
            else if (lab.TryGetProperty("Name", out var nn)) { name = nn.GetString() ?? "?"; }
          }
          var conf = b.TryGetProperty("Confidence", out var cf) ? (Math.Round(cf.GetDouble()*100))+"%" : "";
          var pos = b.TryGetProperty("Position", out var pp) ? pp.GetString() ?? "" : "";
          list.Add((name, conf, pos));
        }
      }
    } catch { }
    return list;
  }

  /* ── 会话持久化：识别结果/图片存 sessionStorage，页面刷新后自动恢复 ── */
  private const string SessionKey = "snet.val.session";
  private bool _needsRedraw;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await RestoreSessionAsync();
      if (State.ResultJson is not null && State.ImageUrl is not null) { _needsRedraw = true; }
      StateHasChanged();
    }
    if (_needsRedraw)
    {
      _needsRedraw = false;
      if (State.ResultJson is not null && State.ImageUrl is not null) { await DrawMarkAsync(); }
    }
  }

  private async Task PersistSessionAsync()
  {
    // 每个模型一个会话槽（sessionStorage 键带模型 index），切换模型可分别恢复
    try
    {
      var dets = _detections.Select(d => new { d.Name, d.Conf, d.Pos }).ToList();
      var full = new { img = _imgUrl, result = _result, detections = dets, type = _sel?.onnxType?.ToString() ?? _selType };
      await Js.InvokeVoidAsync("sessionStorage.setItem", _sel is not null ? SessionKey + "." + _sel.index : SessionKey, System.Text.Json.JsonSerializer.Serialize(full));
      if (_sel is not null) { await Js.InvokeVoidAsync("sessionStorage.setItem", SessionKey + ".last", _sel.index.ToString()); }
    }
    catch
    {
      try
      {
        var dets = _detections.Select(d => new { d.Name, d.Conf, d.Pos }).ToList();
        var slim = new { img = (string?)null, result = _result, detections = dets };
        await Js.InvokeVoidAsync("sessionStorage.setItem", SessionKey, System.Text.Json.JsonSerializer.Serialize(slim));
      }
      catch { /* 存储不可用，忽略 */ }
    }
  }

  /// <summary>读取指定模型的会话槽并恢复识别区（无槽则清空）。</summary>
  private async Task LoadSlotAsync(int index, int version)
  {
    try
    {
      var json = await Js.InvokeAsync<string?>("sessionStorage.getItem", SessionKey + "." + index);
      if (version != _selectionVersion || _sel?.index != index) { return; }
      if (string.IsNullOrWhiteSpace(json))
      {
        _img = null; _imgUrl = null; _result = null; _selType = "";
        State.Detections.Clear();
        _needsRedraw = false;
      }
      else
      {
        using var doc = System.Text.Json.JsonDocument.Parse(json);
        var root = doc.RootElement;
        _imgUrl = root.TryGetProperty("img", out var imgEl) && imgEl.ValueKind == System.Text.Json.JsonValueKind.String ? imgEl.GetString() : null;
        _img = null;
        if (!string.IsNullOrEmpty(_imgUrl))
        {
          try
          {
            if (_imgUrl!.StartsWith("data:", StringComparison.Ordinal)) { _img = Convert.FromBase64String(_imgUrl[(_imgUrl.IndexOf(',') + 1)..]); }
            else { var path = System.IO.Path.Combine(AppContext.BaseDirectory, "wwwroot", _imgUrl.TrimStart('/')); _img = await System.IO.File.ReadAllBytesAsync(path); }
          }
          catch { _img = null; }
        }
        if (version != _selectionVersion || _sel?.index != index) { return; }
        _result = root.TryGetProperty("result", out var rEl) && rEl.ValueKind == System.Text.Json.JsonValueKind.String ? rEl.GetString() : null;
        _selType = root.TryGetProperty("type", out var tEl) && tEl.ValueKind == System.Text.Json.JsonValueKind.String ? (tEl.GetString() ?? "") : "";
        State.Detections.Clear();
        if (root.TryGetProperty("detections", out var dEl) && dEl.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
          foreach (var d in dEl.EnumerateArray())
          {
            State.Detections.Add((d.GetProperty("Name").GetString() ?? string.Empty, d.GetProperty("Conf").GetString() ?? string.Empty, d.GetProperty("Pos").GetString() ?? string.Empty));
          }
        }
        _needsRedraw = _result is not null && _imgUrl is not null;
      }
    }
    catch { /* 恢复失败按空处理 */ }
    StateHasChanged();
  }

  private async Task RestoreSessionAsync()
  {
    // 刷新/重开后：按"上次选中的模型"恢复其会话槽
    try
    {
      var last = await Js.InvokeAsync<string?>("sessionStorage.getItem", SessionKey + ".last");
      if (int.TryParse(last, out var idx))
      {
        var m = _models.FirstOrDefault(x => x.index == idx);
        if (m is not null) { await SelectModel(m); }
      }
    }
    catch { /* 无效数据则忽略 */ }
  }
  private Dictionary<string,string> ParamsFor(Snet.Yolo.Server.models.@enum.OnnxType? t) => t switch {
    Snet.Yolo.Server.models.@enum.OnnxType.Classification => new(){["Classes"]="1"},
    Snet.Yolo.Server.models.@enum.OnnxType.Segmentation => new(){["Confidence"]="0.2",["Iou"]="0.7",["PixelConfidence"]="0.65"},
    _ => new(){["Confidence"]="0.2",["Iou"]="0.7"},
  };
  private void SetParam(string k, ChangeEventArgs e) => _params[k]=(e.Value?.ToString() ?? "0.2");
    private async Task<string?> GetLocal(string k){ try{return await Js.InvokeAsync<string>("localStorage.getItem",k);}catch{return null;} }
}
