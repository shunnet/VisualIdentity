@page "/train/{ProjectId}"
@using Snet.Yolo.Tasks.Core.Training
@using Snet.Yolo.Tasks.Services
@implements IAsyncDisposable
@inject TrainingService Training
@inject NavigationManager Nav
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime Js
@inject LanguageManager Language
@inject ToastService Toast
@inject SystemMetrics Metrics

<div class="ls-refined-page ls-training-page">
<div class="ls-page-head">
    <div class="ls-page-lead">
        <button type="button" class="ls-icon-btn" @onclick="GoBackAsync" title="@L("Back")" aria-label="@L("Back")"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
        <h1 class="ls-page-title"><i class="bi bi-cpu"></i>@_projectName<span class="ls-page-sub"> · @L(_taskTypeKey)</span></h1>
    </div>
    <div class="ls-page-actions">
    @if (_status is not null)
    {
        <span class="ls-chip @(_status.IsActive ? "ls-chip-accent" : "")">@PhaseLabel()</span>
        @if (!string.IsNullOrEmpty(_status.YoloVersion)) { <span class="ls-version">ultralytics @_status.YoloVersion</span> }
        @if (!_status.IsActive)
        {
            @if (_status.Phase == TrainingPhase.Complete)
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenConfig" title="@L("RestartTraining")"><i class="bi bi-arrow-repeat"></i> @L("RestartTraining")</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ExportModelAsync" disabled="@_exporting"><i class="bi @(_exporting ? "bi-arrow-repeat" : "bi-check2-square")"></i> @L("ValidateModel")</button>
                <a class="btn btn-outline-secondary btn-sm" href="/api/train/@ProjectId/best-pt" download title="@L("ExportPt")"><i class="bi bi-file-earmark-arrow-down"></i> @L("ExportPt")</a>
            }
            else
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenConfig"><i class="bi bi-play-fill"></i> @L("StartTraining")</button>
            }
        }
        else
        {
            <button class="btn btn-outline-danger btn-sm" @onclick="StopAsync"><i class="bi bi-stop-circle"></i> @L("StopTraining")</button>
        }
    }
    </div>
</div>
<div class="ls-train-content">
        @if (_status is null) { <div class="ls-hint">@(!string.IsNullOrEmpty(_errorKey) ? L(_errorKey) : String.Empty)</div> }
        else
        {
            <div class="ls-train-grid">
                <div class="ls-train-main">

                    @* 训练进度（主视觉） *@
                    <section class="ls-card ls-workspace-card">
                        <div class="ls-card-head"><h3 class="ls-h3"><i class="bi bi-graph-up-arrow"></i>@L("TrainingProgress")</h3>
                            <span class="ls-percent">@_status.Percent<em>%</em></span></div>
                        <div class="ls-workspace-card-body">
                        @if (Steps.Length > 0)
                        {
                            <div class="ls-steps">
                                @for (var si = 0; si < Steps.Length; si++)
                                {
                                    var s = Steps[si];
                                    <span class="ls-step @s.State"><span class="ls-step-dot"></span>@L(s.Key)</span>
                                    @if (si < Steps.Length - 1) { <span class="ls-step-line"></span> }
                                }
                            </div>
                        }
                        <div class="progress ls-progress" role="progressbar" aria-valuenow="@_status.Percent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width:@_status.Percent%"></div>
                        </div>
                        <div class="ls-progress-meta">
                            <span>@PhaseLabel()</span>
                            @if (_status.Phase == TrainingPhase.Training) { <span>@L("Epoch") @_status.Epoch / @_status.TotalEpochs</span> }
                        </div>
                        @if (_status.Phase == TrainingPhase.Failed) { <div class="ls-error">@_status.LastError</div> }
                        </div>
                    </section>

                    @* 日志 *@
                    <section class="ls-card ls-workspace-card">
                        <div class="ls-card-head"><h3 class="ls-h3"><i class="bi bi-terminal" aria-hidden="true"></i>@L("TrainLog")</h3><button type="button" class="ls-icon-btn" title="@L("CopyLog")" aria-label="@L("CopyLog")" @onclick="CopyLog"><i class="bi bi-clipboard" aria-hidden="true"></i></button></div>
                        <div class="ls-terminal ls-train-log" @ref="_termRef">
                            @if (_status.LogTail.Count == 0) { <div class="ls-term-line ls-term-dim">—</div> }
                            @foreach (var line in _status.LogTail) { <div class="ls-term-line">@line</div> }
                        </div>
                    </section>
                </div>

                <aside class="ls-train-side">
                    <section class="ls-card ls-train-summary-card">
                        <div class="ls-train-summary-head"><i class="bi bi-database" aria-hidden="true"></i>@L("DataOverview")</div>
                        <div class="ls-train-summary-grid">
                            <div class="ls-train-summary-item"><small><i class="bi bi-images" aria-hidden="true"></i>@L("ImageCount")</small><strong>@_taskCount</strong></div>
                            <div class="ls-train-summary-item"><small><i class="bi bi-tags" aria-hidden="true"></i>@L("ClassCount")</small><strong>@_classCount</strong></div>
                            <div class="ls-train-summary-item"><small><i class="bi bi-gpu-card" aria-hidden="true"></i>@L("Device")</small><strong>@DeviceLabel()</strong></div>
                            <div class="ls-train-summary-item"><small><i class="bi bi-box" aria-hidden="true"></i>@L("Model")</small><strong title="@_status.ModelName">@_status.ModelName</strong></div>
                        </div>
                    </section>

                    <section class="ls-card ls-train-summary-card">
                        <div class="ls-train-summary-head"><i class="bi bi-speedometer2" aria-hidden="true"></i>@L("SystemResources")</div>
                        <div class="ls-resource-list">
                            <div class="ls-resource-row"><div><span>CPU</span><strong>@_res.CpuPercent.ToString("0")%</strong></div><div class="ls-resource-meter"><span style="width:@_res.CpuPercent%"></span></div></div>
                            <div class="ls-resource-row"><div><span>@L("Memory")</span><strong>@_res.MemPercent.ToString("0")%</strong></div><div class="ls-resource-meter"><span style="width:@_res.MemPercent%"></span></div>@if (_res.MemTotalMb > 0) { <small>@_res.MemUsedMb.ToString("0") / @_res.MemTotalMb.ToString("0") MB</small> }</div>
                            @if (_res.Gpu is not null)
                            {
                                <div class="ls-resource-row"><div><span>GPU</span><strong>@_res.Gpu.Utilization%</strong></div><div class="ls-resource-meter"><span style="width:@_res.Gpu.Utilization%"></span></div></div>
                                <div class="ls-resource-row"><div><span>@L("GpuMemory")</span><strong>@_res.Gpu.VramUsedMb.ToString("0") / @_res.Gpu.VramTotalMb.ToString("0") MB</strong></div><div class="ls-resource-meter"><span style="width:@GpuVramPercent%"></span></div><small title="@_res.Gpu.Name">@_res.Gpu.Name</small></div>
                            }
                            else
                            {
                                <div class="ls-resource-row"><div><span>GPU</span><strong>—</strong></div><div class="ls-resource-meter"><span style="width:0"></span></div></div>
                            }
                        </div>
                    </section>

                    @if (_status.Metrics.HasValue)
                    {
                        <section class="ls-card ls-train-summary-card">
                            <div class="ls-train-summary-head"><i class="bi bi-bar-chart" aria-hidden="true"></i>@L("TrainingMetrics")</div>
                            <div class="ls-train-metric-grid">
                                <div><small>mAP50</small><strong>@_status.Metrics.Map50?.ToString("0.###") ?? "-"</strong></div>
                                <div><small>mAP50-95</small><strong>@_status.Metrics.Map5095?.ToString("0.###") ?? "-"</strong></div>
                                <div><small>BOX</small><strong>@_status.Metrics.BoxLoss?.ToString("0.###") ?? "-"</strong></div>
                                <div><small>CLS</small><strong>@_status.Metrics.ClsLoss?.ToString("0.###") ?? "-"</strong></div>
                            </div>
                        </section>
                    }
                </aside>
            </div>
        }
</div>

@if (_configOpen)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg ls-training-config-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-sliders"></i>@L("TrainingConfig")</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfig" aria-label="@L("Close")"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="ls-field-label mb-1">@L("Epochs")</label>
                        <input type="number" value="@_options.Epochs" class="form-control" @onchange="SetEpochs" />
                    </div>
                    <div class="mb-3">
                        <label class="ls-field-label mb-1">@L("Device")</label>
                        <div class="ls-config-choice-grid ls-config-device-grid" role="radiogroup" aria-label="@L("Device")">
                            <button type="button" class="ls-config-choice @(_options.Device == "auto" ? "active" : null)" role="radio" aria-checked="@(_options.Device == "auto")" @onclick='() => _options.Device = "auto"'>
                                <i class="bi bi-stars" aria-hidden="true"></i>
                                <span>@L("DeviceAuto")</span>
                                <small>Auto</small>
                            </button>
                            <button type="button" class="ls-config-choice @(_options.Device == "cpu" ? "active" : null)" role="radio" aria-checked="@(_options.Device == "cpu")" @onclick='() => _options.Device = "cpu"'>
                                <i class="bi bi-cpu" aria-hidden="true"></i>
                                <span>@L("DeviceCpu")</span>
                                <small>CPU</small>
                            </button>
                            <button type="button" class="ls-config-choice @(_options.Device == "0" ? "active" : null)" role="radio" aria-checked="@(_options.Device == "0")" @onclick='() => _options.Device = "0"'>
                                <i class="bi bi-gpu-card" aria-hidden="true"></i>
                                <span>@L("DeviceGpu")</span>
                                <small>GPU 0</small>
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="ls-field-label mb-1">@L("Model")</label>
                        @foreach (var family in ModelFamilies)
                        {
                            <section class="ls-model-choice-group">
                                <div class="ls-model-choice-heading">
                                    <span>@family.Name</span>
                                    <small>@L(family.MetaKey)</small>
                                </div>
                                <div class="ls-config-choice-grid ls-config-model-grid" role="radiogroup" aria-label="@family.Name">
                                    @foreach (var model in family.Models)
                                    {
                                        var selected = _options.Model == model.Value;
                                        <button type="button" class="ls-config-choice ls-model-choice @(selected ? "active" : null)" role="radio" aria-checked="@selected" @onclick="() => _options.Model = model.Value">
                                            <i class="bi @model.Icon" aria-hidden="true"></i>
                                            <span>@model.Size</span>
                                            <small>@model.Value</small>
                                        </button>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="useval" checked="@_options.UseVal" @onchange="SetUseVal" />
                        <label class="form-check-label small" for="useval">@L("UseVal") (@L("AutoSplitValidationHint"))</label>
                    </div>
                    <div class="ls-hint">@L("ValSetHint")</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseConfig"><i class="bi bi-x-lg"></i> @L("Cancel")</button>
                    <button type="button" class="btn btn-primary" @onclick="StartAsync"><i class="bi bi-play-fill"></i> @L("StartTraining")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    private string _projectName = "";
    private string _taskTypeKey = "YoloDetect";
    private int _taskCount, _classCount;
    private TrainingStatus? _status;
    private TrainingOptions _options = new();
    private SystemMetricsSnapshot _res = new(0, 0, 0, 0, null);
    private bool _configOpen;
    private static readonly (string Name, string MetaKey, (string Value, string Size, string Icon)[] Models)[] ModelFamilies =
    [
        ("YOLO26", "Latest",
        [
            ("yolo26n.pt", "Nano", "bi-feather"),
            ("yolo26s.pt", "Small", "bi-lightning"),
            ("yolo26m.pt", "Medium", "bi-layers"),
            ("yolo26l.pt", "Large", "bi-boxes"),
            ("yolo26x.pt", "XLarge", "bi-rocket-takeoff")
        ]),
        ("YOLO11", "Compatible",
        [
            ("yolo11n.pt", "Nano", "bi-feather"),
            ("yolo11s.pt", "Small", "bi-lightning"),
            ("yolo11m.pt", "Medium", "bi-layers"),
            ("yolo11l.pt", "Large", "bi-boxes"),
            ("yolo11x.pt", "XLarge", "bi-rocket-takeoff")
        ])
    ];
    private string _errorKey = "";
    private ElementReference _termRef;
    private CancellationTokenSource? _pollCts;
    private Task? _pollTask;
    private IJSObjectReference? _trainJs;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _trainJs = await Js.InvokeAsync<IJSObjectReference>("import", "./js/train.js?v=20260904");
            if (_trainJs is not null) { try { await _trainJs.InvokeVoidAsync("watchTerminal", _termRef); } catch { } }
        }
        if (_trainJs is not null && _status?.IsActive == true && _status.LogTail.Count > 0) { try { await _trainJs.InvokeVoidAsync("scrollElToBottom", _termRef); } catch { } }
    }

    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLangChanged;
        using var scope = ScopeFactory.CreateScope();
        var ws = scope.ServiceProvider.GetRequiredService<WorkspaceService>();
        var p = await ws.GetProjectAsync(ProjectId);
        if (p is null) { _errorKey = "NoProject"; return; }
        _projectName = p.Name;
        _taskTypeKey = TaskTypeKey(p.LabelConfigXml);
        _taskCount = p.Tasks.Count;
        _classCount = CountClasses(p.LabelConfigXml);
        _status = Training.GetStatus(ProjectId) ?? new TrainingStatus { ProjectId = ProjectId, Phase = TrainingPhase.Idle, ModelName = "yolo26n.pt", TotalEpochs = 50, Percent = 0, Device = "auto" };
        _options.Model = _status?.ModelName ?? "yolo26n.pt";
        StartPoll();
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private TrainingPhase _lastPhase = TrainingPhase.Idle;

    private void StartPoll()
    {
        _pollCts = new CancellationTokenSource();
        _pollTask = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(800, cancellationToken);
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            do
            {
                var status = Training.GetStatus(ProjectId);
                var resources = await Metrics.SampleAsync(cancellationToken);
                await InvokeAsync(() => ApplyPollResult(status, resources));
            }
            while (await timer.WaitForNextTickAsync(cancellationToken));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void ApplyPollResult(TrainingStatus? status, SystemMetricsSnapshot resources)
    {
        if (status is not null)
        {
            _status = status;
            if (status.Phase == TrainingPhase.Failed && _lastPhase != TrainingPhase.Failed)
            {
                var message = string.IsNullOrEmpty(status.LastError) ? L("TrainFailed") : L("TrainFailed") + ": " + status.LastError;
                Toast.ShowError(message);
            }
            _lastPhase = status.Phase;
        }
        _res = resources;
        StateHasChanged();
    }

    private static string TaskTypeKey(string? xml)
    {
        try
        {
            var cfg = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(xml ?? "");
            return Snet.Yolo.Tasks.Core.Config.YoloTaskRegistry.FromConfig(cfg) switch
            {
                Snet.Yolo.Tasks.Core.Config.YoloTaskType.Segment => "YoloSegment",
                Snet.Yolo.Tasks.Core.Config.YoloTaskType.Classify => "YoloClassify",
                Snet.Yolo.Tasks.Core.Config.YoloTaskType.Pose => "YoloPose",
                Snet.Yolo.Tasks.Core.Config.YoloTaskType.Obb => "YoloObb",
                _ => "YoloDetect",
            };
        }
        catch { return "YoloDetect"; }
    }

    private int CountClasses(string xml)
    {
        try { var cfg = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(xml); return cfg.Controls.SelectMany(c => c.Labels).Select(l => l.Value).Distinct().Count(); } catch { return 0; }
    }

    private async Task CopyLog()
    {
        var text = string.Join("\n", _status?.LogTail ?? new List<string>());
        if (string.IsNullOrEmpty(text)) { Toast.ShowWarning(L("CopyEmpty")); return; }
        var ok = false;
        try
        {
            if (_trainJs is null) { _trainJs = await Js.InvokeAsync<IJSObjectReference>("import", "./js/train.js?v=20260904"); }
            ok = await _trainJs.InvokeAsync<bool>("copyText", text);
        }
        catch { }
        if (ok) { Toast.ShowSuccess(L("Copied")); } else { Toast.ShowError(L("CopyFailed")); }
    }

    private void OpenConfig() => _configOpen = true;
    private void CloseConfig() => _configOpen = false;
    private void SetEpochs(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _options.Epochs = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : 50; }
    private void SetUseVal(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _options.UseVal = e.Value is true;
    private async Task StartAsync()
    {
        try { _status = await Training.StartAsync(ProjectId, _options); _configOpen = false; Toast.ShowSuccess(L("StartTraining") + " ✓"); }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
    }
    private async Task StopAsync() { await Training.StopAsync(ProjectId); }
    private bool _exporting;
    private async Task ExportModelAsync()
    {
        if (_exporting) { return; }
        _exporting = true;
        try
        {
            var r = await Training.ExportForValidationAsync(ProjectId);
            if (r.Ok) { Toast.ShowSuccess(L("ModelExported")); Nav.NavigateTo("/validation"); }
            else { Toast.ShowError(r.Message); }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { _exporting = false; }
    }

    private void GoBackAsync() => Nav.NavigateTo("/projects");
    private string PhaseLabel() => _status?.Phase switch
    {
        TrainingPhase.Preparing => L("StatusPreparing"),
        TrainingPhase.EnvironmentCheck => L("StatusEnvCheck"),
        TrainingPhase.Installing => L("StatusInstalling"),
        TrainingPhase.Training => L("StatusTraining"),
        TrainingPhase.Validating => L("StatusValidating"),
        TrainingPhase.Complete => L("StatusComplete"),
        TrainingPhase.Failed => L("StatusFailed"),
        TrainingPhase.Cancelled => L("StatusCancelled"),
        _ => L("Idle"),
    };
    private string L(string k) => Language.Translate(k);

    /* 训练阶段步骤指示条 */
    private (string Key, string State)[] Steps
    {
        get
        {
            var idx = _status?.Phase switch
            {
                TrainingPhase.Preparing => 0,
                TrainingPhase.EnvironmentCheck => 1,
                TrainingPhase.Installing => 1,
                TrainingPhase.Training => 2,
                TrainingPhase.Validating => 3,
                TrainingPhase.Complete => 4,
                TrainingPhase.Failed => 2,
                TrainingPhase.Cancelled => 2,
                _ => -1,
            };
            if (idx < 0) { return Array.Empty<(string Key, string State)>(); }
            string[] keys = { "StatusPreparing", "StatusEnvCheck", "StatusTraining", "StatusValidating", "StatusComplete" };
            return keys.Select((k, i) => (Key: k, State: i < idx ? "done" : i == idx ? "active" : string.Empty)).ToArray();
        }
    }
    private string DeviceLabel() => _status?.Device switch { "0" => "GPU 0", "1" => "GPU 1", "cpu" => "CPU", "auto" => "auto", string s when !string.IsNullOrEmpty(s) => s, _ => "—" };
    private double GpuVramPercent => _res.Gpu is { VramTotalMb: > 0 } gpu ? Math.Clamp(gpu.VramUsedMb * 100d / gpu.VramTotalMb, 0d, 100d) : 0d;

    public async ValueTask DisposeAsync()
    {
        Language.LanguageChanged -= OnLangChanged;
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
            if (_pollTask is not null)
            {
                try { await _pollTask; }
                catch (OperationCanceledException) { }
            }
            _pollCts.Dispose();
        }
        if (_trainJs is not null)
        {
            try
            {
                await _trainJs.InvokeVoidAsync("unwatchTerminal", _termRef);
                await _trainJs.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }
}
