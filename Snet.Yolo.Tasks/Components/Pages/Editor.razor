@page "/labeling/{ProjectId}/{TaskIndex:int}"
@layout Layout.BlankLayout

<div class="ls-labeling">
    <header class="ls-topbar">
        <button type="button" class="ls-icon-btn" @onclick="GoBackAsync" title="@Language.Translate("BackToProjects")"><i class="bi bi-arrow-left"></i></button>
        <span class="ls-crumb text-truncate">
            <span class="ls-crumb-proj">@_project?.Name</span>
            <span class="ls-crumb-sep"></span>
            <span>@Language.Translate("TaskCount") · @(_currentIndex + 1) / @_project?.Tasks.Count</span>
        </span>
        <span class="ls-spacer"></span>
        <div class="d-flex gap-1 align-items-center">
            <button type="button" class="ls-icon-btn" disabled="@(Session?.CanUndo != true)" @onclick="UndoAsync" title="@Language.Translate("Undo")"><i class="bi bi-arrow-counterclockwise"></i></button>
            <button type="button" class="ls-icon-btn" disabled="@(Session?.CanRedo != true)" @onclick="RedoAsync" title="@Language.Translate("Redo")"><i class="bi bi-arrow-clockwise"></i></button>
            <span class="border-start mx-1" style="height: 1.25rem"></span>
            <button type="button" class="ls-icon-btn" @onclick="ZoomOutAsync" title="@Language.Translate("ZoomOut")"><i class="bi bi-zoom-out"></i></button>
            <button type="button" class="ls-icon-btn" @onclick="ZoomInAsync" title="@Language.Translate("ZoomIn")"><i class="bi bi-zoom-in"></i></button>
            <button type="button" class="ls-icon-btn" @onclick="ActualSizeAsync" title="@Language.Translate("ActualSize")"><i class="bi bi-1-circle"></i></button>
            <button type="button" class="ls-icon-btn" @onclick="FitAsync" title="@Language.Translate("FitToScreen")"><i class="bi bi-aspect-ratio"></i></button>
                        <AppHeaderControls />
        </div>
    </header>



    <div class="ls-labeling-main">
        <!-- 左栏：工具 + 标签 -->
        <aside class="ls-labeling-left @(_panelOpen == "left" ? "panel-open" : null)">
            <div class="ls-panel-title"><i class="bi bi-wrench"></i><LangText Key="Tools" /></div>
            <div class="ls-tool-list">
                <button type="button" class="ls-tool-btn @(ActiveTool == "select" ? "active border-primary" : null)" @onclick="SelectToolAsync" title="@Language.Translate("ToolSelection")"><i class="bi bi-cursor"></i></button>
                <button type="button" class="ls-tool-btn @(ActiveTool == "rect" ? "active border-primary" : null)" disabled="@(Session?.CanDraw(ControlTagKind.RectangleLabels) != true)" @onclick="RectToolAsync" title="@Language.Translate("ToolRectangle")"><i class="bi bi-bounding-box"></i></button>
                <button type="button" class="ls-tool-btn @(ActiveTool == "polygon" ? "active border-primary" : null)" disabled="@(Session?.CanDraw(ControlTagKind.PolygonLabels) != true)" @onclick="PolygonToolAsync" title="@Language.Translate("ToolPolygon")"><i class="bi bi-vector-pen"></i></button>
                <button type="button" class="ls-tool-btn @(ActiveTool == "keypoint" ? "active border-primary" : null)" disabled="@(Session?.CanDraw(ControlTagKind.KeyPointLabels) != true)" @onclick="KeyPointToolAsync" title="@Language.Translate("ToolKeyPoint")"><i class="bi bi-dot"></i></button>
                <button type="button" class="ls-tool-btn @(ActiveTool == "brush" ? "active border-primary" : null)" disabled="@(Session?.CanDraw(ControlTagKind.BrushLabels) != true)" @onclick="BrushToolAsync" title="@Language.Translate("ToolBrush")"><i class="bi bi-brush"></i></button>
                <button type="button" class="ls-tool-btn @(ActiveTool == "pan" ? "active border-primary" : null)" @onclick="PanToolAsync" title="@Language.Translate("ToolHand")"><i class="bi bi-hand-index"></i></button>
            </div>
            @if (ActiveLabels.Count > 0)
            {
                <div class="ls-panel-title"><i class="bi bi-tags"></i><LangText Key="Labels" /></div>
                <div class="flex-grow-1 overflow-auto">
                    @for (var index = 0; index < ActiveLabels.Count; index++)
                    {
                        var label = ActiveLabels[index];
                        var labelIndex = index;
                        var isActive = _classifyMode ? _classifyValue == label.Value : _activeLabelIndex == labelIndex;
                        <button type="button" class="ls-label-row @(isActive ? "selected" : null)" @onclick="() => _classifyMode ? AssignClassifyAsync(label.Value) : SetActiveLabelAsync(labelIndex)">
                            <span class="ls-color-dot" style="background: @(label.Background ?? "#40a0ff")"></span>
                            <span>@label.Value</span>
                            <span class="ls-hotkey-chip">@(index + 1)</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="ls-panel-title"><i class="bi bi-tags"></i><LangText Key="Labels" /></div>
                <div class="ls-hint"><LangText Key="AddLabelsFirst" /></div>
            }
        </aside>

        <!-- 中央画布 -->
        <main class="ls-labeling-stage">
            <button type="button" class="ls-icon-btn ls-mobile-panel-btn ls-mobile-panel-left" @onclick="ToggleLeft" title="@Language.Translate("Tools")"><i class="bi bi-wrench"></i></button>
            <button type="button" class="ls-icon-btn ls-mobile-panel-btn ls-mobile-panel-right" @onclick="ToggleRight" title="@Language.Translate("Panel")"><i class="bi bi-layout-sidebar"></i></button>
            @if (IsClassifyMode)
            {
                <div class="ls-classify-badge"><i class="bi bi-collection"></i> @ClassifyValue</div>
            }

            @if (!IsTextMode && !IsAudioMode)
            {
                <div class="ls-task-nav">
                <button type="button" class="ls-icon-btn" @onclick="() => NavigateTaskAsync(-1)" disabled="@(!CanPrev)" title="@Language.Translate("PrevTask")"><i class="bi bi-chevron-left"></i></button>
                <span class="ls-task-nav-label">@(_currentIndex + 1) / @_project?.Tasks.Count</span>
                <button type="button" class="ls-icon-btn" @onclick="() => NavigateTaskAsync(1)" disabled="@(!CanNext)" title="@Language.Translate("NextTask")"><i class="bi bi-chevron-right"></i></button>
            </div>
            <button type="button" class="ls-icon-btn ls-nav-btn ls-nav-prev" @onclick="() => NavigateTaskAsync(-1)" disabled="@(!CanPrev)" title="@Language.Translate("PrevTask")"><i class="bi bi-chevron-left"></i></button>
            }
            @if (IsAudioMode)
            {
                <div class="ls-audio-host">
                    <audio controls src="@AudioUrl" style="width:100%"></audio>
                    <canvas id="@WaveCanvasId" style="width:100%;height:110px;display:block"></canvas>
                    <div class="ls-hint"><LangText Key="AudioHint" /></div>
                    <div class="d-flex gap-2 align-items-center">
                        <label class="form-label small mb-0"><LangText Key="SegmentStart" /></label>
                        <input type="number" step="0.01" class="form-control form-control-sm" style="width:90px" @bind="_segmentStart" />
                        <label class="form-label small mb-0"><LangText Key="SegmentEnd" /></label>
                        <input type="number" step="0.01" class="form-control form-control-sm" style="width:90px" @bind="_segmentEnd" />
                        <button type="button" class="btn btn-sm btn-primary" @onclick="AddAudioSegment"><LangText Key="AddSegment" /></button>
                    </div>
                    <div class="d-flex gap-2 align-items-center mt-2">
                        <label class="form-label small mb-0"><LangText Key="Transcription" /></label>
                        <input type="text" class="form-control form-control-sm" value="@_audioTranscription" @onchange="OnTranscriptionChanged" />
                    </div>
                </div>
            }
            @if (IsTextMode)
            {
                <div class="ls-text-host">
                    <p class="ls-text-content">
                        @for (var index = 0; index < Tokens.Count; index++)
                        {
                            var token = Tokens[index];
                            var tokenIndex = index;
                            <button type="button" class="ls-token @(TokenHighlighted(tokenIndex) ? "hl" : null)" @onclick="e => OnTokenClick(tokenIndex, e)">@token.Text</button>
                        }
                    </p>
                    <div class="ls-hint"><LangText Key="StageEmptyHint" /></div>
                </div>
            }
            <div class="ls-canvas-host" style="@((IsTextMode || IsAudioMode) ? "display:none" : null)">
                <canvas id="@CanvasId"></canvas>
                @if (_loading)
                {
                    <div class="ls-loading"><span class="spinner-border spinner-border-sm me-2"></span><LangText Key="Loading" /></div>
                }
                @if (_errorText is not null)
                {
                    <div class="ls-canvas-overlay"><div class="ls-stage-hint">@_errorText</div></div>
                }
            </div>
            @if (!IsTextMode && !IsAudioMode)
            {
                <button type="button" class="ls-icon-btn ls-nav-btn ls-nav-next" @onclick="() => NavigateTaskAsync(1)" disabled="@(!CanNext)" title="@Language.Translate("NextTask")"><i class="bi bi-chevron-right"></i></button>
            }
        </main>

        @if (_panelOpen is not null) { <div class="ls-labeling-backdrop" @onclick="() => _panelOpen = null"></div> }

        <!-- 右栏：Regions / Details / Settings -->
        <aside class="ls-labeling-right @(_panelOpen == "right" ? "panel-open" : null)">
            <div class="ls-tabs" role="tablist">
                @for (var index = 0; index < TabKeys.Length; index++)
                {
                    var tabKey = TabKeys[index];
                    var tabIndex = index;
                    <button type="button" class="ls-tab @(RightTab == tabIndex ? "active" : null)" @onclick="() => RightTab = tabIndex">
                        <LangText Key="@tabKey" />
                    </button>
                }
            </div>
            <div class="ls-panel-body">
                @if (RightTab == 0)
                {
                    @if (IsAudioMode)
                    {
                        @foreach (var row in _audioRows)
                        {
                            var audioRowId = row.Id;
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="ls-editor-region-row" @onclick="() => SelectFromListAsync(audioRowId!)">
                                    <i class="bi @(row.Type == RegionType.TextArea ? "bi-input-cursor-text" : "bi-music-note")"></i>
                                    <span class="ls-color-dot" style="background: @AudioSegmentLabel(row)"></span>
                                    <span class="text-truncate">@(row.Type == RegionType.TextArea ? (row.Value?["text"]?.AsArray()?.FirstOrDefault()?.GetValue<string>() ?? "") : AudioSegmentLabel(row))</span>
                                </button>
                                <button type="button" class="ls-icon-btn flex-shrink-0" @onclick="() => DeleteAudioRow(audioRowId!)" title="@Language.Translate("Delete")"><i class="bi bi-trash"></i></button>
                            </div>
                        }
                    }
                    else if (IsTextMode)
                    {
                        @foreach (var row in _textRows)
                        {
                            var textRowId = row.Id;
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="ls-editor-region-row @(_selectedTextId == textRowId ? "selected" : null)" @onclick="() => SelectFromListAsync(textRowId!)">
                                    <i class="bi bi-font"></i>
                                    <span class="ls-color-dot" style="background: @TextSpanColor(row)"></span>
                                    <span class="text-truncate">@TextSpanLabel(row)</span>
                                </button>
                                <button type="button" class="ls-icon-btn flex-shrink-0" @onclick="() => DeleteTextSpan(textRowId!)" title="@Language.Translate("Delete")"><i class="bi bi-trash"></i></button>
                            </div>
                        }
                    }
                    else if (Session is null || !Session.GeometryRows.Any())
                    {
                        <div class="ls-empty"><i class="bi bi-bounding-box ls-empty-icon"></i><LangText Key="RegionsEmpty" /></div>
                    }
                    else
                    {
                        @foreach (var row in Session.GeometryRows)
                        {
                            var rowId = row.Id;
                            var color = RegionColor(row);
                            <div class="d-flex align-items-center gap-2 ls-region-item">
                                <button type="button" class="ls-editor-region-row @(Session.SelectedRegionId == rowId ? "selected" : null)" style="@(RowHasParent(row) ? "margin-left:1.5rem" : null)" @onclick="() => SelectFromListAsync(rowId!)">
                                    <i class="bi @TypeIcon(row)"></i>
                                    <span class="ls-color-dot" style="background: @color"></span>
                                    <span class="text-truncate">@(RowLabelsText(row) ?? "")</span>
                                </button>
                                <button type="button" class="ls-icon-btn flex-shrink-0" @onclick="() => DeleteRegionAsync(rowId!)" title="@Language.Translate("Delete")"><i class="bi bi-trash"></i></button>
                            </div>
                        }
                    }
                }
                else if (RightTab == 1)
                {
                    @if (IsTextMode)
                    {
                        <div class="p-2 d-grid gap-2">
                            @if (SelectedTextRow is null)
                            {
                                <div class="ls-empty"><LangText Key="SelectRegionHint" /></div>
                            }
                            else
                            {
                                <div class="small text-secondary">@Language.Translate("Labels")</div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var label in TextLabels)
                                    {
                                        var labelValue = label.Value;
                                        var isOn = TextSpanLabel(SelectedTextRow) == labelValue;
                                        <button type="button" class="btn btn-sm @(isOn ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ToggleTextLabel(SelectedTextRow.Id!, labelValue)">@labelValue</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (SelectedRow is null)
                    {
                        <div class="ls-empty">
                            <i class="bi bi-bounding-box ls-empty-icon"></i>
                            <div><LangText Key="DetailsEmpty" /></div>
                            <div class="ls-hint"><LangText Key="SelectRegionHint" /></div>
                        </div>
                    }
                    else if (SelectedRow.Type == RegionType.RectangleLabels)
                    {
                        <div>
                            <div class="ls-panel-title mb-2"><i class="bi bi-bounding-box"></i><LangText Key="Coordinate" /></div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="ls-field-label"><i class="bi bi-arrow-left-right"></i>X</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" value="@_detailX" @onchange="e => _detailX = ParseDouble(e)" />
                                </div>
                                <div class="col-6">
                                    <label class="ls-field-label"><i class="bi bi-arrow-up-down"></i>Y</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" value="@_detailY" @onchange="e => _detailY = ParseDouble(e)" />
                                </div>
                                <div class="col-6">
                                    <label class="ls-field-label"><i class="bi bi-arrows-angle-expand"></i>W</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" value="@_detailW" @onchange="e => _detailW = ParseDouble(e)" />
                                </div>
                                <div class="col-6">
                                    <label class="ls-field-label"><i class="bi bi-arrows-expand-vertical"></i>H</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" value="@_detailH" @onchange="e => _detailH = ParseDouble(e)" />
                                </div>
                                <div class="col-6">
                                    <label class="ls-field-label"><i class="bi bi-rotate"></i><LangText Key="Rotation" /></label>
                                    <input type="number" step="0.1" class="form-control form-control-sm" value="@_detailRotation" @onchange="e => _detailRotation = ParseDouble(e)" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm w-100 mt-3" @onclick="ApplyDetailGeometryAsync"><i class="bi bi-check-lg"></i> <LangText Key="Update" /></button>
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="ls-hint"><LangText Key="CoordHint" /></div>
                        </div>
                    }
                }
                else
                {
                    <div class="ls-panel-title"><i class="bi bi-gear"></i><LangText Key="Settings" /></div>
                    <div>
                        <div class="ls-hint mb-2"><LangText Key="SettingsExplained" /></div>
                        <label class="form-label small"><LangText Key="Labels" /> <span>@Math.Round(_overlayOpacity * 100)%</span></label>
                        <input id="overlay-opacity" type="range" min="5" max="100" value="@Math.Round(_overlayOpacity * 100)" class="form-range" @oninput="OnOverlayOpacityChange" @onchange="OnOverlayOpacityChanged" />
                    </div>
                }
            </div>
        </aside>
    </div>


</div>
