@page "/project/{ProjectId}"
@implements IAsyncDisposable
@using Snet.Yolo.Tasks.Services
@using Snet.Yolo.Tasks.Core.Models
@using Snet.Yolo.Tasks.Core.Serialization
@using Snet.Yolo.Tasks.Core.Serialization.Export
@using Snet.Yolo.Tasks.Core.Workspace
@inject WorkspaceService Workspaces
@inject NavigationManager Navigation
@inject LanguageManager Language
@inject ToastService Toast

<div class="ls-refined-page ls-project-detail-page">
<div class="ls-page-head">
  <div class="ls-page-lead">
    <button type="button" class="ls-icon-btn" @onclick="BackToProjects" title="@Language.Translate("BackToProjects")" aria-label="@Language.Translate("BackToProjects")"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
    <h1 class="ls-page-title"><i class="bi bi-folder2-open"></i>@_project?.Name<span class="ls-page-sub"> · @Language.Translate(TypeInfo.Key)</span></h1>
  </div>
  <div class="ls-page-actions">
  <select id="export-format" class="form-select form-select-sm" style="width:auto" @bind="_exportFormat">
    @foreach (var format in ExportFormats.All) { <option value="@format">@format</option> }
  </select>
  <button id="export-button" type="button" class="btn btn-primary btn-sm" @onclick="ExportAsync"><i class="bi bi-download"></i> <LangText Key="Export" /></button>
@if (!IsClassify)
  {
  <button id="edit-labels-button" type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleLabelsEditor"><i class="bi bi-tags"></i> <LangText Key="EditLabels" /></button>
  }
  @if (IsClassify)
  {
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenClassImport"><i class="bi bi-images"></i> <LangText Key="ImportImages" /></button>
  }
  else
  {
    <label class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-images"></i> <LangText Key="ImportImages" />
      <InputFile id="image-import-input" OnChange="ImportImagesAsync" accept="image/*" multiple hidden />
    </label>
  }
  </div>
</div>

@if (_labelsEditorOpen)
{
  <div class="modal fade show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-tags" aria-hidden="true"></i><LangText Key="EditLabels" /></h5><button type="button" class="btn-close" @onclick="ToggleLabelsEditor" aria-label="@Language.Translate("Close")"></button></div>
        <div class="modal-body">
          @foreach (var control in _labelEdits)
          {
            <div class="ls-label-ctl">
              <div class="ls-label-ctl-head">@ControlDisplayName(control.Kind) · @control.Name</div>
              @foreach (var labelItem in control.Labels)
              {
                <div class="ls-label-ctl-row">
                  <input type="text" class="form-control form-control-sm" value="@labelItem.Value" @onchange="e => OnLabelValueChange(labelItem, e)" />
                  <input type="color" class="ls-color-input" value="@labelItem.Color" @onchange="e => OnColorChange(labelItem, e)" />
                  <button type="button" class="btn btn-icon-sm btn-outline-danger" @onclick="() => RemoveLabel(control, labelItem)" title="@Language.Translate("Delete")" aria-label="@Language.Translate("Delete")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                </div>
              }
              <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AddLabel(control)"><i class="bi bi-plus"></i> @Language.Translate("AddLabel")</button>
            </div>
          }
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" @onclick="ToggleLabelsEditor"><i class="bi bi-x-lg"></i> @Language.Translate("Cancel")</button><button type="button" class="btn btn-primary" @onclick="SaveLabelEditsAsync"><i class="bi bi-check-lg"></i> @Language.Translate("Save")</button></div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}

@if (_loadFailed)
{
  <div class="alert alert-warning"><LangText Key="NoProjectsTitle" /></div>
}
else if (_project is null)
{
  <div class="spinner-border spinner-border-sm text-secondary"></div>
}
else
{
  <div class="ls-detail">
    <main class="ls-detail-main">

      @* 概览：标注/分类进度 *@
      <section class="ls-card ls-workspace-card">
        <div class="ls-card-head">
          <h3 class="ls-h3"><i class="bi @(IsClassify ? "bi-tags" : "bi-clipboard-data")"></i><LangText Key="@(IsClassify ? "ClassProgress" : "AnnoProgress")" /></h3>
          <span class="ls-percent">@(IsClassify ? ClassPercent : AnnoPercent)<em>%</em></span>
        </div>
        <div class="ls-workspace-card-body">
        @if (IsClassify)
        {
          <div class="ls-stats ls-stats-2">
            <div class="ls-stat"><span>@_classFolders.Count</span><small><LangText Key="ClassCount" /></small></div>
            <div class="ls-stat"><span>@_project.Tasks.Count</span><small><LangText Key="ImageCount" /></small></div>
          </div>
        }
        else
        {
          <div class="ls-stats">
            <div class="ls-stat"><span>@_project.Tasks.Count</span><small><LangText Key="TaskCount" /></small></div>
            <div class="ls-stat"><span>@LabeledCount</span><small><LangText Key="Labeled" /></small></div>
            <div class="ls-stat"><span>@(_project.Tasks.Count - LabeledCount)</span><small><LangText Key="Unlabeled" /></small></div>
            <div class="ls-stat"><span>@TotalRegions</span><small><LangText Key="Regions" /></small></div>
          </div>
        }
        <div class="progress ls-progress mt-3" role="progressbar" aria-valuenow="@(IsClassify ? ClassPercent : AnnoPercent)" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar" style="width:@(IsClassify ? ClassPercent : AnnoPercent)%"></div>
        </div>
        <div class="ls-progress-meta">
          <span>@(IsClassify ? ClassifiedCount : LabeledCount) / @_project.Tasks.Count</span>
          <span class="text-truncate">@((IsClassify ? ClassifiedCount : LabeledCount) == _project.Tasks.Count ? Language.Translate("StatusComplete") : (IsClassify ? String.Empty : Language.Translate("NoTasksHint")))</span>
        </div>
        </div>
      </section>

      @if (IsClassify)
      {
        <div class="ls-folder-grid">
          @if (_classFolders.Count == 0)
          {
            <div class="ls-card p-0">
              <EmptyState Icon="bi-folder2-open" Class="py-5">
                <Body><LangText Key="NoClasses" /></Body>
                <Actions><button class="btn btn-primary btn-sm" @onclick="OpenClassImport"><i class="bi bi-images"></i> <LangText Key="ImportImages" /></button></Actions>
              </EmptyState>
            </div>
          }
          @foreach (var f in _classFolders)
          {
            <div class="ls-folder-card" role="button" tabindex="0" @onclick="() => OpenClass(f.Name)" @onkeydown="e => OnFolderEnter(e, f.Name)">
              <div class="ls-folder-cover">
                @if (f.Thumbs.Count > 0)
                {
                  @foreach (var th in f.Thumbs.Take(3)) { <img src="@th" loading="lazy" alt="" /> }
                }
                else
                {
                  <i class="bi bi-folder2-fill ls-folder-ic"></i>
                }
                <div class="ls-folder-acts" @onclick:stopPropagation="true">
                  <button class="btn btn-icon-sm btn-outline-secondary" @onclick="() => OpenClassImportWith(f.Name)" title="@Language.Translate("AddImages")"><i class="bi bi-plus"></i></button>
                  <button class="btn btn-icon-sm btn-outline-danger" @onclick="() => DeleteFolderAsync(f.Name)" title="@Language.Translate("Delete")"><i class="bi bi-trash"></i></button>
                </div>
              </div>
              <div class="ls-folder-body">
                <div class="ls-folder-name">@ClassDisplayName(f.Name)</div>
                <div class="ls-folder-count">@f.Count <LangText Key="Images" /></div>
              </div>
            </div>
          }
        </div>
      }
      else if (_project.Tasks.Count == 0)
      {
        <div class="ls-card text-center py-5">
          <i class="bi bi-images fs-1 d-block mb-3" style="color:var(--ls-muted)"></i>
          <p class="ls-hint mx-auto" style="max-width:460px"><LangText Key="NoTasksHint" /></p>
          <label class="btn btn-primary btn-sm mt-3"><i class="bi bi-images"></i> <LangText Key="ImportImages" /><InputFile id="image-import-input-empty" OnChange="ImportImagesAsync" accept="image/*" multiple hidden /></label>
        </div>
      }
      else
      {
        <div class="table-responsive ls-card p-0">
          <div class="ls-toolbar">
            <span class="ls-toolbar-count">@FilteredCount / @_project.Tasks.Count</span>
            <div class="ls-search">
              <i class="bi bi-search"></i>
              <input class="form-control form-control-sm" placeholder="@Language.Translate("SearchTasks")" value="@_search" @oninput="e => { _search = e.Value?.ToString() ?? String.Empty; _page = 1; }" />
              @if (!string.IsNullOrWhiteSpace(_search)) { <button type="button" class="ls-search-clear" @onclick="() => { _search = String.Empty; _page = 1; }"><i class="bi bi-x-lg"></i></button> }
            </div>
          </div>
          <table class="table table-hover align-middle mb-0">
            <thead><tr>
              <th><span class="ls-th-label"><i class="bi bi-hash" aria-hidden="true"></i><span>#</span></span></th>
              <th><span class="ls-th-label"><i class="bi bi-card-image" aria-hidden="true"></i><LangText Key="Tasks" /></span></th>
              <th><span class="ls-th-label"><i class="bi bi-check2-circle" aria-hidden="true"></i><LangText Key="Status" /></span></th>
              <th><span class="ls-th-label"><i class="bi bi-bounding-box" aria-hidden="true"></i><LangText Key="Regions" /></span></th>
              <th class="text-end"><span class="ls-th-label justify-content-end"><i class="bi bi-sliders" aria-hidden="true"></i><LangText Key="Actions" /></span></th>
            </tr></thead>
            <tbody>
              @for (var vi = 0; vi < VisibleTasks.Count; vi++)
              {
                var task = VisibleTasks[vi];
                var taskIndex = _project.Tasks.IndexOf(task);
                var ok = RegionCount(task) > 0;
                <tr>
                  <td class="text-secondary num">@(taskIndex + 1)</td>
                  <td>
                    <div class="ls-task-cell">
                      <span class="ls-thumb">
                        @{ var img = TaskImage(task); }
                        @if (!string.IsNullOrEmpty(img)) { <img src="@img" loading="lazy" alt="" /> } else { <i class="bi bi-file-earmark-image"></i> }
                      </span>
                      <span class="ls-task-name">
                        <span class="d-block text-truncate">@TaskHeadline(task)</span>
                        <span class="ls-task-sub">#@task.Id</span>
                      </span>
                    </div>
                  </td>
                  <td>
                    <span class="ls-state @(ok ? "ls-state-ok" : "ls-state-todo")"><i class="bi @(ok ? "bi-check2" : "bi-dash")"></i>@(ok ? Language.Translate("Labeled") : Language.Translate("Unlabeled"))</span>
                  </td>
                  <td class="num">@RegionCount(task)</td>
                  <td class="text-end">
                    <div class="ls-btn-row justify-content-end">
                      <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenTaskAsync(taskIndex)"><i class="bi bi-pencil-square"></i> @Language.Translate("LabelNow")</button>
                      <button type="button" class="btn btn-icon-sm btn-outline-danger" title="@Language.Translate("DeleteTask")" @onclick="() => DeleteTaskAsync(taskIndex)"><i class="bi bi-trash"></i></button>
                    </div>
                  </td>
                </tr>
              }
            </tbody>
          </table>
          @if (FilteredCount > PageSize)
          {
            <div class="ls-pager">
              <span class="small text-secondary">@(((long)(_page - 1) * PageSize + 1).ToString())–@(Math.Min((long)_page * PageSize, FilteredCount)) / @FilteredCount</span>
              <div class="d-flex gap-1 align-items-center">
                <button type="button" class="btn btn-icon-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="() => _page--"><i class="bi bi-chevron-left"></i></button>
                <span class="small px-1">@_page / @TotalPages</span>
                <button type="button" class="btn btn-icon-sm btn-outline-secondary" disabled="@(_page >= TotalPages)" @onclick="() => _page++"><i class="bi bi-chevron-right"></i></button>
              </div>
            </div>
          }
        </div>
      }
    </main>

    <aside class="ls-detail-side">
      <section class="ls-info-card ls-workspace-card">
        <div class="ls-info-head"><i class="bi bi-info-circle"></i>@Language.Translate("ProjectInfo")</div>
        <div class="ls-workspace-card-body ls-info-card-body">
        <div class="ls-info-row"><span class="ls-info-k"><i class="bi @TypeInfo.Icon"></i>@Language.Translate("AnnoType")</span><span class="ls-info-v">@Language.Translate(TypeInfo.Key)</span></div>
        <div class="ls-info-row"><span class="ls-info-k"><i class="bi @(IsClassify ? "bi-folder2" : "bi-tags")"></i>@Language.Translate(IsClassify ? "ClassCount" : "Labels")</span><span class="ls-info-v">@(IsClassify ? _classFolders.Count : LabelOptions.Count)</span></div>
        <div class="ls-info-row"><span class="ls-info-k"><i class="bi bi-clock-history"></i>@Language.Translate("UpdatedAt")</span><span class="ls-info-v">@_project.UpdatedAt.ToLocalTime().ToString("g")</span></div>
        <div class="ls-info-row"><span class="ls-info-k"><i class="bi bi-download"></i>@Language.Translate("Export")</span><span class="ls-info-v">@_exportFormat</span></div>
        </div>
      </section>
      <section class="ls-info-card ls-workspace-card">
        <div class="ls-info-head"><i class="bi @(IsClassify ? "bi-folder2" : "bi-pie-chart")"></i>@Language.Translate(IsClassify ? "ClassCount" : "LabelStats")</div>
        <div class="ls-workspace-card-body ls-info-card-body ls-label-stats-body">
        @if (IsClassify)
        {
          @foreach (var f in _classFolders)
          {
            <div class="ls-label-stat"><i class="bi bi-folder2-fill ls-label-stat-ic"></i><span class="ls-label-stat-name">@ClassDisplayName(f.Name)</span><span class="ls-label-stat-count">@f.Count</span></div>
          }
          @if (_classFolders.Count == 0)
          {
            <div class="ls-hint" style="padding:.25rem 0"><LangText Key="NoClasses" /></div>
          }
        }
        else if (LabelStats.Count == 0)
        {
          <div class="ls-hint" style="padding:.25rem 0"><LangText Key="NoLabelStats" /></div>
        }
        else
        {
          @foreach (var s in LabelStats)
          {
            <div class="ls-label-stat"><span class="ls-color-dot" style="background:@s.Color"></span><span class="ls-label-stat-name">@s.Value</span><span class="ls-label-stat-count">@s.Count</span></div>
          }
        }
        </div>
      </section>
    </aside>
  </div>
}

@if (_openClass is not null)
{
  <div class="modal show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-folder2-open" aria-hidden="true"></i> @ClassDisplayName(_openClass.Name) · @_openClass.Count <LangText Key="Images" /></h5><div class="ms-auto d-flex align-items-center gap-2"><button class="btn ls-icon-btn" @onclick="AddToOpenClass" title="@Language.Translate("AddImages")" aria-label="@Language.Translate("AddImages")"><i class="bi bi-plus-lg" aria-hidden="true"></i></button><button class="btn-close" @onclick="() => _openClass = null" aria-label="@Language.Translate("Close")"></button></div></div>
        <div class="modal-body">
          <div class="ls-img-grid">
            @foreach (var it in _openClass.Items)
            {
              <div class="ls-img-cell-wrap"><button class="ls-img-cell" @onclick="() => _viewer = it"><img src="@it.DataUrl" /></button><button class="ls-img-del" @onclick="() => RemoveImageAsync(_openClass.Name, it)" title="@Language.Translate("Delete")" aria-label="@Language.Translate("Delete")"><i class="bi bi-trash" aria-hidden="true"></i></button></div>
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop show"></div>
}

@if (_viewer is not null)
{
  <div class="ls-viewer" @onclick="() => _viewer = null"><img src="@_viewer.DataUrl" /></div>
}

@if (_showClassImport)
{
  <div class="modal show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-upload"></i>@Language.Translate(_importIsNew ? "ImportImages" : "AddImages")@if (!_importIsNew) { <span class="ls-chip ms-1"><i class="bi bi-folder2-open"></i>@_newClass</span> }</h5>
          <button class="btn-close" @onclick="() => _showClassImport = false" aria-label="@Language.Translate("Close")"></button>
        </div>
        <div class="modal-body">
          @if (_importIsNew)
          {
            <div class="mb-3">
              <label class="ls-field-label"><LangText Key="ClassName" /></label>
              <input class="form-control" @bind="_newClass" placeholder="car" />
            </div>
          }
          <label class="ls-upload-zone @(_files.Count > 0 ? "has-files" : null)">
            <InputFile OnChange="OnFiles" accept="image/*" multiple hidden />
            <i class="bi bi-cloud-arrow-up ls-upload-icon"></i>
            <div class="ls-upload-main">@Language.Translate("ChooseImages")</div>
            <div class="ls-upload-sub">@Language.Translate("UploadHint")</div>
            @if (_files.Count > 0)
            {
              <div class="ls-upload-count">@_files.Count @Language.Translate("Images")</div>
            }
          </label>
          @if (_files.Count > 0)
          {
            <ul class="ls-upload-files">
              @foreach (var f in _files.Take(5))
              {
                <li><span>@f.Name</span><small>@((f.Size / 1024.0).ToString("0.#")) KB</small></li>
              }
              @if (_files.Count > 5) { <li class="ls-upload-more">…</li> }
            </ul>
          }
        </div>
        <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="() => _showClassImport = false"><i class="bi bi-x-lg"></i> @Language.Translate("Cancel")</button><button class="btn btn-primary" @onclick="ImportClassAsync" disabled="@(_files.Count == 0 || (_importIsNew && string.IsNullOrWhiteSpace(_newClass)))"><i class="bi @(_importIsNew ? "bi-check-lg" : "bi-plus-lg")"></i> @Language.Translate(_importIsNew ? "Create" : "Add")</button></div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop show"></div>
}

</div>

@code {
  [Inject] private IJSRuntime Js { get; set; } = default!;
  private Microsoft.JSInterop.IJSObjectReference? _shell;
  [Parameter] public string ProjectId { get; set; } = string.Empty;
  private WorkspaceProject? _project;
  private bool _loadFailed;
  private string _exportFormat = ExportFormats.Yolo;
  private bool _labelsEditorOpen;
  private List<LabelControlEdit> _labelEdits = new();
  private List<ClassFolder> _classFolders = new();
  private ClassFolder? _openClass;
  private ClassImage? _viewer;
  private bool _showClassImport;
  private bool _importIsNew = true;
  private string _newClass = "";
  private const long MaxImageSize = 40L * 1024 * 1024;
  private readonly List<IBrowserFile> _files = new();
  private readonly SemaphoreSlim _importLock = new(1, 1);

  protected override void OnInitialized() => Language.LanguageChanged += OnLanguageChanged;
  private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
  public async ValueTask DisposeAsync()
  {
    Language.LanguageChanged -= OnLanguageChanged;
    if (_shell is not null)
    {
      try { await _shell.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
  }

  protected override async Task OnParametersSetAsync()
  {
    _loadFailed = false;
    _project = await Workspaces.GetProjectAsync(ProjectId);
    if (_project is null) { _loadFailed = true; }
    await LoadFolders();
  }
  private bool IsClassify
  {
    get { try { var cfg = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(_project?.LabelConfigXml ?? ""); return cfg.Controls.Any(c => c.Kind == Snet.Yolo.Tasks.Core.Config.ControlTagKind.Choices); } catch { return false; } }
  }
  private void BackToProjects() => Navigation.NavigateTo("/projects");
  private void OpenTaskAsync(int taskIndex) => Navigation.NavigateTo($"/labeling/{ProjectId}/{taskIndex}");

  /* ── 工作台：概览 / 表格 / 检查器 ── */
  private string _search = String.Empty;

  private const int PageSize = 20;
  private int _page = 1;
  private int FilteredCount => _project is null ? 0 : _project.Tasks.Count(t => string.IsNullOrWhiteSpace(_search) || MatchSearch(t, _search));
  private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)PageSize));
  private List<AnnotationTask> VisibleTasks
  {
    get
    {
      if (_page > TotalPages) { _page = TotalPages; }
      var filtered = _project is null
          ? new List<AnnotationTask>()
          : _project.Tasks.Where(t => string.IsNullOrWhiteSpace(_search) || MatchSearch(t, _search)).ToList();
      return filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }
  }
  private bool MatchSearch(AnnotationTask t, string q)
    => (TaskHeadline(t) + " " + (TaskImage(t) ?? "")).Contains(q, StringComparison.OrdinalIgnoreCase);
  private int LabeledCount => _project?.Tasks.Count(t => RegionCount(t) > 0) ?? 0;
  private int TotalRegions => _project?.Tasks.Sum(t => RegionCount(t)) ?? 0;
  private int AnnoPercent => _project is null || _project.Tasks.Count == 0 ? 0 : (int)Math.Round(LabeledCount * 100.0 / _project.Tasks.Count);

  /* 分类项目：只上传不要标注，进度=已归入类别文件夹的图片占比 */
  private int UnclassifiedCount => _classFolders.Where(f => f.Name == "未分类").Sum(f => f.Count);
  private int ClassifiedCount => (_project?.Tasks.Count ?? 0) - UnclassifiedCount;
  private int ClassPercent => _project is null || _project.Tasks.Count == 0 ? 0 : (int)Math.Round(ClassifiedCount * 100.0 / _project.Tasks.Count);

  private static string? TaskImage(AnnotationTask task) => task.Data?["image"]?.ToString();
  private string TaskHeadline(AnnotationTask task)
  {
    var img = TaskImage(task);
    if (!string.IsNullOrEmpty(img) && !img.StartsWith("data:", StringComparison.Ordinal))
    {
      var name = img.Split('/').Last();
      if (name.Length > 0) { return name; }
    }
    var summary = TaskSummary(task);
    return summary.Length > 60 ? summary[..60] + "…" : summary;
  }

  private (string Icon, string Key) TypeInfo
  {
    get
    {
      var xml = _project?.LabelConfigXml ?? "";
      try
      {
        if (xml.Contains("KeyPointLabels", StringComparison.Ordinal)) { return ("bi-dot", "YoloPose"); }
        if (xml.Contains("EllipseLabels", StringComparison.Ordinal)) { return ("bi-record-circle", "YoloObb"); }
        if (xml.Contains("PolygonLabels", StringComparison.Ordinal)) { return ("bi-vector-pen", "YoloSegment"); }
        if (xml.Contains("Choices", StringComparison.Ordinal)) { return ("bi-tags", "YoloClassify"); }
        if (xml.Contains("RectangleLabels", StringComparison.Ordinal)) { return ("bi-bounding-box", "YoloDetect"); }
      }
      catch { }
      return ("bi-bounding-box", "YoloDetect");
    }
  }

  private List<(string Value, string? Background)> LabelOptions
  {
    get
    {
      var list = new List<(string Value, string? Background)>();
      if (_project is null) { return list; }
      try
      {
        var cfg = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(_project.LabelConfigXml);
        foreach (var c in cfg.Controls)
        {
          var opts = c.Choices.Count > 0
            ? c.Choices.Select(o => (o.Value, o.Background))
            : c.Labels.Select(o => (o.Value, o.Background));
          foreach (var o in opts)
          {
            if (list.All(x => x.Value != o.Value)) { list.Add((o.Value, o.Background)); }
          }
        }
      }
      catch { }
      return list;
    }
  }

  private List<(string Value, string Color, int Count)> LabelStats
  {
    get
    {
      var res = new List<(string Value, string Color, int Count)>();
      if (_project is null) { return res; }
      var counts = new Dictionary<string, int>(StringComparer.Ordinal);
      foreach (var task in _project.Tasks)
        foreach (var ann in task.Annotations.Where(a => a.WasCancelled != true))
          foreach (var row in ann.Result)
            foreach (var lbl in RowLabels(row))
            {
              counts[lbl] = counts.GetValueOrDefault(lbl) + 1;
            }
      if (counts.Count == 0) { return res; }
      var opts = LabelOptions;
      var byValue = new Dictionary<string, string>(StringComparer.Ordinal);
      foreach (var o in opts) { byValue[o.Value] = o.Background ?? "#40a0ff"; }
      foreach (var lbl in opts.Select(o => o.Value).Concat(counts.Keys.Where(k => !byValue.ContainsKey(k))).Distinct(StringComparer.Ordinal))
      {
        if (counts.TryGetValue(lbl, out var n)) { res.Add((lbl, byValue.TryGetValue(lbl, out var c) ? c : "#40a0ff", n)); }
      }
      return res.OrderByDescending(x => x.Count).ThenBy(x => x.Value, StringComparer.Ordinal).ToList();
    }
  }
  private static List<string> RowLabels(ResultRow row)
  {
    if (row.Value is null) { return new(); }
    var names = Snet.Yolo.Tasks.Core.Editing.ValueAccess.GetStringList(row.Value, "labels");
    if (names.Count == 0) { names = Snet.Yolo.Tasks.Core.Editing.ValueAccess.GetStringList(row.Value, "choices"); }
    return names;
  }

  private async Task DeleteTaskAsync(int taskIndex)
  {
    if (_project is null || taskIndex < 0 || taskIndex >= _project.Tasks.Count) { return; }
    var confirmed = await Js.InvokeAsync<bool>("confirm", Language.Translate("ConfirmDeleteTask"));
    if (!confirmed) { return; }
    _project.Tasks.RemoveAt(taskIndex);
    await Workspaces.SaveProjectAsync(_project);
    Toast.ShowSuccess(Language.Translate("DeleteTask"));
  }

  private async Task LoadFolders()
  {
    _classFolders = new();
    if (_project is null) { return; }
    foreach (var task in _project.Tasks)
    {
      var cls = task.Data?["class"]?.ToString() ?? "未分类";
      var img = task.Data?["image"]?.ToString() ?? "";
      var f = _classFolders.FirstOrDefault(x => x.Name == cls);
      if (f is null) { f = new ClassFolder { Name = cls }; _classFolders.Add(f); }
      f.Items.Add(new ClassImage { DataUrl = img });
      f.Count = f.Items.Count;
      f.Thumbs.Add(img);
    }
    _classFolders = _classFolders.OrderByDescending(f => f.Count).ToList();
  }
  private void OpenClass(string name) { _openClass = _classFolders.FirstOrDefault(f => f.Name == name); }
  private string ClassDisplayName(string name) => name == "未分类" ? Language.Translate("Unclassified") : name;
  private Task OnFolderEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, string name)
  {
    if (e.Key == "Enter" || e.Code == "Enter" || e.Key == "NumpadEnter") { OpenClass(name); }
    return Task.CompletedTask;
  }
  /* 新建分类（填名称 + 创建） */
  private void OpenClassImport() { _showClassImport = true; _importIsNew = true; _newClass = ""; _files.Clear(); }
  /* 添加图片到已有分类（不填名称 + 添加） */
  private void OpenClassImportWith(string name) { _showClassImport = true; _importIsNew = false; _newClass = name; _files.Clear(); }
  private void AddToOpenClass() { if (_openClass is not null) { var n = _openClass.Name; _openClass = null; OpenClassImportWith(n); } }
  private async Task DeleteFolderAsync(string name)
  {
    if (_project is null) { return; }
    _project.Tasks.RemoveAll(t => (t.Data?["class"]?.ToString() ?? "") == name);
    await Workspaces.SaveProjectAsync(_project);
    _openClass = null;
    await LoadFolders();
  }
  private async Task RemoveImageAsync(string folderName, ClassImage img)
  {
    if (_project is null) { return; }
    var task = _project.Tasks.FirstOrDefault(t => (t.Data?["class"]?.ToString() ?? "") == folderName && (t.Data?["image"]?.ToString() ?? "") == img.DataUrl);
    if (task is not null) { _project.Tasks.Remove(task); await Workspaces.SaveProjectAsync(_project); await LoadFolders(); }
    if (_openClass is not null) { _openClass = _classFolders.FirstOrDefault(f => f.Name == folderName); }
  }
  private void OnFiles(InputFileChangeEventArgs e)
  {
    try
    {
      _files.Clear();
      _files.AddRange(e.GetMultipleFiles(50).Where(file => file.Size is > 0 and <= MaxImageSize));
    }
    catch (Exception ex) { Toast.ShowError(ex.Message); }
  }
  private async Task ImportClassAsync()
  {
    if (_project is null || _files.Count == 0) { return; }
    if (!await _importLock.WaitAsync(0)) { return; }
    try
    {
    var existed = _classFolders.Any(f => f.Name == _newClass);
    var root = System.IO.Path.Combine(AppContext.BaseDirectory,"wwwroot", "data", "uploads", _project.Id);
    System.IO.Directory.CreateDirectory(root);
    var nextId = _project.Tasks.Count == 0 ? 1L : _project.Tasks.Max(t => t.Id ?? 0L) + 1;
    foreach (var file in _files)
    {
      var stored = Guid.NewGuid().ToString("N")[..8] + "_" + System.IO.Path.GetFileName(file.Name);
      await using var source = file.OpenReadStream(MaxImageSize);
      await using var destination = new FileStream(System.IO.Path.Combine(root, stored), FileMode.CreateNew, FileAccess.Write, FileShare.None, 128 * 1024, FileOptions.Asynchronous | FileOptions.SequentialScan);
      await source.CopyToAsync(destination);
      _project.Tasks.Add(new AnnotationTask { Id = nextId++, Data = new System.Text.Json.Nodes.JsonObject { ["image"] = "/uploads/" + _project.Id + "/" + stored, ["class"] = _newClass } });
    }
    await Workspaces.SaveProjectAsync(_project);
    _showClassImport = false;
    if (existed) { Toast.ShowError(Language.Translate("ClassExistsMerged") + "：" + _newClass); }
    else { Toast.ShowSuccess(Language.Translate("ImportDone") + ("（" + _newClass + "）")); }
    var openName = _openClass?.Name;
    await LoadFolders();
    if (openName is not null) { _openClass = _classFolders.FirstOrDefault(f => f.Name == openName); }
    }
    finally { _importLock.Release(); }
  }

  private async Task ImportImagesAsync(InputFileChangeEventArgs args)
  {
    if (_project is null) { return; }
    if (!await _importLock.WaitAsync(0)) { return; }
    try
    {
    var uploadsRoot = System.IO.Path.Combine(AppContext.BaseDirectory,"wwwroot", "data", "uploads", _project.Id);
    System.IO.Directory.CreateDirectory(uploadsRoot);
    var nextId = _project.Tasks.Count == 0 ? 1L : _project.Tasks.Max(task => task.Id ?? 0L) + 1;
    var imported = 0;
    foreach (var file in args.GetMultipleFiles(20))
    {
      await using var stream = file.OpenReadStream(MaxImageSize);
      var safeName = System.IO.Path.GetFileName(file.Name);
      var storedName = Guid.NewGuid().ToString("N")[..8] + "_" + safeName;
      await using var output = new FileStream(System.IO.Path.Combine(uploadsRoot, storedName), FileMode.CreateNew, FileAccess.Write, FileShare.None, 128 * 1024, FileOptions.Asynchronous | FileOptions.SequentialScan);
      await stream.CopyToAsync(output);
      _project.Tasks.Add(new AnnotationTask { Id = nextId++, Data = new System.Text.Json.Nodes.JsonObject { ["image"] = "/uploads/" + _project.Id + "/" + storedName } });
      imported++;
    }
    if (imported > 0) { await Workspaces.SaveProjectAsync(_project); Toast.ShowSuccess(Language.Translate("ImportDone") + " (" + imported + ")"); }
    }
    finally { _importLock.Release(); }
  }

  private string TaskSummary(AnnotationTask task)
  {
    if (task.Data is null) { return Language.Translate("NoData"); }
    var first = task.Data.FirstOrDefault(pair => pair.Value is not null);
    var value = first.Value?.ToString() ?? string.Empty;
    return value.Length > 80 ? value[..80] + "..." : value;
  }
  private static int RegionCount(AnnotationTask task)
  {
    var annotation = task.Annotations.FirstOrDefault(annotation => annotation.WasCancelled != true);
    return annotation?.Result.Count ?? 0;
  }

  private async Task ExportAsync()
  {
    if (_project is null) { return; }
    try
    {
      _shell ??= await Js.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./js/app-shell.js");
      var config = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(_project.LabelConfigXml);
      var export = ExportFor(_exportFormat, _project.Tasks, config);
      if (export.IsZip)
      {
        var bytes = Snet.Yolo.Tasks.Core.Serialization.Export.ZipHelper.Pack(export.Files);
        await _shell.InvokeVoidAsync("downloadBinary", export.FileName, Convert.ToBase64String(bytes));
      }
      else
      {
        var single = export.Files.FirstOrDefault();
        if (single is not null)
        {
          var text = System.Text.Encoding.UTF8.GetString(single.Content);
          await _shell.InvokeVoidAsync("downloadText", single.Path, text);
        }
      }
    }
    catch { Toast.ShowError(Language.Translate("ExportFailed")); }
  }
  private Snet.Yolo.Tasks.Core.Serialization.Export.ExportResult ExportFor(string format, List<AnnotationTask> tasks, Snet.Yolo.Tasks.Core.Config.LabelingConfigModel config)
    => format switch
    {
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.Json => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.Json(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.JsonMin => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.JsonMin(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.Csv => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.Csv(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.Tsv => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.Tsv(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.Coco => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.Coco(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.Voc => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.Voc(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.Yolo => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.Yolo(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.YoloWithImages => ExportYoloWithImages(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.Conll => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.Conll(tasks, config),
      Snet.Yolo.Tasks.Core.Serialization.Export.ExportFormats.BrushPng => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.BrushPng(tasks, config),
      _ => Snet.Yolo.Tasks.Core.Serialization.Export.ExportService.AsrManifest(tasks, config),
    };
  private Snet.Yolo.Tasks.Core.Serialization.Export.ExportResult ExportYoloWithImages(List<AnnotationTask> tasks, Snet.Yolo.Tasks.Core.Config.LabelingConfigModel config) => new();

  private void ToggleLabelsEditor() { _labelsEditorOpen = !_labelsEditorOpen; if (_labelsEditorOpen) { LoadLabelEdits(); } }
  private void LoadLabelEdits()
  {
    _labelEdits.Clear();
    if (_project is null) { return; }
    var config = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(_project.LabelConfigXml);
    foreach (var control in config.Controls.Where(c => c.Kind is Snet.Yolo.Tasks.Core.Config.ControlTagKind.RectangleLabels or Snet.Yolo.Tasks.Core.Config.ControlTagKind.PolygonLabels or Snet.Yolo.Tasks.Core.Config.ControlTagKind.KeyPointLabels or Snet.Yolo.Tasks.Core.Config.ControlTagKind.EllipseLabels or Snet.Yolo.Tasks.Core.Config.ControlTagKind.BrushLabels or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Choices or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Labels or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Taxonomy or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Rating or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Relation))
    {
      _labelEdits.Add(new LabelControlEdit
      {
        ControlName = control.TagName + " (" + control.Name + ")",
        Name = control.Name,
        ToName = control.ToName,
        Kind = control.Kind,
        Labels = (control.Choices.Count > 0 ? control.Choices.Select(c => new LabelEdit { Value = c.Value, Color = ResolveHex(c.Background) }) : control.Labels.Select(l => new LabelEdit { Value = l.Value, Color = ResolveHex(l.Background) })).ToList(),
      });
    }
  }
  private void AddLabel(LabelControlEdit control) => control.Labels.Add(new LabelEdit { Value = NextLabelValue(control), Color = "#40a0ff" });
  private static string NextLabelValue(LabelControlEdit control)
  {
    var used = control.Labels.Select(l => l.Value.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
    if (!used.Contains("new")) { return "new"; }
    for (var i = 2; ; i++) { var v = "new" + i; if (!used.Contains(v)) { return v; } }
  }
  private void RemoveLabel(LabelControlEdit control, LabelEdit label) => control.Labels.Remove(label);
  private void OnLabelValueChange(LabelEdit label, Microsoft.AspNetCore.Components.ChangeEventArgs args)
  {
    var control = _labelEdits.FirstOrDefault(c => c.Labels.Contains(label));
    if (control is null) { return; }
    var newValue = args.Value?.ToString() ?? string.Empty;
    var isDup = !string.IsNullOrWhiteSpace(newValue) && control.Labels.Any(l => l != label && string.Equals(l.Value.Trim(), newValue.Trim(), StringComparison.OrdinalIgnoreCase));
    if (isDup) { Toast.ShowWarning(Language.Translate("LabelNameDuplicate")); return; }
    label.Value = newValue;
  }
  private void OnColorChange(LabelEdit label, Microsoft.AspNetCore.Components.ChangeEventArgs args) => label.Color = args.Value?.ToString() ?? "#40a0ff";

  private async Task SaveLabelEditsAsync()
  {
    if (_project is null) { return; }
    foreach (var edit in _labelEdits)
    {
      var dup = edit.Labels.Where(l => !string.IsNullOrWhiteSpace(l.Value)).GroupBy(l => l.Value.Trim(), StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1);
      if (dup) { Toast.ShowError(Language.Translate("LabelNameDuplicate")); return; }
    }
    var config = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(_project.LabelConfigXml);
    var imageObject = config.Objects.FirstOrDefault(obj => obj.Kind == Snet.Yolo.Tasks.Core.Config.ObjectTagKind.Image);
    var builder = new System.Text.StringBuilder();
    builder.AppendLine("<View>");
builder.AppendLine("  <Image name=\"" + (imageObject?.Name ?? "image") + "\" value=\"" + (imageObject?.ValueField ?? "$image") + "\"/>");
    foreach (var edit in _labelEdits)
    {
      var tag = TagNameFor(edit.Kind);
builder.AppendLine("  <" + tag + " name=\"" + edit.Name + "\" toName=\"" + (edit.ToName ?? "image") + "\">");
      foreach (var label in edit.Labels.Where(l => !string.IsNullOrWhiteSpace(l.Value)))
      {
        var optTag = edit.Kind is Snet.Yolo.Tasks.Core.Config.ControlTagKind.Choices or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Taxonomy or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Rating or Snet.Yolo.Tasks.Core.Config.ControlTagKind.Relation ? "Choice" : "Label";
builder.AppendLine("    <" + optTag + " value=\"" + label.Value + "\" background=\"" + label.Color + "\"/>");
      }
      builder.AppendLine("  </" + tag + ">");
    }
    builder.AppendLine("</View>");
    var xml = builder.ToString();
    var parsed = Snet.Yolo.Tasks.Core.Config.LabelingConfigParser.Parse(xml);
    var validation = Snet.Yolo.Tasks.Core.Config.ConfigValidator.Validate(parsed);
    if (!validation.IsValid) { Toast.ShowError(Language.Translate("ConfigErrors")); return; }
    _project.LabelConfigXml = xml;
    await Workspaces.SaveProjectAsync(_project);
    _labelsEditorOpen = false;
    Toast.ShowSuccess(Language.Translate("ImportDone"));
  }

  private string ControlDisplayName(Snet.Yolo.Tasks.Core.Config.ControlTagKind kind) => Language.Translate(kind switch
  {
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.RectangleLabels => "ToolRectangle",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.PolygonLabels => "ToolPolygon",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.KeyPointLabels => "ToolKeyPoint",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.EllipseLabels => "ToolEllipse",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.BrushLabels => "ToolBrush",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Choices => "ToolRectangle",
    _ => "Labels",
  });
  private static string TagNameFor(Snet.Yolo.Tasks.Core.Config.ControlTagKind kind) => kind switch
  {
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.RectangleLabels => "RectangleLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.PolygonLabels => "PolygonLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.KeyPointLabels => "KeyPointLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.EllipseLabels => "EllipseLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.BrushLabels => "BrushLabels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Choices => "Choices",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Labels => "Labels",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Taxonomy => "Taxonomy",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Rating => "Rating",
    Snet.Yolo.Tasks.Core.Config.ControlTagKind.Relation => "Relation",
    _ => "RectangleLabels",
  };
  private static string ResolveHex(string? color)
  {
    if (string.IsNullOrWhiteSpace(color)) { return "#40a0ff"; }
    if (color.StartsWith("#", StringComparison.Ordinal)) { return color; }
    return "#40a0ff";
  }

