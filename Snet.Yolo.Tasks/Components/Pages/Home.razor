@page "/projects"
@using Snet.Yolo.Tasks.Services
@using Snet.Yolo.Tasks.Core.Config.Templates
@using Snet.Yolo.Tasks.Core.Models
@using Snet.Yolo.Tasks.Core.Training
@using Snet.Yolo.Tasks.Core.Workspace
@inject WorkspaceService Workspaces
@inject TrainingService Training
@inject NavigationManager Navigation
@inject LanguageManager Language
@inject IJSRuntime Js

<div class="ls-page-head">
    <h3 class="ls-page-title"><i class="bi bi-collection"></i><LangText Key="Projects" /></h3>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg"></i> <LangText Key="NewImageProject" />
        </button>
    </div>
</div>

@if (_showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><LangText Key="CreateProjectTitle" /></h5><button type="button" class="btn-close" @onclick="CloseCreateModal"></button></div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="ls-field-label"><LangText Key="AnnoType" /></label>
                        <select class="form-select" value="@_newProjectType" @onchange="OnTypeChange">
                            <option value="detect">@Language.Translate("YoloDetect")</option>
                            <option value="segment">@Language.Translate("YoloSegment")</option>
                            <option value="classify">@Language.Translate("YoloClassify")</option>
                            <option value="pose">@Language.Translate("YoloPose")</option>
                            <option value="obb">@Language.Translate("YoloObb")</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="ls-field-label"><LangText Key="ProjectName" /></label>
                        <input class="form-control" value="@_newProjectName" @oninput="e => _newProjectName = e.Value?.ToString() ?? String.Empty" />
                    </div>
                    @if (!string.IsNullOrEmpty(_createError))
                    {
                        <div class="text-danger small mt-1">@_createError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateModal"><i class="bi bi-x-lg"></i> <LangText Key="Cancel" /></button>
                    <button type="button" class="btn btn-primary" @onclick="CreateImageProjectAsync"><i class="bi bi-check-lg"></i> <LangText Key="Create" /></button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_busy)
{
    <div class="spinner-border spinner-border-sm text-secondary"></div>
}
else if (_projects.Count == 0)
{
    <div class="ls-card text-center py-5">
        <i class="bi bi-archive fs-1 d-block mb-3" style="color: var(--ls-muted)"></i>
        <h2 class="h5"><LangText Key="NoProjectsTitle" /></h2>
        <p class="ls-hint mx-auto" style="max-width: 460px"><LangText Key="NoProjectsHint" /></p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var project in _projects)
        {
            <div class="col-md-6">
                <div class="ls-card">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-folder2-open fs-4" style="color: var(--ls-accent)"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@project.Name</div>
                            <div class="small text-secondary">@project.Tasks.Count <LangText Key="TaskCount" /> · @project.UpdatedAt.ToLocalTime().ToString("g")</div>
                        </div>
                        <div class="d-flex gap-2 flex-nowrap">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenProjectAsync(project.Id)"><i class="bi bi-folder2-open"></i> <LangText Key="OpenProject" /></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenTrainAsync(project.Id)"><i class="bi bi-cpu"></i> <LangText Key="TrainProject" /></button>
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => DeleteProjectAsync(project.Id)"><i class="bi bi-trash"></i> <LangText Key="Delete" /></button>
                        </div>
                    </div>
                    @if (IsTraining(project.Id, out var st))
                    {
                        <div class="ls-card-train">
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span><i class="bi bi-cpu"></i> <LangText Key="Training" /></span><span>@st!.Percent%</span>
                            </div>
                            <div class="progress ls-progress ls-progress-sm"><div class="progress-bar" style="width:@st.Percent%"></div></div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private readonly List<WorkspaceProject> _projects = new();
    private bool _busy = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private void OpenProjectAsync(string projectId) => Navigation.NavigateTo($"/project/{projectId}");
    private void OpenTrainAsync(string projectId) => Navigation.NavigateTo($"/train/{projectId}");
    private bool IsTraining(string id, out TrainingStatus? st) { st = Training.GetStatus(id); return st is { IsActive: true }; }

    private async Task RefreshAsync()
    {
        _projects.Clear();
        _projects.AddRange(await Workspaces.ListProjectsAsync());
        _busy = false;
    }

    private bool _showCreateModal;
    private string _newProjectName = string.Empty;
    private string _newProjectType = "detect";
    private string _createError = string.Empty;

    private void OnTypeChange(Microsoft.AspNetCore.Components.ChangeEventArgs e)
        => _newProjectType = e.Value?.ToString() ?? "detect";

    private void OpenCreateModal()
    {
        _newProjectName = "Image";
        _createError = string.Empty;
        _showCreateModal = true;
    }

    private void CloseCreateModal() => _showCreateModal = false;

    private static string ConfigFor(string type)
        => YoloTaskRegistry.ConfigFor(type switch
        {
            "segment" => YoloTaskType.Segment,
            "classify" => YoloTaskType.Classify,
            "pose" => YoloTaskType.Pose,
            "obb" => YoloTaskType.Obb,
            _ => YoloTaskType.Detect,
        });

    private const string EmptyLabelsConfig = "<View>\n  <Image name=\"image\" value=\"$image\" zoom=\"true\"/>\n  <RectangleLabels name=\"rect\" toName=\"image\"></RectangleLabels>\n  <PolygonLabels name=\"poly\" toName=\"image\"></PolygonLabels>\n  <KeyPointLabels name=\"kp\" toName=\"image\"></KeyPointLabels>\n  <EllipseLabels name=\"ell\" toName=\"image\"></EllipseLabels>\n  <BrushLabels name=\"brush\" toName=\"image\"></BrushLabels>\n</View>\n";

    private async Task CreateImageProjectAsync()
    {
        var name = _newProjectName.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _createError = Language.Translate("NameRequired");
            return;
        }
        var existing = await Workspaces.ListProjectsAsync();
        if (existing.Any(p => string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _createError = Language.Translate("NameDuplicate");
            return;
        }

        _busy = true;
        var project = new WorkspaceProject
        {
            Name = name,
            LabelConfigXml = ConfigFor(_newProjectType),
        };
        await Workspaces.SaveProjectAsync(project);
        await RefreshAsync();
        _showCreateModal = false;
        Navigation.NavigateTo($"/project/{project.Id}");
    }
    private async Task DeleteProjectAsync(string projectId)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", "Delete this project? / 确定删除该工程？");
        if (confirmed)
        {
            await Workspaces.DeleteProjectAsync(projectId);
            await RefreshAsync();
        }
    }
}
