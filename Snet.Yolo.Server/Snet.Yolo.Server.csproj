<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Shun</Authors>
    <Product>Yolo</Product>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Description>识别组件：Server（Yolo多模型管理与智能识别服务，检测、定向检测、分类、分割、姿态、用户管理、任务管理、项目管理）</Description>
    <PackageProjectUrl>https://snet.cn</PackageProjectUrl>
    <AuthorsName>Shun</AuthorsName>
    <CompanyName>Snet</CompanyName>
    <PackageIcon>icon.png</PackageIcon>
    <AccelerateBuildsInVisualStudio>True</AccelerateBuildsInVisualStudio>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
    <PackageReference Include="Snet.DB" Version="26.256.1" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YoloDotNet\YoloDotNet.csproj" />
  </ItemGroup>
</Project>