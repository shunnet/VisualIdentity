<snet:WindowBase
    x:Class="Snet.Yolo.Tool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Snet.Yolo.Tool"
    xmlns:hardware="clr-namespace:Snet.Yolo.Server.inference;assembly=Snet.Yolo.Server"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:view="clr-namespace:Snet.Yolo.Tool.View"
    Title="{snet:Loc SystemTitle}"
    Width="1400"
    Height="1000"
    snet:ResxLocalizationProvider.DefaultAssembly="Snet.Yolo.Tool"
    snet:ResxLocalizationProvider.DefaultDictionary="Language"
    Icon="/Icon.ico"
    LoadAnimationEnabled="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            Margin="5,5,5,0"
            Padding="0"
            ui:ElevationAssist.Elevation="Dp1"
            ui:GroupBoxAssist.HeaderPadding="7"
            Header="{Binding}"
            Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ui:PackIcon Grid.Column="0" Kind="Memory" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{snet:Loc HardwareTitle}"
                            TextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <Grid Margin="12,4,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <snet:ComboBoxControl
                        Width="180"
                        Height="32"
                        Margin="0,0,12,6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{snet:Loc HardwareTitle}"
                        DisplayMemberPath="Key"
                        Hint="{snet:Loc HardwareTitle}"
                        Icon="{DynamicResource 硬件}"
                        IsEnabled="{Binding CanEditHardware}"
                        ItemsSource="{Binding HardwareOptions}"
                        SelectedItem="{Binding SelectedHardware}" />
                    <StackPanel
                        Margin="0,0,12,6"
                        IsEnabled="{Binding GpuControlsEnabled}"
                        Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedHardware.Value}" Value="{x:Static hardware:OnnxRuntimeHardware.Cuda}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{snet:Loc HardwareGpuId}" />
                        <snet:TextBoxControl
                            Width="115"
                            Height="32"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{snet:Loc HardwareGpuId}"
                            Hint="{snet:Loc HardwareGpuId}"
                            Icon="{DynamicResource Value}"
                            Text="{Binding GpuId, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{snet:Loc HardwareGpuHint}" />
                    </StackPanel>
                    <snet:ButtonControl
                        Height="32"
                        Margin="0,0,12,6"
                        AutomationProperties.Name="{snet:Loc HardwareApply}"
                        Command="{Binding ApplyHardware}"
                        Content="{snet:Loc HardwareApply}"
                        Icon="{DynamicResource Confirm}"
                        IsEnabled="{Binding CanEditHardware}" />
                    <TextBlock
                        Margin="0,0,0,6"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding CurrentHardware}" />
                </WrapPanel>
                <ScrollViewer
                    Grid.Row="1"
                    MaxHeight="80"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        FontSize="12"
                        Opacity="0.75"
                        Text="{Binding HardwareMessage}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </GroupBox>
        <TabControl
            Grid.Row="1"
            HorizontalContentAlignment="Center"
            ui:NavigationRailAssist.SelectionCornerRadius="{DynamicResource WindowCornerRadius}"
            ui:NavigationRailAssist.ShowSelectionBackground="True"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            SnapsToDevicePixels="True"
            Style="{StaticResource MaterialDesignNavigationRailTabControl}"
            TabStripPlacement="Top">
            <TabItem Width="120" Margin="0,5,5,5">
                <TabItem.Header>
                    <StackPanel>
                        <ui:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Kind="ConsoleNetworkOutline" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Text="{snet:Loc YoloDetect}"
                            TextOptions.TextFormattingMode="Display" />
                    </StackPanel>
                </TabItem.Header>
                <view:YoloDetectView />
            </TabItem>

            <TabItem Width="120" Margin="0,5,5,5">
                <TabItem.Header>
                    <StackPanel>
                        <ui:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Kind="ConsoleNetworkOutline" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Text="{snet:Loc YoloPose}"
                            TextOptions.TextFormattingMode="Display" />
                    </StackPanel>
                </TabItem.Header>
                <view:YoloPoseView />
            </TabItem>
            <TabItem Width="120" Margin="0,5,5,5">
                <TabItem.Header>
                    <StackPanel>
                        <ui:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Kind="ConsoleNetworkOutline" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Text="{snet:Loc YoloSegment}"
                            TextOptions.TextFormattingMode="Display" />
                    </StackPanel>
                </TabItem.Header>
                <view:YoloSegmentView />
            </TabItem>
            <TabItem Width="120" Margin="0,5,5,5">
                <TabItem.Header>
                    <StackPanel>
                        <ui:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Kind="ConsoleNetworkOutline" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Text="{snet:Loc YoloOBB}"
                            TextOptions.TextFormattingMode="Display" />
                    </StackPanel>
                </TabItem.Header>
                <view:YoloOBBView />
            </TabItem>
            <TabItem Width="120" Margin="0,5,5,5">
                <TabItem.Header>
                    <StackPanel>
                        <ui:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Kind="ConsoleNetworkOutline" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Text="{snet:Loc YoloClassify}"
                            TextOptions.TextFormattingMode="Display" />
                    </StackPanel>
                </TabItem.Header>
                <view:YoloClassifyView />
            </TabItem>

            <TabItem
                Width="150"
                Margin="0,5,5,5"
                ToolTip="{snet:Loc 针对于缺陷识别的数据统一，把多个单项单标签的标注数据统一到一起，自动批量修改标签中的下标数据}">
                <TabItem.Header>
                    <StackPanel>
                        <ui:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Kind="ConsoleNetworkOutline" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Text="{snet:Loc YoloDataUnification}"
                            TextOptions.TextFormattingMode="Display" />
                    </StackPanel>
                </TabItem.Header>
                <view:YoloDataUnificationView />
            </TabItem>
        </TabControl>
    </Grid>
</snet:WindowBase>
